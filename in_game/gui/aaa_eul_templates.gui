template eul_vis_loc_noisset_mining_town_prov_capital { visible = "[And3(EqualTo_float(FixedPointToFloat(Location.MakeScope.GetVariable('specialization_designation').GetValue), '(float)1.0'), Location.IsProvinceCapital, Not(Location.IsCapital))]" }
