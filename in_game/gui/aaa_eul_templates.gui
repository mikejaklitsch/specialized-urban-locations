# =====================================================
# MODIFIER HIDING TEMPLATE
# =====================================================
# Template to hide specialization modifiers from timed modifier lists
template eul_hide_if_specialization_modifier {
	visible = "[Not(Or3(
		Or5(
			EqualTo_string(TimedModifier.GetModifier.GetName, Localize('STATIC_MODIFIER_NAME_mining_town_specialization')),
			EqualTo_string(TimedModifier.GetModifier.GetName, Localize('STATIC_MODIFIER_NAME_farming_town_specialization')),
			EqualTo_string(TimedModifier.GetModifier.GetName, Localize('STATIC_MODIFIER_NAME_gathering_town_specialization')),
			EqualTo_string(TimedModifier.GetModifier.GetName, Localize('STATIC_MODIFIER_NAME_woodland_town_specialization')),
			EqualTo_string(TimedModifier.GetModifier.GetName, Localize('STATIC_MODIFIER_NAME_commercial_town_specialization'))
		),
		Or5(
			EqualTo_string(TimedModifier.GetModifier.GetName, Localize('STATIC_MODIFIER_NAME_mining_city_specialization')),
			EqualTo_string(TimedModifier.GetModifier.GetName, Localize('STATIC_MODIFIER_NAME_farming_city_specialization')),
			EqualTo_string(TimedModifier.GetModifier.GetName, Localize('STATIC_MODIFIER_NAME_gathering_city_specialization')),
			EqualTo_string(TimedModifier.GetModifier.GetName, Localize('STATIC_MODIFIER_NAME_woodland_city_specialization')),
			EqualTo_string(TimedModifier.GetModifier.GetName, Localize('STATIC_MODIFIER_NAME_commercial_city_specialization'))
		),
		Or5(
			EqualTo_string(TimedModifier.GetModifier.GetName, Localize('STATIC_MODIFIER_NAME_mining_rural_specialization')),
			EqualTo_string(TimedModifier.GetModifier.GetName, Localize('STATIC_MODIFIER_NAME_farming_rural_specialization')),
			EqualTo_string(TimedModifier.GetModifier.GetName, Localize('STATIC_MODIFIER_NAME_gathering_rural_specialization')),
			EqualTo_string(TimedModifier.GetModifier.GetName, Localize('STATIC_MODIFIER_NAME_woodland_rural_specialization')),
			EqualTo_string(TimedModifier.GetModifier.GetName, Localize('STATIC_MODIFIER_NAME_commercial_rural_specialization'))
		)
	))]"
}
