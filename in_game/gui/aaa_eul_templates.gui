# Expanded Urban Locations - Shared Templates
# This file loads first (alphabetically) to ensure templates are available to all GUI files
#
# Specialization designation values:
#   Towns:  mining=1,  farming=2,  gathering=3,  woodland=4,  commercial=5
#   Cities: mining=11, farming=12, gathering=13, woodland=14, commercial=15
#   Rural:  mining=21, farming=22, gathering=23, woodland=24, commercial=25
#
# Color mapping: red=mining, green=farming, blue=gathering, brown=woodland, purple=commercial

# =====================================================
# SIZE VARIABLES
# =====================================================
@city_marker_icon_size = 25
@city_marker_fort_icon_size = 16
@town_marker_icon_size = 20
@rural_marker_icon_size = 15

# =====================================================
# TEXT TEMPLATES - Specialized Location Names
# =====================================================
# Uses Modulo_int32 for specialization type (1-5), range comparison for rank

# Location scope version (for map_markers tooltips)
template eul_text_specialized_name_loc {
	text = "[Select_CString(Location.MakeScope.GetVariable('specialization_designation').IsSet, Concatenate(Select_CString(EqualTo_int32(Modulo_int32(FixedPointToInt(Location.MakeScope.GetVariable('specialization_designation').GetValue), '(int32)10'), '(int32)1'), Localize('EUL_SPEC_MINING'), Select_CString(EqualTo_int32(Modulo_int32(FixedPointToInt(Location.MakeScope.GetVariable('specialization_designation').GetValue), '(int32)10'), '(int32)2'), Localize('EUL_SPEC_FARMING'), Select_CString(EqualTo_int32(Modulo_int32(FixedPointToInt(Location.MakeScope.GetVariable('specialization_designation').GetValue), '(int32)10'), '(int32)3'), Localize('EUL_SPEC_GATHERING'), Select_CString(EqualTo_int32(Modulo_int32(FixedPointToInt(Location.MakeScope.GetVariable('specialization_designation').GetValue), '(int32)10'), '(int32)4'), Localize('EUL_SPEC_WOODLAND'), Localize('EUL_SPEC_COMMERCIAL'))))), Concatenate(Select_CString(GreaterThanOrEqualTo_int32(FixedPointToInt(Location.MakeScope.GetVariable('specialization_designation').GetValue), '(int32)21'), Localize('EUL_RANK_VILLAGE'), Select_CString(GreaterThanOrEqualTo_int32(FixedPointToInt(Location.MakeScope.GetVariable('specialization_designation').GetValue), '(int32)11'), Localize('EUL_RANK_CITY'), Localize('EUL_RANK_TOWN'))), Concatenate(Localize('EUL_OF'), Location.GetNameWithNoTooltip))), Location.GetRankAndName)]"
}


