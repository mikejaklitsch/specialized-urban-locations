# Specialized Urban Locations - Map Marker Overrides
# Loaded first (aaa prefix) to override vanilla templates (GUI: first loaded wins)

# =====================================================
# MARKER SIDE COLOR OVERRIDES
# =====================================================

template marker_unit_side_color {
	modify_texture = {
		using = color_grey_texture
		alpha = 0.35
		visible = "[Not(Or(Or(Unit.GetCountry.IsPlayer, Player.IsEnemy(Unit.GetCountry.Self)), Unit.GetCountry.IsAllied))]"
	}
	modify_texture = {
		using = color_enemy_red_texture
		alpha = 1
		visible = "[Player.IsEnemy(Unit.GetCountry.Self)]"
	}
	modify_texture = {
		using = color_allied_blue_texture
		alpha = 0.6
		visible = "[And(Not(Unit.GetCountry.IsPlayer), Unit.GetCountry.IsAllied)]"
	}
	modify_texture = {
		using = color_light_green_texture
		alpha = 0.5
		visible = "[Unit.GetCountry.IsPlayer]"
	}
}

template marker_country_side_color {
	modify_texture = {
		using = color_grey_texture
		alpha = 0.35
		visible = "[Not(Or(Or(Country.IsPlayer, Player.IsEnemy(Country.Self)), Country.IsAllied))]"
	}
	modify_texture = {
		using = color_enemy_red_texture
		alpha = 1
		visible = "[Player.IsEnemy(Country.Self)]"
	}
	modify_texture = {
		using = color_allied_blue_texture
		alpha = 0.6
		visible = "[And(Not(Country.IsPlayer), Country.IsAllied)]"
	}
	modify_texture = {
		using = color_light_green_texture
		alpha = 0.5
		visible = "[Country.IsPlayer]"
	}
}

template marker_siege_side_color {
	modify_texture = {
		using = color_grey_texture
		alpha = 0.35
		visible = "[Or(Siege.GetSiegeDefender.IsNeutral, Siege.GetLocation.HasCombat)]"
	}
	modify_texture = {
		using = color_enemy_red_texture
		alpha = 0.4
		visible = "[And(Siege.GetSiegeDefender.IsPlayer, Not(Siege.GetLocation.HasCombat))]"
	}
	modify_texture = {
		using = color_allied_blue_texture
		alpha = 0.6
		visible = "[And(Siege.GetSiegeDefender.IsAllied, Not(Siege.GetLocation.HasCombat))]"
	}
	modify_texture = {
		using = color_light_green_texture
		alpha = 0.3
		visible = "[And(Player.IsEnemy(Siege.GetSiegeDefender.Self), Not(Siege.GetLocation.HasCombat))]"
	}
}
