	visible = "[And(Location.MakeScope.GetVariable('sul_specialization_designation').IsSet, EqualTo_float(FixedPointToFloat(Location.MakeScope.GetVariable('sul_specialization_designation').GetValue), '(float)21.0'))]"
}

