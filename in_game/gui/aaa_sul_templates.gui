# =====================================================
# Mining Town (1)
template sul_vis_loc_noisset_mining_town_capital { visible = "[And(EqualTo_float(FixedPointToFloat(Location.MakeScope.GetVariable('sul_specialization_designation').GetValue), '(float)1.0'), Location.IsCapital)]" }
template sul_vis_loc_noisset_mining_town_prov_capital { visible = "[And3(EqualTo_float(FixedPointToFloat(Location.MakeScope.GetVariable('sul_specialization_designation').GetValue), '(float)1.0'), Location.IsProvinceCapital, Not(Location.IsCapital))]" }
template sul_vis_loc_noisset_mining_town_regular { visible = "[And3(EqualTo_float(FixedPointToFloat(Location.MakeScope.GetVariable('sul_specialization_designation').GetValue), '(float)1.0'), Not(Location.IsProvinceCapital), Not(Location.IsCapital))]" }
