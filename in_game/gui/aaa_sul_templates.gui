# =====================================================
# POP TYPE NEEDS TOOLTIP TEMPLATE
# =====================================================
# Shows pop type satisfaction and hoverable subcategories for needs
# Requires Location and PopType contexts

template sul_pop_type_needs_tooltip {
	ContextualTooltipType = {
		blockoverride "title_icon" {
			icon = {
				using = tooltip_title_icon_size
				texture = "[GetGraphicalCultureTextureForCountryPopType(PopType.Self, Location.GetOwner.Self)]"
			}
		}
		blockoverride "title_text" {
			raw_text = "[PopType.GetName] #bold ([Location.GetTotalPopTypeSize(PopType.Self)])#!"
		}
		blockoverride "concept_link" { text = "[pop_needs|E]" }
		blockoverride "tooltip_content" {
			# Subcategories - hoverable for Pop_tooltip -> PopNeeds_tooltip
			TooltipScrolledColumnList = {
				blockoverride "block_scrollarea" { maximumsize = { -1 300 } }
				blockoverride "empty_list_text" { text = "SUL_NO_POPS_OF_TYPE" }
				textcontext = "[Location.GetPopTypeBreakDown(PopType.Self)]"
			}
		}
	}
}

