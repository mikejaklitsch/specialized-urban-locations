template sul_vis_loc_not_specialized {
	visible = "[Not(Location.MakeScope.GetVariable('sul_spec_type').IsSet)]"
}

# =====================================================
# VISIBILITY TEMPLATES - LocationView Context (type+rank, with IsSet check)
# =====================================================

template sul_vis_locview_mining_town {
	visible = "[And(LocationView.GetLocation.MakeScope.GetVariable('sul_designation').IsSet, EqualTo_int32(FixedPointToInt(LocationView.GetLocation.MakeScope.GetVariable('sul_designation').GetValue), '(int32)1'))]"
}

template sul_vis_locview_farming_town {
	visible = "[And(LocationView.GetLocation.MakeScope.GetVariable('sul_designation').IsSet, EqualTo_int32(FixedPointToInt(LocationView.GetLocation.MakeScope.GetVariable('sul_designation').GetValue), '(int32)2'))]"
}

