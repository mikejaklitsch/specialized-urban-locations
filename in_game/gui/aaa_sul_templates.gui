# =====================================================
# ICON SIZE TEMPLATES
# =====================================================

template sul_icon_size_town {
	size = {
		@town_marker_icon_size
		@town_marker_icon_size
	}
}

template sul_icon_size_city {
	size = {
		@city_marker_icon_size
		@city_marker_icon_size
	}
}

template sul_icon_size_rural {
	size = {
		@rural_marker_icon_size
		@rural_marker_icon_size
	}
}

# =====================================================
# VISIBILITY TEMPLATES - LocationView Context (for tooltips)
# =====================================================
# These combine all three ranks (town/city/rural) for each specialization
# Usage: using = sul_vis_lv_commercial (instead of inline Or3 conditions)

template sul_vis_lv_commercial {
	visible = "[Or3(EqualTo_float(FixedPointToFloat(LocationView.GetLocation.MakeScope.GetVariable('sul_specialization_designation').GetValue), '(float)5.0'), EqualTo_float(FixedPointToFloat(LocationView.GetLocation.MakeScope.GetVariable('sul_specialization_designation').GetValue), '(float)15.0'), EqualTo_float(FixedPointToFloat(LocationView.GetLocation.MakeScope.GetVariable('sul_specialization_designation').GetValue), '(float)25.0'))]"
}

template sul_vis_lv_mining {
	visible = "[Or3(EqualTo_float(FixedPointToFloat(LocationView.GetLocation.MakeScope.GetVariable('sul_specialization_designation').GetValue), '(float)1.0'), EqualTo_float(FixedPointToFloat(LocationView.GetLocation.MakeScope.GetVariable('sul_specialization_designation').GetValue), '(float)11.0'), EqualTo_float(FixedPointToFloat(LocationView.GetLocation.MakeScope.GetVariable('sul_specialization_designation').GetValue), '(float)21.0'))]"
}

template sul_vis_lv_farming {
	visible = "[Or3(EqualTo_float(FixedPointToFloat(LocationView.GetLocation.MakeScope.GetVariable('sul_specialization_designation').GetValue), '(float)2.0'), EqualTo_float(FixedPointToFloat(LocationView.GetLocation.MakeScope.GetVariable('sul_specialization_designation').GetValue), '(float)12.0'), EqualTo_float(FixedPointToFloat(LocationView.GetLocation.MakeScope.GetVariable('sul_specialization_designation').GetValue), '(float)22.0'))]"
}

template sul_vis_lv_gathering {
	visible = "[Or3(EqualTo_float(FixedPointToFloat(LocationView.GetLocation.MakeScope.GetVariable('sul_specialization_designation').GetValue), '(float)3.0'), EqualTo_float(FixedPointToFloat(LocationView.GetLocation.MakeScope.GetVariable('sul_specialization_designation').GetValue), '(float)13.0'), EqualTo_float(FixedPointToFloat(LocationView.GetLocation.MakeScope.GetVariable('sul_specialization_designation').GetValue), '(float)23.0'))]"
}

template sul_vis_lv_woodland {
	visible = "[Or3(EqualTo_float(FixedPointToFloat(LocationView.GetLocation.MakeScope.GetVariable('sul_specialization_designation').GetValue), '(float)4.0'), EqualTo_float(FixedPointToFloat(LocationView.GetLocation.MakeScope.GetVariable('sul_specialization_designation').GetValue), '(float)14.0'), EqualTo_float(FixedPointToFloat(LocationView.GetLocation.MakeScope.GetVariable('sul_specialization_designation').GetValue), '(float)24.0'))]"
}

template sul_vis_lv_leather {
	visible = "[Or(Or3(EqualTo_float(FixedPointToFloat(LocationView.GetLocation.MakeScope.GetVariable('sul_specialization_designation').GetValue), '(float)2.0'), EqualTo_float(FixedPointToFloat(LocationView.GetLocation.MakeScope.GetVariable('sul_specialization_designation').GetValue), '(float)12.0'), EqualTo_float(FixedPointToFloat(LocationView.GetLocation.MakeScope.GetVariable('sul_specialization_designation').GetValue), '(float)22.0')), Or3(EqualTo_float(FixedPointToFloat(LocationView.GetLocation.MakeScope.GetVariable('sul_specialization_designation').GetValue), '(float)4.0'), EqualTo_float(FixedPointToFloat(LocationView.GetLocation.MakeScope.GetVariable('sul_specialization_designation').GetValue), '(float)14.0'), EqualTo_float(FixedPointToFloat(LocationView.GetLocation.MakeScope.GetVariable('sul_specialization_designation').GetValue), '(float)24.0')))]"
}

# =====================================================
# VISIBILITY TEMPLATES - Rank-Level (any specialization of rank)
# =====================================================
# Location context

template sul_vis_loc_any_city {
	visible = "[And3(Location.MakeScope.GetVariable('sul_specialization_designation').IsSet, GreaterThanOrEqualTo_float(FixedPointToFloat(Location.MakeScope.GetVariable('sul_specialization_designation').GetValue), '(float)11.0'), LessThanOrEqualTo_float(FixedPointToFloat(Location.MakeScope.GetVariable('sul_specialization_designation').GetValue), '(float)15.0'))]"
}

template sul_vis_loc_any_town {
	visible = "[And(Location.MakeScope.GetVariable('sul_specialization_designation').IsSet, LessThanOrEqualTo_float(FixedPointToFloat(Location.MakeScope.GetVariable('sul_specialization_designation').GetValue), '(float)5.0'))]"
}

template sul_vis_loc_any_rural {
	visible = "[And(Location.MakeScope.GetVariable('sul_specialization_designation').IsSet, GreaterThanOrEqualTo_float(FixedPointToFloat(Location.MakeScope.GetVariable('sul_specialization_designation').GetValue), '(float)21.0'))]"
}

# MarketMarker context

template sul_vis_market_any_city {
	visible = "[And3(MarketMarker.GetLocation.MakeScope.GetVariable('sul_specialization_designation').IsSet, GreaterThanOrEqualTo_float(FixedPointToFloat(MarketMarker.GetLocation.MakeScope.GetVariable('sul_specialization_designation').GetValue), '(float)11.0'), LessThanOrEqualTo_float(FixedPointToFloat(MarketMarker.GetLocation.MakeScope.GetVariable('sul_specialization_designation').GetValue), '(float)15.0'))]"
}

template sul_vis_market_any_town {
	visible = "[And(MarketMarker.GetLocation.MakeScope.GetVariable('sul_specialization_designation').IsSet, LessThanOrEqualTo_float(FixedPointToFloat(MarketMarker.GetLocation.MakeScope.GetVariable('sul_specialization_designation').GetValue), '(float)5.0'))]"
}

template sul_vis_market_any_rural {
	visible = "[And(MarketMarker.GetLocation.MakeScope.GetVariable('sul_specialization_designation').IsSet, GreaterThanOrEqualTo_float(FixedPointToFloat(MarketMarker.GetLocation.MakeScope.GetVariable('sul_specialization_designation').GetValue), '(float)21.0'))]"
}

template sul_vis_market_not_specialized {
	visible = "[Not(MarketMarker.GetLocation.MakeScope.GetVariable('sul_specialization_designation').IsSet)]"
}

# CityMarker context

template sul_vis_citymarker_any_city {
	visible = "[And3(CityMarker.GetLocation.MakeScope.GetVariable('sul_specialization_designation').IsSet, GreaterThanOrEqualTo_float(FixedPointToFloat(CityMarker.GetLocation.MakeScope.GetVariable('sul_specialization_designation').GetValue), '(float)11.0'), LessThanOrEqualTo_float(FixedPointToFloat(CityMarker.GetLocation.MakeScope.GetVariable('sul_specialization_designation').GetValue), '(float)15.0'))]"
}

template sul_vis_citymarker_any_town {
	visible = "[And(CityMarker.GetLocation.MakeScope.GetVariable('sul_specialization_designation').IsSet, LessThanOrEqualTo_float(FixedPointToFloat(CityMarker.GetLocation.MakeScope.GetVariable('sul_specialization_designation').GetValue), '(float)5.0'))]"
}

template sul_vis_citymarker_any_rural {
	visible = "[And(CityMarker.GetLocation.MakeScope.GetVariable('sul_specialization_designation').IsSet, GreaterThanOrEqualTo_float(FixedPointToFloat(CityMarker.GetLocation.MakeScope.GetVariable('sul_specialization_designation').GetValue), '(float)21.0'))]"
}

template sul_vis_citymarker_not_specialized {
	visible = "[Not(CityMarker.GetLocation.MakeScope.GetVariable('sul_specialization_designation').IsSet)]"
}

# =====================================================
# TOOLTIP VALUE CELL TEMPLATES
# =====================================================
# Reusable widgets for tooltip table cells
# Usage: using = sul_value_cell blockoverride "val" { raw_text = "..." }

template sul_value_cell {
	size = {
		50
		20
	}

	text_single = {
		parentanchor = right|vcenter
		block "val" {  }
	}
}

template sul_value_cell_wide {
	size = {
		60
		20
	}

	text_single = {
		parentanchor = right|vcenter
		block "val" {  }
		block "tip" {  }
	}
}

# Modifier display cells - simple GetModifierValue accessors

template sul_food_modifier_cell {
	size = {
		60
		20
	}

	text_single = {
		parentanchor = right|vcenter
		raw_text = "[LocationView.GetLocation.GetModifierValue('local_monthly_food_modifier')]"
	}
}

template sul_raw_modifier_cell {
	size = {
		60
		20
	}

	text_single = {
		parentanchor = right|vcenter
		raw_text = "[LocationView.GetLocation.GetModifierValue('local_raw_material_output')]"
	}
}

template sul_rgo_modifier_cell {
	size = {
		60
		20
	}

	text_single = {
		parentanchor = right|vcenter
		raw_text = "[LocationView.GetLocation.GetModifierValue('local_max_rgo_size_modifier')]"
	}
}

template sul_efficiency_modifier_cell {
	size = {
		60
		20
	}

	text_single = {
		parentanchor = right|vcenter
		raw_text = "[LocationView.GetLocation.GetModifierValue('local_production_efficiency')]"
	}
}

# Complete food consumption tooltip block (all pop types)

template sul_food_consumption_block {
	TooltipTableHeader = {
		blockoverride "tableheader_text" { text = "SUL_FOOD_CONSUMPTION_HEADER" }
	}

	TooltipListRowContent = {
		vbox = {
			layoutpolicy_horizontal = expanding

			TooltipManualTableField = {
				blockoverride "field_content" {
					hbox = {
						spacing = 5

						icon = {
							size = { 28 28 }
							texture = "gfx/interface/icons/modifier_types/global_pop_food_consumption.dds"
						}

						text_single = {
							text = "MODIFIER_TYPE_NAME_local_pop_food_consumption"

							tooltipwidget = {
								ContextualTooltipType = {
									blockoverride "title_text" { text = "MODIFIER_TYPE_NAME_local_pop_food_consumption" }
