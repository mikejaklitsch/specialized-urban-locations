template sul_vis_locview_gathering_rural { visible = "[And(LocationView.GetLocation.MakeScope.GetVariable('sul_specialization_designation').IsSet, EqualTo_float(FixedPointToFloat(LocationView.GetLocation.MakeScope.GetVariable('sul_specialization_designation').GetValue), '(float)23.0'))]" }
template sul_vis_locview_woodland_rural { visible = "[And(LocationView.GetLocation.MakeScope.GetVariable('sul_specialization_designation').IsSet, EqualTo_float(FixedPointToFloat(LocationView.GetLocation.MakeScope.GetVariable('sul_specialization_designation').GetValue), '(float)24.0'))]" }
