template sul_food_breakdown_tooltip {
	ContextualTooltipType = {
		blockoverride "title_icon" {
			icon = {
				using = tooltip_title_icon_size
				texture = "gfx/interface/icons/modifier_types/global_monthly_food_modifier.dds"
			}
		}
		blockoverride "title_text" { text = "MODIFIER_TYPE_NAME_local_monthly_food_modifier" }
		blockoverride "tooltip_content" {
			TooltipListBase = {
				TooltipListRowContent = {
					# Baseline row
					TooltipManualTableField = {
						blockoverride "field_content" {
							text_single = {
								raw_text = "[LocationView.GetLocation.MakeScope.ScriptValue('sul_effective_building_levels')|1] Building Levels ([LocationView.GetLocation.MakeScope.ScriptValue('sul_food_per_level')|%0] per Level)"
							}

							expand = {  }

							widget = {
								using = sul_value_cell

								blockoverride "val" {
									raw_text = "#R [LocationView.GetLocation.MakeScope.ScriptValue('sul_building_baseline_food')|%+1]#!"
								}
							}
						}
					}

					# Building rows - only show if > 0
