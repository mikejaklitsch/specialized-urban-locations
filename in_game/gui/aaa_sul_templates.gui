# Specialized Urban Locations - Shared Templates
# This file loads first (alphabetically) to ensure templates are available to all GUI files
#
# Specialization modifiers (boolean, from location_ranks):
#   1=mining, 2=farming, 3=gathering, 4=woodland, 5=commercial
#
# Color mapping: red=mining, green=farming, blue=gathering, brown=woodland, purple=commercial
# =====================================================
# SIZE VARIABLES
# =====================================================
@city_marker_icon_size = 30
@city_marker_fort_icon_size = 30
@town_marker_icon_size = 26
@rural_marker_icon_size = 20
# =====================================================
# MAP MARKER ICON TEMPLATES
# =====================================================
# Tooltip icon — uses native GetRankIcon (Location context)
# =====================================================
# TEXT TEMPLATES - Specialized Location Names
# =====================================================
# Uses specialization modifiers for type, Location.GetRank for rank
# Location scope version (for map_markers tooltips)

template sul_text_specialized_name_loc {
	text = "[Select_CString(Or3(NotEqualTo_CFixedPoint(Location.GetModifierValueFixed('sul_is_rural_settlement_rank_tier'), '(CFixedPoint)0'), NotEqualTo_CFixedPoint(Location.GetModifierValueFixed('sul_is_town_rank_tier'), '(CFixedPoint)0'), NotEqualTo_CFixedPoint(Location.GetModifierValueFixed('sul_is_city_rank_tier'), '(CFixedPoint)0')), Concatenate(Select_CString(NotEqualTo_CFixedPoint(Location.GetModifierValueFixed('sul_mining_specialization'), '(CFixedPoint)0'), Localize('EUL_SPEC_MINING'), Select_CString(NotEqualTo_CFixedPoint(Location.GetModifierValueFixed('sul_farming_specialization'), '(CFixedPoint)0'), Localize('EUL_SPEC_FARMING'), Select_CString(NotEqualTo_CFixedPoint(Location.GetModifierValueFixed('sul_gathering_specialization'), '(CFixedPoint)0'), Localize('EUL_SPEC_GATHERING'), Select_CString(NotEqualTo_CFixedPoint(Location.GetModifierValueFixed('sul_woodland_specialization'), '(CFixedPoint)0'), Localize('EUL_SPEC_WOODLAND'), Localize('EUL_SPEC_COMMERCIAL'))))), Concatenate(Select_CString(And(Location.GetRank.IsCity, Location.GetRank.IsMaxRank), Localize('EUL_RANK_CITY'), Select_CString(Location.GetRank.IsCity, Localize('EUL_RANK_TOWN'), Localize('EUL_RANK_VILLAGE'))), Concatenate(Localize('EUL_OF'), Location.GetNameWithNoTooltip))), Location.GetRankAndName)]"
}

# =====================================================
# CONCEPT TEXTURE TEMPLATES - Fixed Type (Designation Buttons)
# =====================================================
# For buttons that always show a specific specialization type
# Key = sul_icon_{fixed_type + rank_offset + capital_offset}
#   rank_offset: IsMaxRank → 10 (city), IsCity → 0 (town), else → 20 (rural)
#   capital_offset: 0=regular, 100=province capital, 200=country capital

template sul_concept_texture_mining_button {
	texture = "[GetConceptTexture(Concatenate('sul_icon_', ToString_int32(Add_int32(Add_int32('(int32)1', Select_int32(LocationView.GetLocation.GetRank.IsMaxRank, '(int32)10', Select_int32(LocationView.GetLocation.GetRank.IsCity, '(int32)0', '(int32)20'))), Select_int32(LocationView.GetLocation.IsCapital, '(int32)200', Select_int32(LocationView.GetLocation.IsProvinceCapital, '(int32)100', '(int32)0'))))))]"
}

template sul_concept_texture_farming_button {
	texture = "[GetConceptTexture(Concatenate('sul_icon_', ToString_int32(Add_int32(Add_int32('(int32)2', Select_int32(LocationView.GetLocation.GetRank.IsMaxRank, '(int32)10', Select_int32(LocationView.GetLocation.GetRank.IsCity, '(int32)0', '(int32)20'))), Select_int32(LocationView.GetLocation.IsCapital, '(int32)200', Select_int32(LocationView.GetLocation.IsProvinceCapital, '(int32)100', '(int32)0'))))))]"
}

template sul_concept_texture_gathering_button {
	texture = "[GetConceptTexture(Concatenate('sul_icon_', ToString_int32(Add_int32(Add_int32('(int32)3', Select_int32(LocationView.GetLocation.GetRank.IsMaxRank, '(int32)10', Select_int32(LocationView.GetLocation.GetRank.IsCity, '(int32)0', '(int32)20'))), Select_int32(LocationView.GetLocation.IsCapital, '(int32)200', Select_int32(LocationView.GetLocation.IsProvinceCapital, '(int32)100', '(int32)0'))))))]"
}

template sul_concept_texture_woodland_button {
	texture = "[GetConceptTexture(Concatenate('sul_icon_', ToString_int32(Add_int32(Add_int32('(int32)4', Select_int32(LocationView.GetLocation.GetRank.IsMaxRank, '(int32)10', Select_int32(LocationView.GetLocation.GetRank.IsCity, '(int32)0', '(int32)20'))), Select_int32(LocationView.GetLocation.IsCapital, '(int32)200', Select_int32(LocationView.GetLocation.IsProvinceCapital, '(int32)100', '(int32)0'))))))]"
}

template sul_concept_texture_commercial_button {
	texture = "[GetConceptTexture(Concatenate('sul_icon_', ToString_int32(Add_int32(Add_int32('(int32)5', Select_int32(LocationView.GetLocation.GetRank.IsMaxRank, '(int32)10', Select_int32(LocationView.GetLocation.GetRank.IsCity, '(int32)0', '(int32)20'))), Select_int32(LocationView.GetLocation.IsCapital, '(int32)200', Select_int32(LocationView.GetLocation.IsProvinceCapital, '(int32)100', '(int32)0'))))))]"
}

# =====================================================
# VISIBILITY TEMPLATES - LocationView Context (for tooltips)
# =====================================================
# Check specialization modifiers directly
# Usage: using = sul_vis_lv_commercial

template sul_vis_lv_commercial {
	visible = "[NotEqualTo_CFixedPoint(LocationView.GetLocation.GetModifierValueFixed('sul_commercial_specialization'), '(CFixedPoint)0')]"
}

template sul_vis_lv_mining {
	visible = "[NotEqualTo_CFixedPoint(LocationView.GetLocation.GetModifierValueFixed('sul_mining_specialization'), '(CFixedPoint)0')]"
}

template sul_vis_lv_farming {
	visible = "[NotEqualTo_CFixedPoint(LocationView.GetLocation.GetModifierValueFixed('sul_farming_specialization'), '(CFixedPoint)0')]"
}

template sul_vis_lv_gathering {
	visible = "[NotEqualTo_CFixedPoint(LocationView.GetLocation.GetModifierValueFixed('sul_gathering_specialization'), '(CFixedPoint)0')]"
}

template sul_vis_lv_woodland {
	visible = "[NotEqualTo_CFixedPoint(LocationView.GetLocation.GetModifierValueFixed('sul_woodland_specialization'), '(CFixedPoint)0')]"
}
# =====================================================
# VISIBILITY TEMPLATE - LocationView Context (has any specialization)
# =====================================================

template sul_vis_locview_has_specialization {
	visible = "[Or3(NotEqualTo_CFixedPoint(LocationView.GetLocation.GetModifierValueFixed('sul_is_rural_settlement_rank_tier'), '(CFixedPoint)0'), NotEqualTo_CFixedPoint(LocationView.GetLocation.GetModifierValueFixed('sul_is_town_rank_tier'), '(CFixedPoint)0'), NotEqualTo_CFixedPoint(LocationView.GetLocation.GetModifierValueFixed('sul_is_city_rank_tier'), '(CFixedPoint)0'))]"
}
template LocationBuildingLevels_tooltip {
	ContextualTooltipType = {
		blockoverride "title_icon" {
			icon = {
				using = tooltip_title_icon_size
				texture = "[GetConceptTexture('supported_building_levels')]"
			}
		}

		blockoverride "title_text" { datacontext = "[Location]" text = "BUILDING_LEVELS_LABEL" }

		blockoverride "concept_link" { text = "[sul_building_level|E]" }

		blockoverride "tooltip_content" {
			TooltipStringPairList = {
				datacontext = "[Location]"
				textcontext = "LOCATION_CURR_LEVELS"

				tooltipwidget = {
					SimpleContextualStringPairTooltipType = {
						blockoverride "title_icon" {
							icon = {
								using = tooltip_title_icon_size
								texture = "gfx/interface/icons/outliner/categories/buildings.dds"
							}
						}

						blockoverride "concept_link" { text = "[buildings|e]" }

						lowpriotextcontext = "[Location.GetBuildingLevelInfo]"
					}
				}
			}

			TooltipListBase = {
				blockoverride "block_title" { text = "SUL_BUILDING_LEVEL_EFFECTS_LABEL" }

				TooltipListRowContent = {
					TooltipManualTableField = {
						blockoverride "field_content" {
							hbox = {
								spacing = 5

								icon = {
									size = { 28 28 }
									texture = "gfx/interface/icons/modifier_types/global_monthly_food_modifier.dds"
								}

								text_single = { text = "MODIFIER_TYPE_NAME_local_monthly_food_modifier" }
							}

							expand = {  }

							widget = {
								size = { 50 20 }

								text_single = {
									parentanchor = right|vcenter
									raw_text = "[Multiply_CFixedPoint(LocationView.GetLocation.GetNumBuildingLevelsWithEmployment, '(CFixedPoint)-0.02')|%+2]"
								}
							}
						}
					}

					TooltipManualTableField = {
						blockoverride "field_content" {
							hbox = {
								spacing = 5

								icon = {
									size = { 28 28 }
									texture = "gfx/interface/icons/modifier_types/global_raw_material_output.dds"
								}

								text_single = { text = "MODIFIER_TYPE_NAME_local_raw_material_output" }
							}

							expand = {  }

							widget = {
								size = { 50 20 }

								text_single = {
									parentanchor = right|vcenter
									raw_text = "[Multiply_CFixedPoint(LocationView.GetLocation.GetNumBuildingLevelsWithEmployment, '(CFixedPoint)-0.005')|%+2]"
								}
							}
						}
					}

					TooltipManualTableField = {
						blockoverride "field_content" {
							hbox = {
								spacing = 5

								icon = {
									size = { 28 28 }
									texture = "gfx/interface/icons/modifier_types/global_production_efficiency.dds"
								}

								text_single = { text = "SUL_FINISHED_GOODS_OUTPUT" }
							}

							expand = {  }

							widget = {
								size = { 50 20 }

								text_single = {
									parentanchor = right|vcenter
									raw_text = "[Multiply_CFixedPoint(LocationView.GetLocation.GetNumBuildingLevelsWithEmployment, '(CFixedPoint)-0.005')|%+2]"
								}
							}
						}
					}
				}
			}

			TooltipStringPairList = {
				blockoverride "block_title" {
					datacontext = "[Location]"
					text = "SUL_SUPPORTED_BUILDING_LEVELS_LABEL"
				}

				textcontext = "[Location.GetDescriptionFor('free_building_levels')]"
			}

			TooltipStringPairList = {
				visible = "[Location.HasTooManyBuildingLevel]"
				datacontext = "[Location]"

				blockoverride "block_title" { text = "LOCATION_TOO_MANY_BUILD_LEVELS_LABEL" }

				textcontext = "[Location.GetTooManyBuildingInfo]"
			}
		}
	}
}
