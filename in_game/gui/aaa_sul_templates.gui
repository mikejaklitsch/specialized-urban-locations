# =====================================================
# ICON SIZE TEMPLATES
# =====================================================
template sul_icon_size_town { size = { @town_marker_icon_size @town_marker_icon_size } }
template sul_icon_size_city { size = { @city_marker_icon_size @city_marker_icon_size } }
template sul_icon_size_rural { size = { @rural_marker_icon_size @rural_marker_icon_size } }

# =====================================================
# VISIBILITY TEMPLATES - Location Context (with IsSet check)
# =====================================================
template sul_vis_loc_mining_town { visible = "[And(Location.MakeScope.GetVariable('sul_specialization_designation').IsSet, EqualTo_float(FixedPointToFloat(Location.MakeScope.GetVariable('sul_specialization_designation').GetValue), '(float)1.0'))]" }
