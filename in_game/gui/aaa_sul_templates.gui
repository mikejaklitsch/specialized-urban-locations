template sul_demand_formula_tooltip {
	ContextualTooltipType = {
		blockoverride "title_icon" {
			icon = {
				using = tooltip_title_icon_size
				texture = "gfx/interface/icons/flat_icons/tabicons/economy.dds"
			}
		}
		blockoverride "title_text" { text = "SUL_DEMAND_FORMULA_TITLE" }
		blockoverride "tooltip_content" {
			# Formula explanation
			TooltipTextBlock = { blockoverride "text" { text = "SUL_DEMAND_FORMULA_DESC" } }
			# Class scaling table
			TooltipListBase = {
				vbox = {
					layoutpolicy_horizontal = expanding
					margin = { 10 6 }

					text_single = {
						layoutpolicy_horizontal = expanding
						text = "SUL_DEMAND_FORMULA_MAXIMUMS_HEADER"
						default_format = "#T"
					}

					# Header row
					hbox = {
						layoutpolicy_horizontal = expanding
						margin_top = 4
						text_single = { min_width = 80 raw_text = "#T Pop Type#!" }
						text_single = { min_width = 90 raw_text = "#T Floor → Ceil#!" }
						text_single = { min_width = 30 raw_text = "#T k#!" }
					}
					hbox = {
						layoutpolicy_horizontal = expanding
						margin_top = 2
						text_single = { min_width = 80 raw_text = "Nobles" }
						text_single = { min_width = 90 raw_text = "#G 0.8x → 5.0x#!" }
						text_single = { min_width = 30 raw_text = "200" }
					}
					hbox = {
						layoutpolicy_horizontal = expanding
						margin_top = 2
						text_single = { min_width = 80 raw_text = "Clergy" }
						text_single = { min_width = 90 raw_text = "#G 0.8x → 4.0x#!" }
						text_single = { min_width = 30 raw_text = "150" }
					}
					hbox = {
						layoutpolicy_horizontal = expanding
						margin_top = 2
						text_single = { min_width = 80 raw_text = "Burghers" }
						text_single = { min_width = 90 raw_text = "#G 0.8x → 3.5x#!" }
						text_single = { min_width = 30 raw_text = "150" }
					}
					hbox = {
						layoutpolicy_horizontal = expanding
						margin_top = 2
						text_single = { min_width = 80 raw_text = "Soldiers" }
						text_single = { min_width = 90 raw_text = "#G 0.8x → 2.5x#!" }
						text_single = { min_width = 30 raw_text = "100" }
					}
					hbox = {
						layoutpolicy_horizontal = expanding
						margin_top = 2
						text_single = { min_width = 80 raw_text = "Laborers" }
						text_single = { min_width = 90 raw_text = "#G 0.8x → 2.5x#!" }
						text_single = { min_width = 30 raw_text = "100" }
					}
					hbox = {
						layoutpolicy_horizontal = expanding
						margin_top = 2
						text_single = { min_width = 80 raw_text = "Peasants" }
						text_single = { min_width = 90 raw_text = "#G 0.8x → 2.5x#!" }
						text_single = { min_width = 30 raw_text = "100" }
					}
					hbox = {
						layoutpolicy_horizontal = expanding
						margin_top = 2
						text_single = { min_width = 80 raw_text = "Tribesmen" }
						text_single = { min_width = 90 raw_text = "#G 0.8x → 2.0x#!" }
						text_single = { min_width = 30 raw_text = "75" }
					}
					hbox = {
						layoutpolicy_horizontal = expanding
						margin_top = 2
						text_single = { min_width = 80 raw_text = "Slaves" }
						text_single = { min_width = 90 raw_text = "#G 0.8x#!" }
						text_single = { min_width = 30 raw_text = "-" }
					}
				}
			}
		}
	}
}
