# =====================================================
# VISIBILITY TEMPLATES - Location Context (with IsSet check)
# =====================================================

template sul_vis_loc_mining_town {
	visible = "[And(Location.MakeScope.GetVariable('sul_specialization_designation').IsSet, EqualTo_float(FixedPointToFloat(Location.MakeScope.GetVariable('sul_specialization_designation').GetValue), '(float)1.0'))]"
}

template sul_vis_loc_farming_town {
	visible = "[And(Location.MakeScope.GetVariable('sul_specialization_designation').IsSet, EqualTo_float(FixedPointToFloat(Location.MakeScope.GetVariable('sul_specialization_designation').GetValue), '(float)2.0'))]"
}

template sul_vis_loc_gathering_town {
	visible = "[And(Location.MakeScope.GetVariable('sul_specialization_designation').IsSet, EqualTo_float(FixedPointToFloat(Location.MakeScope.GetVariable('sul_specialization_designation').GetValue), '(float)3.0'))]"
}

template sul_vis_loc_woodland_town {
	visible = "[And(Location.MakeScope.GetVariable('sul_specialization_designation').IsSet, EqualTo_float(FixedPointToFloat(Location.MakeScope.GetVariable('sul_specialization_designation').GetValue), '(float)4.0'))]"
}

template sul_vis_loc_commercial_town {
	visible = "[And(Location.MakeScope.GetVariable('sul_specialization_designation').IsSet, EqualTo_float(FixedPointToFloat(Location.MakeScope.GetVariable('sul_specialization_designation').GetValue), '(float)5.0'))]"
}

template sul_vis_loc_mining_city {
	visible = "[And(Location.MakeScope.GetVariable('sul_specialization_designation').IsSet, EqualTo_float(FixedPointToFloat(Location.MakeScope.GetVariable('sul_specialization_designation').GetValue), '(float)11.0'))]"
}

template sul_vis_loc_farming_city {
	visible = "[And(Location.MakeScope.GetVariable('sul_specialization_designation').IsSet, EqualTo_float(FixedPointToFloat(Location.MakeScope.GetVariable('sul_specialization_designation').GetValue), '(float)12.0'))]"
}

template sul_vis_loc_gathering_city {
	visible = "[And(Location.MakeScope.GetVariable('sul_specialization_designation').IsSet, EqualTo_float(FixedPointToFloat(Location.MakeScope.GetVariable('sul_specialization_designation').GetValue), '(float)13.0'))]"
}

template sul_vis_loc_woodland_city {
	visible = "[And(Location.MakeScope.GetVariable('sul_specialization_designation').IsSet, EqualTo_float(FixedPointToFloat(Location.MakeScope.GetVariable('sul_specialization_designation').GetValue), '(float)14.0'))]"
}

template sul_vis_loc_commercial_city {
	visible = "[And(Location.MakeScope.GetVariable('sul_specialization_designation').IsSet, EqualTo_float(FixedPointToFloat(Location.MakeScope.GetVariable('sul_specialization_designation').GetValue), '(float)15.0'))]"
}

