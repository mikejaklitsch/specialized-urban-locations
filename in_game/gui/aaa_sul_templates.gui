	visible = "[And(LocationView.GetLocation.MakeScope.GetVariable('sul_designation').IsSet, EqualTo_int32(FixedPointToInt(LocationView.GetLocation.MakeScope.GetVariable('sul_designation').GetValue), '(int32)3'))]"
}

