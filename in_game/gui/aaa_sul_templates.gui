# Specialized Urban Locations - Shared Templates
# This file loads first (alphabetically) to ensure templates are available to all GUI files
#
# sul_spec_type values (type only, no rank encoding):
#   1=mining, 2=farming, 3=gathering, 4=woodland, 5=commercial
#
# Color mapping: red=mining, green=farming, blue=gathering, brown=woodland, purple=commercial
# =====================================================
# SIZE VARIABLES
# =====================================================
@city_marker_icon_size = 30
@city_marker_fort_icon_size = 16
@town_marker_icon_size = 26
@rural_marker_icon_size = 20
# =====================================================
# TEXT TEMPLATES - Specialized Location Names
# =====================================================
# Uses sul_spec_type (1-5) for specialization type, Location.GetRank for rank
# Location scope version (for map_markers tooltips)

template sul_text_specialized_name_loc {
	text = "[Select_CString(Location.MakeScope.GetVariable('sul_spec_type').IsSet, Concatenate(Select_CString(EqualTo_int32(FixedPointToInt(Location.MakeScope.GetVariable('sul_spec_type').GetValue), '(int32)1'), Localize('EUL_SPEC_MINING'), Select_CString(EqualTo_int32(FixedPointToInt(Location.MakeScope.GetVariable('sul_spec_type').GetValue), '(int32)2'), Localize('EUL_SPEC_FARMING'), Select_CString(EqualTo_int32(FixedPointToInt(Location.MakeScope.GetVariable('sul_spec_type').GetValue), '(int32)3'), Localize('EUL_SPEC_GATHERING'), Select_CString(EqualTo_int32(FixedPointToInt(Location.MakeScope.GetVariable('sul_spec_type').GetValue), '(int32)4'), Localize('EUL_SPEC_WOODLAND'), Localize('EUL_SPEC_COMMERCIAL'))))), Concatenate(Select_CString(And(GreaterThanOrEqualTo_int32(FixedPointToInt(Location.MakeScope.GetVariable('sul_designation').GetValue), '(int32)11'), LessThanOrEqualTo_int32(FixedPointToInt(Location.MakeScope.GetVariable('sul_designation').GetValue), '(int32)15')), Localize('EUL_RANK_CITY'), Select_CString(LessThanOrEqualTo_int32(FixedPointToInt(Location.MakeScope.GetVariable('sul_designation').GetValue), '(int32)5'), Localize('EUL_RANK_TOWN'), Localize('EUL_RANK_VILLAGE'))), Concatenate(Localize('EUL_OF'), Location.GetNameWithNoTooltip))), Location.GetRankAndName)]"
}

# =====================================================
# POSITION TEMPLATES
# =====================================================
# Matches vanilla icon positioning in location_window.gui

template sul_icon_center_pos {
	position = {
		1
		0
	}
}

# =====================================================
# =====================================================
# CONCEPT TEXTURE TEMPLATES - Dynamic Icon Resolution
# =====================================================
# Resolves the correct map marker icon DDS via GetConceptTexture()
# Key = sul_icon_{designation + capital_offset}
#   designation: sul_designation variable (type 1-5 + rank offset 0/10/20)
#   capital_offset: 0=regular, 100=province capital, 200=country capital
# See game_concepts/sul_icon_concepts.txt for the full mapping table
# Location context (map_markers, tooltips)

template sul_concept_texture_loc {
	texture = "[GetConceptTexture(Concatenate('sul_icon_', ToString_int32(Add_int32(FixedPointToInt(Location.MakeScope.GetVariable('sul_designation').GetValue), Select_int32(Location.IsCapital, '(int32)200', Select_int32(Location.IsProvinceCapital, '(int32)100', '(int32)0'))))))]"
}

# LocationView context (location_window)

template sul_concept_texture_locview {
	texture = "[GetConceptTexture(Concatenate('sul_icon_', ToString_int32(Add_int32(FixedPointToInt(LocationView.GetLocation.MakeScope.GetVariable('sul_designation').GetValue), Select_int32(LocationView.GetLocation.IsCapital, '(int32)200', Select_int32(LocationView.GetLocation.IsProvinceCapital, '(int32)100', '(int32)0'))))))]"
}

# MarketMarker context (market map mode)

template sul_concept_texture_market {
	texture = "[GetConceptTexture(Concatenate('sul_icon_', ToString_int32(Add_int32(FixedPointToInt(MarketMarker.GetLocation.MakeScope.GetVariable('sul_designation').GetValue), Select_int32(MarketMarker.GetLocation.IsCapital, '(int32)200', Select_int32(MarketMarker.GetLocation.IsProvinceCapital, '(int32)100', '(int32)0'))))))]"
}

# CityMarker context (city map markers)

template sul_concept_texture_citymarker {
	texture = "[GetConceptTexture(Concatenate('sul_icon_', ToString_int32(Add_int32(FixedPointToInt(CityMarker.GetLocation.MakeScope.GetVariable('sul_designation').GetValue), Select_int32(CityMarker.GetLocation.IsCapital, '(int32)200', Select_int32(CityMarker.GetLocation.IsProvinceCapital, '(int32)100', '(int32)0'))))))]"
}

# =====================================================
# CONCEPT TEXTURE TEMPLATES - Fixed Type (Designation Buttons)
# =====================================================
# For buttons that always show a specific specialization type
# Key = sul_icon_{fixed_type + rank_offset + capital_offset}
#   rank_offset: IsMaxRank → 10 (city), IsCity → 0 (town), else → 20 (rural)
#   capital_offset: 0=regular, 100=province capital, 200=country capital

template sul_concept_texture_mining_button {
	texture = "[GetConceptTexture(Concatenate('sul_icon_', ToString_int32(Add_int32(Add_int32('(int32)1', Select_int32(LocationView.GetLocation.GetRank.IsMaxRank, '(int32)10', Select_int32(LocationView.GetLocation.GetRank.IsCity, '(int32)0', '(int32)20'))), Select_int32(LocationView.GetLocation.IsCapital, '(int32)200', Select_int32(LocationView.GetLocation.IsProvinceCapital, '(int32)100', '(int32)0'))))))]"
}

template sul_concept_texture_farming_button {
	texture = "[GetConceptTexture(Concatenate('sul_icon_', ToString_int32(Add_int32(Add_int32('(int32)2', Select_int32(LocationView.GetLocation.GetRank.IsMaxRank, '(int32)10', Select_int32(LocationView.GetLocation.GetRank.IsCity, '(int32)0', '(int32)20'))), Select_int32(LocationView.GetLocation.IsCapital, '(int32)200', Select_int32(LocationView.GetLocation.IsProvinceCapital, '(int32)100', '(int32)0'))))))]"
}

template sul_concept_texture_gathering_button {
	texture = "[GetConceptTexture(Concatenate('sul_icon_', ToString_int32(Add_int32(Add_int32('(int32)3', Select_int32(LocationView.GetLocation.GetRank.IsMaxRank, '(int32)10', Select_int32(LocationView.GetLocation.GetRank.IsCity, '(int32)0', '(int32)20'))), Select_int32(LocationView.GetLocation.IsCapital, '(int32)200', Select_int32(LocationView.GetLocation.IsProvinceCapital, '(int32)100', '(int32)0'))))))]"
}

template sul_concept_texture_woodland_button {
	texture = "[GetConceptTexture(Concatenate('sul_icon_', ToString_int32(Add_int32(Add_int32('(int32)4', Select_int32(LocationView.GetLocation.GetRank.IsMaxRank, '(int32)10', Select_int32(LocationView.GetLocation.GetRank.IsCity, '(int32)0', '(int32)20'))), Select_int32(LocationView.GetLocation.IsCapital, '(int32)200', Select_int32(LocationView.GetLocation.IsProvinceCapital, '(int32)100', '(int32)0'))))))]"
}

template sul_concept_texture_commercial_button {
	texture = "[GetConceptTexture(Concatenate('sul_icon_', ToString_int32(Add_int32(Add_int32('(int32)5', Select_int32(LocationView.GetLocation.GetRank.IsMaxRank, '(int32)10', Select_int32(LocationView.GetLocation.GetRank.IsCity, '(int32)0', '(int32)20'))), Select_int32(LocationView.GetLocation.IsCapital, '(int32)200', Select_int32(LocationView.GetLocation.IsProvinceCapital, '(int32)100', '(int32)0'))))))]"
}

# =====================================================
# ICON SIZE TEMPLATES
# =====================================================

template sul_icon_size_town {
	size = {
		@town_marker_icon_size
		@town_marker_icon_size
	}
}

template sul_icon_size_city {
	size = {
		@city_marker_icon_size
		@city_marker_icon_size
	}
}

template sul_icon_size_rural {
	size = {
		@rural_marker_icon_size
		@rural_marker_icon_size
	}
}

# =====================================================
# VISIBILITY TEMPLATES - LocationView Context (for tooltips)
# =====================================================
# Check sul_spec_type directly (1-5)
# Usage: using = sul_vis_lv_commercial

template sul_vis_lv_commercial {
	visible = "[EqualTo_float(FixedPointToFloat(LocationView.GetLocation.MakeScope.GetVariable('sul_spec_type').GetValue), '(float)5.0')]"
}

template sul_vis_lv_mining {
	visible = "[EqualTo_float(FixedPointToFloat(LocationView.GetLocation.MakeScope.GetVariable('sul_spec_type').GetValue), '(float)1.0')]"
}

template sul_vis_lv_farming {
	visible = "[EqualTo_float(FixedPointToFloat(LocationView.GetLocation.MakeScope.GetVariable('sul_spec_type').GetValue), '(float)2.0')]"
}

template sul_vis_lv_gathering {
	visible = "[EqualTo_float(FixedPointToFloat(LocationView.GetLocation.MakeScope.GetVariable('sul_spec_type').GetValue), '(float)3.0')]"
}

template sul_vis_lv_woodland {
	visible = "[EqualTo_float(FixedPointToFloat(LocationView.GetLocation.MakeScope.GetVariable('sul_spec_type').GetValue), '(float)4.0')]"
}

template sul_vis_lv_leather {
	visible = "[Or(EqualTo_float(FixedPointToFloat(LocationView.GetLocation.MakeScope.GetVariable('sul_spec_type').GetValue), '(float)2.0'), EqualTo_float(FixedPointToFloat(LocationView.GetLocation.MakeScope.GetVariable('sul_spec_type').GetValue), '(float)4.0'))]"
}

# =====================================================
# VISIBILITY TEMPLATES - Rank-Level (any specialization of rank)
# =====================================================
# Location context

template sul_vis_loc_any_city {
	visible = "[And(Location.MakeScope.GetVariable('sul_designation').IsSet, And(GreaterThanOrEqualTo_int32(FixedPointToInt(Location.MakeScope.GetVariable('sul_designation').GetValue), '(int32)11'), LessThanOrEqualTo_int32(FixedPointToInt(Location.MakeScope.GetVariable('sul_designation').GetValue), '(int32)15')))]"
}

template sul_vis_loc_any_town {
	visible = "[And(Location.MakeScope.GetVariable('sul_designation').IsSet, And(GreaterThanOrEqualTo_int32(FixedPointToInt(Location.MakeScope.GetVariable('sul_designation').GetValue), '(int32)1'), LessThanOrEqualTo_int32(FixedPointToInt(Location.MakeScope.GetVariable('sul_designation').GetValue), '(int32)5')))]"
}

template sul_vis_loc_any_rural {
	visible = "[And(Location.MakeScope.GetVariable('sul_designation').IsSet, And(GreaterThanOrEqualTo_int32(FixedPointToInt(Location.MakeScope.GetVariable('sul_designation').GetValue), '(int32)21'), LessThanOrEqualTo_int32(FixedPointToInt(Location.MakeScope.GetVariable('sul_designation').GetValue), '(int32)25')))]"
}

# MarketMarker context

template sul_vis_market_any_city {
	visible = "[And(MarketMarker.GetLocation.MakeScope.GetVariable('sul_designation').IsSet, And(GreaterThanOrEqualTo_int32(FixedPointToInt(MarketMarker.GetLocation.MakeScope.GetVariable('sul_designation').GetValue), '(int32)11'), LessThanOrEqualTo_int32(FixedPointToInt(MarketMarker.GetLocation.MakeScope.GetVariable('sul_designation').GetValue), '(int32)15')))]"
}

template sul_vis_market_any_town {
	visible = "[And(MarketMarker.GetLocation.MakeScope.GetVariable('sul_designation').IsSet, And(GreaterThanOrEqualTo_int32(FixedPointToInt(MarketMarker.GetLocation.MakeScope.GetVariable('sul_designation').GetValue), '(int32)1'), LessThanOrEqualTo_int32(FixedPointToInt(MarketMarker.GetLocation.MakeScope.GetVariable('sul_designation').GetValue), '(int32)5')))]"
}

template sul_vis_market_any_rural {
	visible = "[And(MarketMarker.GetLocation.MakeScope.GetVariable('sul_designation').IsSet, And(GreaterThanOrEqualTo_int32(FixedPointToInt(MarketMarker.GetLocation.MakeScope.GetVariable('sul_designation').GetValue), '(int32)21'), LessThanOrEqualTo_int32(FixedPointToInt(MarketMarker.GetLocation.MakeScope.GetVariable('sul_designation').GetValue), '(int32)25')))]"
}

# CityMarker context

template sul_vis_citymarker_any_city {
	visible = "[And(CityMarker.GetLocation.MakeScope.GetVariable('sul_designation').IsSet, And(GreaterThanOrEqualTo_int32(FixedPointToInt(CityMarker.GetLocation.MakeScope.GetVariable('sul_designation').GetValue), '(int32)11'), LessThanOrEqualTo_int32(FixedPointToInt(CityMarker.GetLocation.MakeScope.GetVariable('sul_designation').GetValue), '(int32)15')))]"
}

template sul_vis_citymarker_any_town {
	visible = "[And(CityMarker.GetLocation.MakeScope.GetVariable('sul_designation').IsSet, And(GreaterThanOrEqualTo_int32(FixedPointToInt(CityMarker.GetLocation.MakeScope.GetVariable('sul_designation').GetValue), '(int32)1'), LessThanOrEqualTo_int32(FixedPointToInt(CityMarker.GetLocation.MakeScope.GetVariable('sul_designation').GetValue), '(int32)5')))]"
}

template sul_vis_citymarker_any_rural {
	visible = "[And(CityMarker.GetLocation.MakeScope.GetVariable('sul_designation').IsSet, And(GreaterThanOrEqualTo_int32(FixedPointToInt(CityMarker.GetLocation.MakeScope.GetVariable('sul_designation').GetValue), '(int32)21'), LessThanOrEqualTo_int32(FixedPointToInt(CityMarker.GetLocation.MakeScope.GetVariable('sul_designation').GetValue), '(int32)25')))]"
}

template sul_vis_citymarker_not_specialized {
	visible = "[Not(CityMarker.GetLocation.MakeScope.GetVariable('sul_spec_type').IsSet)]"
}

# =====================================================
# TOOLTIP VALUE CELL TEMPLATES
# =====================================================
# Reusable widgets for tooltip table cells
# Usage: using = sul_value_cell blockoverride "val" { raw_text = "..." }

template sul_value_cell {
	size = {
		50
		20
	}

	text_single = {
		parentanchor = right|vcenter
		block "val" {  }
	}
}

template sul_value_cell_wide {
	size = {
		60
		20
	}

	text_single = {
		parentanchor = right|vcenter
		block "val" {  }
		block "tip" {  }
	}
}

# Modifier display cells - simple GetModifierValue accessors

template sul_food_modifier_cell {
	size = {
		60
		20
	}

	text_single = {
		parentanchor = right|vcenter
		raw_text = "[LocationView.GetLocation.GetModifierValue('local_monthly_food_modifier')]"
	}
}

template sul_raw_modifier_cell {
	size = {
		60
		20
	}

	text_single = {
		parentanchor = right|vcenter
		raw_text = "[LocationView.GetLocation.GetModifierValue('local_raw_material_output')]"
	}
}

template sul_rgo_modifier_cell {
	size = {
		60
		20
	}

	text_single = {
		parentanchor = right|vcenter
		raw_text = "[LocationView.GetLocation.GetModifierValue('local_max_rgo_size_modifier')]"
	}
}

template sul_efficiency_modifier_cell {
	size = {
		60
		20
	}

	text_single = {
		parentanchor = right|vcenter
		raw_text = "[LocationView.GetLocation.GetModifierValue('local_production_efficiency')]"
	}
}

# Complete food consumption tooltip block (all pop types)

template sul_food_consumption_block {
	TooltipTableHeader = {
		blockoverride "tableheader_text" { text = "SUL_FOOD_CONSUMPTION_HEADER" }
	}

	TooltipListRowContent = {
		vbox = {
			layoutpolicy_horizontal = expanding

			TooltipManualTableField = {
				visible = "[NotEqualTo_CFixedPoint(LocationView.GetLocation.GetModifierValueFixed('local_pop_food_consumption'), '(CFixedPoint)0')]"

				blockoverride "field_content" {
					hbox = {
						spacing = 5

						icon = {
							size = { 28 28 }
							texture = "gfx/interface/icons/modifier_types/global_pop_food_consumption.dds"
						}

						text_single = {
							text = "MODIFIER_TYPE_NAME_local_pop_food_consumption"

							tooltipwidget = {
								ContextualTooltipType = {
									blockoverride "title_text" { text = "MODIFIER_TYPE_NAME_local_pop_food_consumption" }
									blockoverride "title_icon" {
										icon = {
											using = tooltip_title_icon_size
											texture = "gfx/interface/icons/modifier_types/global_pop_food_consumption.dds"
										}
									}
									blockoverride "tooltip_content" {
										TooltipTextBlock = {
											blockoverride "text" { text = "MODIFIER_TYPE_DESC_local_pop_food_consumption" }
										}
									}
								}
							}
						}
					}

					expand = {  }

					widget = {
						size = { 50 20 }

						text_single = {
							parentanchor = right|vcenter
							raw_text = "[LocationView.GetLocation.GetModifierValue('local_pop_food_consumption')|%+0]"
						}
					}
				}
			}
			TooltipManualTableField = {
				visible = "[NotEqualTo_CFixedPoint(LocationView.GetLocation.GetModifierValueFixed('local_nobles_food_consumption'), '(CFixedPoint)0')]"

				blockoverride "field_content" {
					hbox = {
						spacing = 5

						icon = {
							size = { 28 28 }
							texture = "gfx/interface/icons/modifier_types/global_nobles_food_consumption.dds"
						}

						text_single = {
							text = "MODIFIER_TYPE_NAME_local_nobles_food_consumption"

							tooltipwidget = {
								ContextualTooltipType = {
									blockoverride "title_text" { text = "MODIFIER_TYPE_NAME_local_nobles_food_consumption" }
									blockoverride "title_icon" {
										icon = {
