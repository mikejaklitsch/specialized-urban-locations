template sul_demand_formula_tooltip {
	ContextualTooltipType = {
		blockoverride "title_icon" {
			icon = {
				using = tooltip_title_icon_size
				texture = "gfx/interface/icons/flat_icons/tabicons/economy.dds"
			}
		}
		blockoverride "title_text" { text = "SUL_DEMAND_FORMULA_TITLE" }
		blockoverride "tooltip_content" {
			# Formula explanation
			TooltipTextBlock = { blockoverride "text" { text = "SUL_DEMAND_FORMULA_DESC" } }
			# Class scaling table
			TooltipListBase = {
				vbox = {
					layoutpolicy_horizontal = expanding
					margin = { 10 6 }

					text_single = {
						layoutpolicy_horizontal = expanding
						text = "SUL_DEMAND_FORMULA_MAXIMUMS_HEADER"
						default_format = "#T"
					}

					# Header row
					hbox = {
						layoutpolicy_horizontal = expanding
						margin_top = 4
						text_single = { min_width = 80 raw_text = "#T Pop Type#!" }
						text_single = { min_width = 90 raw_text = "#T Floor → Ceil#!" }
						text_single = { min_width = 30 raw_text = "#T k#!" }
					}
					hbox = {
						layoutpolicy_horizontal = expanding
						margin_top = 2
						text_single = { min_width = 80 raw_text = "Nobles" }
						text_single = { min_width = 90 raw_text = "#G 0.8x → 5.0x#!" }
						text_single = { min_width = 30 raw_text = "200" }
					}
					hbox = {
						layoutpolicy_horizontal = expanding
						margin_top = 2
						text_single = { min_width = 80 raw_text = "Clergy" }
						text_single = { min_width = 90 raw_text = "#G 0.8x → 4.0x#!" }
						text_single = { min_width = 30 raw_text = "150" }
					}
					hbox = {
						layoutpolicy_horizontal = expanding
						margin_top = 2
						text_single = { min_width = 80 raw_text = "Burghers" }
						text_single = { min_width = 90 raw_text = "#G 0.8x → 3.5x#!" }
						text_single = { min_width = 30 raw_text = "150" }
					}
					hbox = {
						layoutpolicy_horizontal = expanding
						margin_top = 2
						text_single = { min_width = 80 raw_text = "Soldiers" }
						text_single = { min_width = 90 raw_text = "#G 0.8x → 2.5x#!" }
						text_single = { min_width = 30 raw_text = "100" }
					}
					hbox = {
						layoutpolicy_horizontal = expanding
						margin_top = 2
						text_single = { min_width = 80 raw_text = "Laborers" }
						text_single = { min_width = 90 raw_text = "#G 0.8x → 2.5x#!" }
						text_single = { min_width = 30 raw_text = "100" }
					}
					hbox = {
						layoutpolicy_horizontal = expanding
						margin_top = 2
						text_single = { min_width = 80 raw_text = "Peasants" }
						text_single = { min_width = 90 raw_text = "#G 0.8x → 2.5x#!" }
						text_single = { min_width = 30 raw_text = "100" }
					}
					hbox = {
						layoutpolicy_horizontal = expanding
						margin_top = 2
						text_single = { min_width = 80 raw_text = "Tribesmen" }
						text_single = { min_width = 90 raw_text = "#G 0.8x → 2.0x#!" }
						text_single = { min_width = 30 raw_text = "75" }
					}
					hbox = {
						layoutpolicy_horizontal = expanding
						margin_top = 2
						text_single = { min_width = 80 raw_text = "Slaves" }
						text_single = { min_width = 90 raw_text = "#G 0.8x#!" }
						text_single = { min_width = 30 raw_text = "-" }
					}
				}
			}
		}
	}
}

# =====================================================
# TYPES (must load before map_markers_city.gui)
# =====================================================

types sul_shared_types
{
	# location_rank_icon - ZOOMED IN map view
	# Used by city_marker detail view (map_markers_city.gui)
	# Sizes must match marker_rank_icon (ZOOMED OUT) to prevent snap on zoom transition
	type location_rank_icon = widget {
		block "icon_size" {
			size = { @city_marker_icon_size @city_marker_icon_size }
		}

		# CITY
		icon = {
			parentanchor = center
			using = sul_vis_loc_any_city
			using = sul_icon_size_city
			using = sul_concept_texture_loc
		}

		# TOWN
		icon = {
			parentanchor = center
			using = sul_vis_loc_any_town
			using = sul_icon_size_town
			using = sul_concept_texture_loc
		}

		# RURAL
		icon = {
			parentanchor = center
			using = sul_vis_loc_any_rural
			using = sul_icon_size_rural
			using = sul_concept_texture_loc
		}

		# FALLBACK - non-specialized
		icon = {
			parentanchor = center
			using = sul_vis_loc_not_specialized
			texture = "[Location.GetRankIcon]"

			block "icon_size" {
				size = { @city_marker_icon_size @city_marker_icon_size }
			}
		}

		onmousehierarchyenter = "[PdxGuiWidget.SetHighlightProvince(Location.GetProvince)]"
		tooltipwidget = { using = location_rank_tooltip }
	}
}

# Override vanilla LocationBuildingLevels_tooltip to add building_level concept link

template LocationBuildingLevels_tooltip {
	ContextualTooltipType = {
		blockoverride "title_icon" {
			icon = {
				using = tooltip_title_icon_size
				texture = "[GetConceptTexture('supported_building_levels')]"
			}
		}

		blockoverride "title_text" { datacontext = "[Location]" text = "BUILDING_LEVELS_LABEL" }

		blockoverride "concept_link" { text = "[sul_building_level|E]" }

		blockoverride "tooltip_content" {
			TooltipStringPairList = {
				datacontext = "[Location]"
				textcontext = "LOCATION_CURR_LEVELS"

				tooltipwidget = {
					SimpleContextualStringPairTooltipType = {
						blockoverride "title_icon" {
							icon = {
								using = tooltip_title_icon_size
								texture = "gfx/interface/icons/outliner/categories/buildings.dds"
							}
						}

						blockoverride "concept_link" { text = "[buildings|e]" }

						lowpriotextcontext = "[Location.GetBuildingLevelInfo]"
					}
				}
			}

			TooltipListBase = {
				blockoverride "block_title" { text = "SUL_BUILDING_LEVEL_EFFECTS_LABEL" }

				TooltipListRowContent = {
					TooltipManualTableField = {
						blockoverride "field_content" {
							hbox = {
								spacing = 5

								icon = {
									size = { 28 28 }
									texture = "gfx/interface/icons/modifier_types/global_monthly_food_modifier.dds"
								}

								text_single = { text = "MODIFIER_TYPE_NAME_local_monthly_food_modifier" }
							}

							expand = {  }

							widget = {
								size = { 50 20 }

								text_single = {
									parentanchor = right|vcenter
									raw_text = "[Multiply_CFixedPoint(LocationView.GetLocation.GetNumBuildingLevelsWithEmployment, '(CFixedPoint)-0.02')|%+2]"
								}
							}
						}
					}

					TooltipManualTableField = {
						blockoverride "field_content" {
							hbox = {
								spacing = 5

								icon = {
									size = { 28 28 }
									texture = "gfx/interface/icons/modifier_types/global_raw_material_output.dds"
								}

								text_single = { text = "MODIFIER_TYPE_NAME_local_raw_material_output" }
							}

							expand = {  }

							widget = {
								size = { 50 20 }

								text_single = {
									parentanchor = right|vcenter
									raw_text = "[Multiply_CFixedPoint(LocationView.GetLocation.GetNumBuildingLevelsWithEmployment, '(CFixedPoint)-0.005')|%+2]"
								}
							}
						}
					}

					TooltipManualTableField = {
						blockoverride "field_content" {
							hbox = {
								spacing = 5

								icon = {
									size = { 28 28 }
									texture = "gfx/interface/icons/modifier_types/global_production_efficiency.dds"
								}

								text_single = { text = "SUL_FINISHED_GOODS_OUTPUT" }
							}

							expand = {  }

							widget = {
								size = { 50 20 }

								text_single = {
									parentanchor = right|vcenter
									raw_text = "[Multiply_CFixedPoint(LocationView.GetLocation.GetNumBuildingLevelsWithEmployment, '(CFixedPoint)-0.005')|%+2]"
								}
							}
						}
					}
				}
			}

			TooltipStringPairList = {
				blockoverride "block_title" {
					datacontext = "[Location]"
					text = "SUL_SUPPORTED_BUILDING_LEVELS_LABEL"
				}

				textcontext = "[Location.GetDescriptionFor('free_building_levels')]"
			}

			TooltipStringPairList = {
				visible = "[Location.HasTooManyBuildingLevel]"
				datacontext = "[Location]"

				blockoverride "block_title" { text = "LOCATION_TOO_MANY_BUILD_LEVELS_LABEL" }

				textcontext = "[Location.GetTooManyBuildingInfo]"
			}
		}
	}
}
