# =====================================================
# MODIFIER HIDING TEMPLATE
# =====================================================
# Template to hide specialization modifiers from timed modifier lists
# Uses both visibility AND size to ensure proper collapse in scrollable lists

template sul_hide_if_specialization_modifier {
	visible = "[Not(Or3(
		Or5(
			EqualTo_string(TimedModifier.GetModifier.GetName, Localize('STATIC_MODIFIER_NAME_sul_mining_town_specialization')),
			EqualTo_string(TimedModifier.GetModifier.GetName, Localize('STATIC_MODIFIER_NAME_sul_farming_town_specialization')),
			EqualTo_string(TimedModifier.GetModifier.GetName, Localize('STATIC_MODIFIER_NAME_sul_gathering_town_specialization')),
			EqualTo_string(TimedModifier.GetModifier.GetName, Localize('STATIC_MODIFIER_NAME_sul_woodland_town_specialization')),
			EqualTo_string(TimedModifier.GetModifier.GetName, Localize('STATIC_MODIFIER_NAME_sul_commercial_town_specialization'))
		),
		Or5(
			EqualTo_string(TimedModifier.GetModifier.GetName, Localize('STATIC_MODIFIER_NAME_sul_mining_city_specialization')),
			EqualTo_string(TimedModifier.GetModifier.GetName, Localize('STATIC_MODIFIER_NAME_sul_farming_city_specialization')),
			EqualTo_string(TimedModifier.GetModifier.GetName, Localize('STATIC_MODIFIER_NAME_sul_gathering_city_specialization')),
			EqualTo_string(TimedModifier.GetModifier.GetName, Localize('STATIC_MODIFIER_NAME_sul_woodland_city_specialization')),
			EqualTo_string(TimedModifier.GetModifier.GetName, Localize('STATIC_MODIFIER_NAME_sul_commercial_city_specialization'))
		),
		Or5(
			EqualTo_string(TimedModifier.GetModifier.GetName, Localize('STATIC_MODIFIER_NAME_sul_mining_rural_specialization')),
			EqualTo_string(TimedModifier.GetModifier.GetName, Localize('STATIC_MODIFIER_NAME_sul_farming_rural_specialization')),
			EqualTo_string(TimedModifier.GetModifier.GetName, Localize('STATIC_MODIFIER_NAME_sul_gathering_rural_specialization')),
			EqualTo_string(TimedModifier.GetModifier.GetName, Localize('STATIC_MODIFIER_NAME_sul_woodland_rural_specialization')),
			EqualTo_string(TimedModifier.GetModifier.GetName, Localize('STATIC_MODIFIER_NAME_sul_commercial_rural_specialization'))
		)
	))]"
}

# Template to completely collapse specialization modifier rows in tooltip lists (40px height)
# Uses size = 0 for specialization modifiers to prevent blank space

template sul_collapse_if_specialization_modifier {
	size = "[Select_CVector2f(Not(Or3(
		Or5(
			EqualTo_string(TimedModifier.GetModifier.GetName, Localize('STATIC_MODIFIER_NAME_sul_mining_town_specialization')),
			EqualTo_string(TimedModifier.GetModifier.GetName, Localize('STATIC_MODIFIER_NAME_sul_farming_town_specialization')),
			EqualTo_string(TimedModifier.GetModifier.GetName, Localize('STATIC_MODIFIER_NAME_sul_gathering_town_specialization')),
			EqualTo_string(TimedModifier.GetModifier.GetName, Localize('STATIC_MODIFIER_NAME_sul_woodland_town_specialization')),
			EqualTo_string(TimedModifier.GetModifier.GetName, Localize('STATIC_MODIFIER_NAME_sul_commercial_town_specialization'))
		),
		Or5(
			EqualTo_string(TimedModifier.GetModifier.GetName, Localize('STATIC_MODIFIER_NAME_sul_mining_city_specialization')),
			EqualTo_string(TimedModifier.GetModifier.GetName, Localize('STATIC_MODIFIER_NAME_sul_farming_city_specialization')),
			EqualTo_string(TimedModifier.GetModifier.GetName, Localize('STATIC_MODIFIER_NAME_sul_gathering_city_specialization')),
			EqualTo_string(TimedModifier.GetModifier.GetName, Localize('STATIC_MODIFIER_NAME_sul_woodland_city_specialization')),
			EqualTo_string(TimedModifier.GetModifier.GetName, Localize('STATIC_MODIFIER_NAME_sul_commercial_city_specialization'))
		),
		Or5(
			EqualTo_string(TimedModifier.GetModifier.GetName, Localize('STATIC_MODIFIER_NAME_sul_mining_rural_specialization')),
			EqualTo_string(TimedModifier.GetModifier.GetName, Localize('STATIC_MODIFIER_NAME_sul_farming_rural_specialization')),
			EqualTo_string(TimedModifier.GetModifier.GetName, Localize('STATIC_MODIFIER_NAME_sul_gathering_rural_specialization')),
			EqualTo_string(TimedModifier.GetModifier.GetName, Localize('STATIC_MODIFIER_NAME_sul_woodland_rural_specialization')),
			EqualTo_string(TimedModifier.GetModifier.GetName, Localize('STATIC_MODIFIER_NAME_sul_commercial_rural_specialization'))
		)
	)), '(CVector2f)300,40', '(CVector2f)0,0')]"
}

# Template for small icon collapse (26x26 for modifier icons in flowcontainer)

template sul_collapse_if_specialization_modifier_small {
	size = "[Select_CVector2f(Not(Or3(
		Or5(
			EqualTo_string(TimedModifier.GetModifier.GetName, Localize('STATIC_MODIFIER_NAME_sul_mining_town_specialization')),
			EqualTo_string(TimedModifier.GetModifier.GetName, Localize('STATIC_MODIFIER_NAME_sul_farming_town_specialization')),
			EqualTo_string(TimedModifier.GetModifier.GetName, Localize('STATIC_MODIFIER_NAME_sul_gathering_town_specialization')),
			EqualTo_string(TimedModifier.GetModifier.GetName, Localize('STATIC_MODIFIER_NAME_sul_woodland_town_specialization')),
			EqualTo_string(TimedModifier.GetModifier.GetName, Localize('STATIC_MODIFIER_NAME_sul_commercial_town_specialization'))
		),
		Or5(
			EqualTo_string(TimedModifier.GetModifier.GetName, Localize('STATIC_MODIFIER_NAME_sul_mining_city_specialization')),
			EqualTo_string(TimedModifier.GetModifier.GetName, Localize('STATIC_MODIFIER_NAME_sul_farming_city_specialization')),
			EqualTo_string(TimedModifier.GetModifier.GetName, Localize('STATIC_MODIFIER_NAME_sul_gathering_city_specialization')),
			EqualTo_string(TimedModifier.GetModifier.GetName, Localize('STATIC_MODIFIER_NAME_sul_woodland_city_specialization')),
			EqualTo_string(TimedModifier.GetModifier.GetName, Localize('STATIC_MODIFIER_NAME_sul_commercial_city_specialization'))
		),
		Or5(
			EqualTo_string(TimedModifier.GetModifier.GetName, Localize('STATIC_MODIFIER_NAME_sul_mining_rural_specialization')),
			EqualTo_string(TimedModifier.GetModifier.GetName, Localize('STATIC_MODIFIER_NAME_sul_farming_rural_specialization')),
			EqualTo_string(TimedModifier.GetModifier.GetName, Localize('STATIC_MODIFIER_NAME_sul_gathering_rural_specialization')),
			EqualTo_string(TimedModifier.GetModifier.GetName, Localize('STATIC_MODIFIER_NAME_sul_woodland_rural_specialization')),
			EqualTo_string(TimedModifier.GetModifier.GetName, Localize('STATIC_MODIFIER_NAME_sul_commercial_rural_specialization'))
		)
	)), '(CVector2f)26,26', '(CVector2f)0,0')]"
}

# =====================================================
# GDP TOOLTIP TEMPLATE (Location scope)
# =====================================================
# Rich tooltip showing Local GDP value and demand multipliers
# Each multiplier row has a hover tooltip explaining the formula

template sul_local_gdp_tooltip {
	ContextualTooltipType = {
		blockoverride "title_icon" {
			icon = {
				using = tooltip_title_icon_size
				texture = "gfx/interface/icons/location_icons/tax_base.dds"
			}
		}
		blockoverride "title_text" { text = "SUL_LOCAL_GDP_TITLE" }
		blockoverride "tooltip_content" {
			# Description
			TooltipTextBlock = { blockoverride "text" { text = "SUL_LOCAL_GDP_DESC" } }
			# GDP Value Section
			TooltipListBase = {
				hbox = {
					layoutpolicy_horizontal = expanding
					margin = { 10 6 }

					text_single = {
						layoutpolicy_horizontal = expanding
						text = "SUL_LOCAL_GDP_TITLE"
					}

					icon = {
						size = { 20 20 }
						texture = "gfx/interface/icons/location_icons/tax_base.dds"
					}

					text_single = {
						margin_left = 3
						raw_text = "#Y [Location.MakeScope.GetVariable('sul_local_gdp').GetValue|1]#!"
					}
				}
			}

			# Demand Multipliers Section
			TooltipListBase = {
				TooltipTableHeader = {
					blockoverride "tableheader_text" { text = "SUL_DEMAND_MULTIPLIERS_HEADER" }
				}

				TooltipListRowContent = {
					# Column header row
					TooltipManualTableField = {
						blockoverride "field_content" {
							text_single = {
								layoutpolicy_horizontal = expanding
								margin_left = 5
								raw_text = "#T Pop Type#!"
							}
							text_single = { min_width = 130 raw_text = "#T GDP Share#!" }
							text_single = { min_width = 50 raw_text = "#T Mult#!" }
						}
					}

					# Nobles row
					TooltipManualTableField = {
						tooltipwidget = { using = sul_demand_formula_tooltip }

						blockoverride "field_content" {
							icon = {
								size = { 20 20 }
								texture = "[GetGraphicalCultureTextureForPopType(GetPopTypeByName('nobles'))]"
							}

							text_single = {
								layoutpolicy_horizontal = expanding
								margin_left = 5
								text = "SUL_NOBLES_LABEL"
								datacontext = "[GetPopTypeByName('nobles')]"
								tooltipwidget = { using = sul_pop_type_needs_tooltip }
							}
							text_single = {
								min_width = 130
								raw_text = "[Multiply_CFixedPoint(Location.MakeScope.GetVariable('sul_local_gdp').GetValue, Location.MakeScope.GetVariable('sul_adjusted_noble_share').GetValue)|1]@gold! ([Location.MakeScope.GetVariable('sul_adjusted_noble_share').GetValue|%0]@tax_base!)"
							}
							text_single = {
								min_width = 50
								raw_text = "[Location.MakeScope.GetVariableFromVariableMap('sul_gdp_pc', GetPopTypeByName('nobles').MakeScope).GetValue|2]x"
							}
						}
					}

					# Clergy row
					TooltipManualTableField = {
						tooltipwidget = { using = sul_demand_formula_tooltip }

						blockoverride "field_content" {
							icon = {
								size = { 20 20 }
								texture = "[GetGraphicalCultureTextureForPopType(GetPopTypeByName('clergy'))]"
							}

							text_single = {
