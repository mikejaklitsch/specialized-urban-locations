template eul_vis_marker_farming_town_regular { visible = "[And3(EqualTo_float(FixedPointToFloat(CityMarker.GetLocation.MakeScope.GetVariable('specialization_designation').GetValue), '(float)2.0'), Not(CityMarker.GetLocation.IsProvinceCapital), Not(CityMarker.GetLocation.IsCapital))]" }
