template eul_vis_loc_farming_town_regular { visible = "[And4(Location.MakeScope.GetVariable('specialization_designation').IsSet, EqualTo_float(FixedPointToFloat(Location.MakeScope.GetVariable('specialization_designation').GetValue), '(float)2.0'), Not(Location.IsProvinceCapital), Not(Location.IsCapital))]" }
