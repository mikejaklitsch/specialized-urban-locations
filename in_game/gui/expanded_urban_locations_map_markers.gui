# Expanded Urban Locations - Custom Map Icons
# Overrides location_rank_icon and marker_rank_icon to show specialization-based icons
# Color mapping: red=mining, green=farming, brown=forestry, blue=gathering, purple=commercial
#
# VALUE MAPPING (see script_values/expanded_urban_locations_specialization_constants.txt):
#   Towns: 1=mining, 2=farming, 3=gathering, 4=forestry, 5=commercial
#   Cities: 11=mining, 12=farming, 13=gathering, 14=forestry, 15=commercial

@town_marker_icon_size = 25
@city_marker_icon_size = 25

# Specialization designation values - REFERENCE ONLY
# These cannot be used in '(float)...' casts - @variables are not expanded inside string literals.
# Hardcoded float values must be used in visibility templates.
# Towns: mining=1.0, farming=2.0, gathering=3.0, forestry=4.0, commercial=5.0
# Cities: mining=11.0, farming=12.0, gathering=13.0, forestry=14.0, commercial=15.0

# =====================================================
# SECTION 1: REUSABLE TEXTURE TEMPLATES
# =====================================================
# Mining (red)
template eul_tex_red_capital_town { texture = "gfx/interface/mapitems/red_capital_town.dds" }
template eul_tex_red_province_capital_town { texture = "gfx/interface/mapitems/red_provincial_capital_town.dds" }
template eul_tex_red_town { texture = "gfx/interface/mapitems/red_town.dds" }
template eul_tex_red_capital_city { texture = "gfx/interface/mapitems/red_capital_city.dds" }
template eul_tex_red_province_capital_city { texture = "gfx/interface/mapitems/red_provincial_capital_city.dds" }
template eul_tex_red_city { texture = "gfx/interface/mapitems/red_city.dds" }

# Gathering (blue)
template eul_tex_blue_capital_town { texture = "gfx/interface/mapitems/blue_capital_town.dds" }
template eul_tex_blue_province_capital_town { texture = "gfx/interface/mapitems/blue_provincial_capital_town.dds" }
template eul_tex_blue_town { texture = "gfx/interface/mapitems/blue_town.dds" }
template eul_tex_blue_capital_city { texture = "gfx/interface/mapitems/blue_capital_city.dds" }
template eul_tex_blue_province_capital_city { texture = "gfx/interface/mapitems/blue_provincial_capital_city.dds" }
template eul_tex_blue_city { texture = "gfx/interface/mapitems/blue_city.dds" }

# Forestry (brown)
template eul_tex_brown_capital_town { texture = "gfx/interface/mapitems/brown_capital_town.dds" }
template eul_tex_brown_province_capital_town { texture = "gfx/interface/mapitems/brown_provincial_capital_town.dds" }
template eul_tex_brown_town { texture = "gfx/interface/mapitems/brown_town.dds" }
template eul_tex_brown_capital_city { texture = "gfx/interface/mapitems/brown_capital_city.dds" }
template eul_tex_brown_province_capital_city { texture = "gfx/interface/mapitems/brown_provincial_capital_city.dds" }
template eul_tex_brown_city { texture = "gfx/interface/mapitems/brown_city.dds" }

# Farming (green)
template eul_tex_green_capital_town { texture = "gfx/interface/mapitems/green_capital_town.dds" }
template eul_tex_green_province_capital_town { texture = "gfx/interface/mapitems/green_provincial_capital_town.dds" }
template eul_tex_green_town { texture = "gfx/interface/mapitems/green_town.dds" }
template eul_tex_green_capital_city { texture = "gfx/interface/mapitems/green_capital_city.dds" }
template eul_tex_green_province_capital_city { texture = "gfx/interface/mapitems/green_provincial_capital_city.dds" }
template eul_tex_green_city { texture = "gfx/interface/mapitems/green_city.dds" }

# Commercial (purple)
template eul_tex_purple_capital_town { texture = "gfx/interface/mapitems/purple_capital_town.dds" }
template eul_tex_purple_province_capital_town { texture = "gfx/interface/mapitems/purple_provincial_capital_town.dds" }
template eul_tex_purple_town { texture = "gfx/interface/mapitems/purple_town.dds" }
template eul_tex_purple_capital_city { texture = "gfx/interface/mapitems/purple_capital_city.dds" }
template eul_tex_purple_province_capital_city { texture = "gfx/interface/mapitems/purple_provincial_capital_city.dds" }
template eul_tex_purple_city { texture = "gfx/interface/mapitems/purple_city.dds" }

# =====================================================
# SECTION 2: VISIBILITY TEMPLATES - Location Context (with IsSet check)
# =====================================================
# Mining Town (1)
template eul_vis_loc_mining_town_capital { visible = "[And3(Location.MakeScope.GetVariable('specialization_designation').IsSet, EqualTo_float(FixedPointToFloat(Location.MakeScope.GetVariable('specialization_designation').GetValue), '(float)1.0'), Location.IsCapital)]" }
template eul_vis_loc_mining_town_prov_capital { visible = "[And4(Location.MakeScope.GetVariable('specialization_designation').IsSet, EqualTo_float(FixedPointToFloat(Location.MakeScope.GetVariable('specialization_designation').GetValue), '(float)1.0'), Location.IsProvinceCapital, Not(Location.IsCapital))]" }
template eul_vis_loc_mining_town_regular { visible = "[And4(Location.MakeScope.GetVariable('specialization_designation').IsSet, EqualTo_float(FixedPointToFloat(Location.MakeScope.GetVariable('specialization_designation').GetValue), '(float)1.0'), Not(Location.IsProvinceCapital), Not(Location.IsCapital))]" }
# Mining City (11)
template eul_vis_loc_mining_city_capital { visible = "[And3(Location.MakeScope.GetVariable('specialization_designation').IsSet, EqualTo_float(FixedPointToFloat(Location.MakeScope.GetVariable('specialization_designation').GetValue), '(float)11.0'), Location.IsCapital)]" }
