# =====================================================
# SECTION 6: TOOLTIP TEMPLATE OVERRIDES
# =====================================================

# Override location_rank_tooltip template to show specialization icons in tooltips
template location_rank_tooltip {
	ContextualTooltipType = {
		blockoverride "title_icon" {
			widget = {
				using = tooltip_title_icon_size
				using = eul_tooltip_specialization_icons
			}
		}

		blockoverride "title_text" {
			using = eul_text_specialized_name_loc
		}

		blockoverride "concept_link" {
			text = "[location_rank|e]"
		}

		blockoverride "title_button" {
			mapmode_tooltip_button = {
				datacontext = "[GetMapMode('cities')]"
			}
			mapmode_tooltip_button = {
				datacontext = "[GetMapMode('provinces')]"
			}
		}

		blockoverride "tooltip_content" {
			TooltipTextBlock = {
				visible = "[Location.IsCapital]"
				blockoverride "text" {
					text = "SIMPLE_PROVINCE_ICON_COUNTRY_CAPITAL_TOOLTIP"
				}
			}
			TooltipTextBlock = {
				visible = "[And(Location.IsProvinceCapital, Not(Location.IsCapital))]"
				blockoverride "text" {
					text = "SIMPLE_PROVINCE_ICON_STATE_CAPITAL_TOOLTIP"
				}
			}
			TooltipTextBlock = {
				blockoverride "text" {
					text = "LOCATIONRANK_TOOLTIP"
				}
			}

			TooltipFlavorTextBlock = {
				blockoverride "text" {
					text = "[Location.GetRank.GetDescription]"
				}
			}

			block "location_rank_tooltip_button" {}
		}
	}
}

# Override location_simple_tooltip template - shown when hovering on location markers
template location_simple_tooltip {
	ContextualTooltipType = {
		blockoverride "title_icon" {
			widget = {
				using = tooltip_title_icon_size
				using = eul_tooltip_specialization_icons
				tooltipwidget = {
					using = location_rank_tooltip
				}
			}
		}

		blockoverride "title_button" {
			mapmode_tooltip_button = {
				datacontext = "[GetMapMode('locations')]"
			}
		}

		blockoverride "title_text" {
			using = eul_text_specialized_name_loc
		}

		blockoverride "concept_link" {
			text = [location|E]
		}

		blockoverride "tooltip_content" {
			location_geography_bar = {}
			location_details = {}

			hbox = {
				visible = "[Location.HasSpecificBaseModifier]"
				layoutpolicy_horizontal = expanding
				using = bg_text_mask_container_turquoise
				margin = { 10 6 }
				spacing = 7
				tooltipwidget = {
					ContextualTooltipType = {
						blockoverride "title_icon" {
							icon = {
								using = tooltip_title_icon_size
								texture = "[Location.GetSpecificBaseModifier.GetModifier.GetIcon]"
							}
						}

						blockoverride "title_text" {
							text = "[Location.GetSpecificBaseModifier.GetName]"
						}
						blockoverride "concept_link" {
							text = "[location_modifier|e]"
						}

						blockoverride "tooltip_content" {
							TooltipStringPairList = {
								textcontext = "[Location.GetSpecificBaseModifier.GetDesc]"
							}

							TooltipFlavorTextBlock = {
								visible = "[Location.HasFlavorText]"
								blockoverride "text" {
									text = "[Location.GetFlavorText]"
								}
							}
						}
					}
				}

				widget = {
					size = { 27 27 }
					tagtooltip_enabled = yes

					icon = {
						size = { 100% 100% }
						texture = "[Location.GetSpecificBaseModifier.GetModifier.GetIcon]"
						texture_density = 2
						alpha = 1
						glow = {
							name = "drop_shadow"
							glow_radius = 3
							color = {0.0 0.0 0.0 1.0}
							alpha = 0.5
						}
					}
				}
				text_multi = {
					layoutpolicy_horizontal = expanding
					size = {-1 25}
					autoresize = no
					align = left|vcenter
					text = "[Location.GetSpecificBaseModifier.GetName|W]"
					fontsize = 15
					using = FontDefaultColor
				}
			}

			TooltipFlavorTextBlock = {
				visible = "[Location.HasFlavorText]"
				blockoverride "text" {
					text = "[Location.GetFlavorText]"
				}
			}
		}
	}
}

# Override location_tooltip_alt template - alternate location tooltip
template location_tooltip_alt {
	ContextualTooltipType = {
		blockoverride "title_icon" {
			widget = {
				visible = "[And(Not(Location.GetArea.IsSea), Not(Location.IsCorridor))]"
				using = tooltip_title_icon_size
				using = eul_tooltip_specialization_icons
				tooltipwidget = {
					using = location_rank_tooltip
				}
			}
			icon = {
				visible = "[Location.GetArea.IsSea]"
				using = tooltip_title_icon_size
				texture = "gfx/interface/icons/flat_icons/geopolitics/exploration_sea.dds"
				tooltipwidget = {
					using = seazone_tooltip
				}
			}
			icon = {
				visible = "[Location.IsCorridor]"
				using = tooltip_title_icon_size
				texture = "gfx/interface/mapitems/desert_connector.dds"
			}
		}

		blockoverride "title_button" {
			mapmode_tooltip_button = {
				datacontext = "[GetMapMode('locations')]"
			}
		}

		blockoverride "title_text" {
			using = eul_text_specialized_name_loc
		}

		blockoverride "concept_link" {
			text = "[Select_CString(Location.GetArea.IsSea, Select_CString(Location.GetTopography.IsDeepOcean, sea_current, seazone), Select_CString(Location.IsCorridor, corridor, location))|e]"
		}

		blockoverride "tooltip_content" {
			TooltipDebugStringPairList = {
				textcontext = "[Location.GetDebugText]"
			}

			hbox = {
				visible = "[Location.ShowMarketForMapModeTooltip]"
				layoutpolicy_horizontal = expanding
				margin = { 10 10 }
				background = {
					using = bg_round_corners
					alpha = 0.3
				}

				icon = {
					size = { 32 32 }
					texture = "gfx/interface/buttons/flats/market.dds"
				}

				text_single = {
					align = left
					text = "[Location.GetMarket.GetNameWithNoTooltip]"
					using = Font_Size_Big
					default_format = "#subtle_name"
				}

				text_single = {
					align = right
					text = "[Location.GetMarketAccessWithTooltip]"
				}
			}

			block "tooltip_location_specific" {
				TooltipListScrollArea = {
					visible = "[Location.HasMapmodeSpecificTooltip]"
					blockoverride "block_scrollarea" {
						maximumsize = { -1 300 }
					}

					blockoverride "scrollarea_content" {
						TooltipTextBlock = {
							set_parent_dimension_to_minimum = height
							layoutpolicy_horizontal = expanding
							textcontext = "[Location.GetMapmodeSpecificTooltip]"
						}
					}
				}
			}

			TooltipContentSection = {
				using = tooltip_location_alt_content
			}
		}
	}
}

# Override offer_peace_location_tooltip template - peace offer map mode tooltip
template offer_peace_location_tooltip {
	ContextualTooltipType = {
		blockoverride "title_icon" {
			widget = {
				visible = "[And(Not(Location.GetArea.IsSea), Not(Location.IsCorridor))]"
				using = tooltip_title_icon_size
				using = eul_tooltip_specialization_icons
				tooltipwidget = {
					using = location_rank_tooltip
				}
			}
			icon = {
				visible = "[Location.GetArea.IsSea]"
				using = tooltip_title_icon_size
				texture = "[Location.GetRankIcon]"
				tooltipwidget = {
					using = seazone_tooltip
				}
			}
			icon = {
				visible = "[Location.IsCorridor]"
				using = tooltip_title_icon_size
				texture = "gfx/interface/mapitems/desert_connector.dds"
			}
		}

		blockoverride "title_button" {
			mapmode_tooltip_button = {
				datacontext = "[GetMapMode('offer_peace')]"
			}
		}

		blockoverride "title_text" {
			text = "MAP_TT_LOCATION_ALT_TITLE"
		}

		blockoverride "concept_link" {
			text = "[Select_CString(Location.GetArea.IsSea, Select_CString(Location.GetTopography.IsDeepOcean, sea_current, seazone), Select_CString(Location.IsCorridor, corridor, location))|e]"
		}

		blockoverride "tooltip_content" {
			TooltipDebugStringPairList = {
				textcontext = "[Location.GetDebugText]"
			}

			block "tooltip_location_specific" {
				TooltipListScrollArea = {
					visible = "[Not(StringIsEmpty(Location.GetMapmodeSpecificTooltip))]"
					blockoverride "block_scrollarea" {
						maximumsize = { -1 300 }
					}

					blockoverride "scrollarea_content" {
						TooltipScrolledConditionList = {
							blockoverride "block_scrollarea" { maximumsize = { -1 400 }}
							ontextcontextchanged = "[SetConditionListWithTitleFromTextContext(PdxGuiWidget.AccessSelf)]"
							set_parent_dimension_to_minimum = height
							layoutpolicy_horizontal = expanding
							textcontext = "[Location.GetMapmodeSpecificTooltip]"
						}
					}
				}
			}

			TooltipContentSection = {
				using = tooltip_location_alt_content
			}
		}
	}
}

# Override CurrentLocationRank_tooltip template - current location rank tooltip
template CurrentLocationRank_tooltip {
	ContextualTooltipType = {
		blockoverride "title_icon" {
			widget = {
				using = tooltip_title_icon_size
				using = eul_tooltip_specialization_icons
			}
		}

		blockoverride "title_text" {
			text = "[LocationRank.GetNameWithNoTooltip]"
		}

		blockoverride "concept_link" {
			text = [location_rank|E]
		}

		blockoverride "tooltip_content" {
			TooltipStringPairList = {
				textcontext = "[LocationRank.GetRankTooltip]"
			}

			TooltipFlavorTextBlock = {
				blockoverride "text" {
					text = "[LocationRank.GetDescription]"
				}
			}
		}
	}
}

# =====================================================
# SECTION 7: MAP MARKER TYPE OVERRIDES
# =====================================================

types map_marker_city {

	# Override marker_rank_icon for zoomed-out map view
	type marker_rank_icon = widget {
		allow_outside = yes
		block "marker_rank_icon_size" {
			size = { 60 60 }
		}
		widgetanchor = center
		parentanchor = center

		# Mining
		icon = { parentanchor = center using = eul_vis_marker_mining_town_capital using = eul_tex_red_capital_town block "marker_rank_icon_size" { size = { 60 60 } } }
		icon = { parentanchor = center using = eul_vis_marker_mining_town_prov_capital using = eul_tex_red_province_capital_town block "marker_rank_icon_size" { size = { 60 60 } } }
		icon = { parentanchor = center using = eul_vis_marker_mining_town_regular using = eul_tex_red_town block "marker_rank_icon_size" { size = { 60 60 } } }
		icon = { parentanchor = center using = eul_vis_marker_mining_city_capital using = eul_tex_red_capital_city block "marker_rank_icon_size" { size = { 60 60 } } }
		icon = { parentanchor = center using = eul_vis_marker_mining_city_prov_capital using = eul_tex_red_province_capital_city block "marker_rank_icon_size" { size = { 60 60 } } }
		icon = { parentanchor = center using = eul_vis_marker_mining_city_regular using = eul_tex_red_city block "marker_rank_icon_size" { size = { 60 60 } } }
		# Farming
		icon = { parentanchor = center using = eul_vis_marker_farming_town_capital using = eul_tex_green_capital_town block "marker_rank_icon_size" { size = { 60 60 } } }
		icon = { parentanchor = center using = eul_vis_marker_farming_town_prov_capital using = eul_tex_green_province_capital_town block "marker_rank_icon_size" { size = { 60 60 } } }
		icon = { parentanchor = center using = eul_vis_marker_farming_town_regular using = eul_tex_green_town block "marker_rank_icon_size" { size = { 60 60 } } }
		icon = { parentanchor = center using = eul_vis_marker_farming_city_capital using = eul_tex_green_capital_city block "marker_rank_icon_size" { size = { 60 60 } } }
		icon = { parentanchor = center using = eul_vis_marker_farming_city_prov_capital using = eul_tex_green_province_capital_city block "marker_rank_icon_size" { size = { 60 60 } } }
		icon = { parentanchor = center using = eul_vis_marker_farming_city_regular using = eul_tex_green_city block "marker_rank_icon_size" { size = { 60 60 } } }
		# Gathering
		icon = { parentanchor = center using = eul_vis_marker_gathering_town_capital using = eul_tex_blue_capital_town block "marker_rank_icon_size" { size = { 60 60 } } }
		icon = { parentanchor = center using = eul_vis_marker_gathering_town_prov_capital using = eul_tex_blue_province_capital_town block "marker_rank_icon_size" { size = { 60 60 } } }
		icon = { parentanchor = center using = eul_vis_marker_gathering_town_regular using = eul_tex_blue_town block "marker_rank_icon_size" { size = { 60 60 } } }
		icon = { parentanchor = center using = eul_vis_marker_gathering_city_capital using = eul_tex_blue_capital_city block "marker_rank_icon_size" { size = { 60 60 } } }
		icon = { parentanchor = center using = eul_vis_marker_gathering_city_prov_capital using = eul_tex_blue_province_capital_city block "marker_rank_icon_size" { size = { 60 60 } } }
		icon = { parentanchor = center using = eul_vis_marker_gathering_city_regular using = eul_tex_blue_city block "marker_rank_icon_size" { size = { 60 60 } } }
		# Forestry
		icon = { parentanchor = center using = eul_vis_marker_forestry_town_capital using = eul_tex_brown_capital_town block "marker_rank_icon_size" { size = { 60 60 } } }
		icon = { parentanchor = center using = eul_vis_marker_forestry_town_prov_capital using = eul_tex_brown_province_capital_town block "marker_rank_icon_size" { size = { 60 60 } } }
		icon = { parentanchor = center using = eul_vis_marker_forestry_town_regular using = eul_tex_brown_town block "marker_rank_icon_size" { size = { 60 60 } } }
		icon = { parentanchor = center using = eul_vis_marker_forestry_city_capital using = eul_tex_brown_capital_city block "marker_rank_icon_size" { size = { 60 60 } } }
		icon = { parentanchor = center using = eul_vis_marker_forestry_city_prov_capital using = eul_tex_brown_province_capital_city block "marker_rank_icon_size" { size = { 60 60 } } }
		icon = { parentanchor = center using = eul_vis_marker_forestry_city_regular using = eul_tex_brown_city block "marker_rank_icon_size" { size = { 60 60 } } }
		# Commercial
		icon = { parentanchor = center using = eul_vis_marker_commercial_town_capital using = eul_tex_purple_capital_town block "marker_rank_icon_size" { size = { 60 60 } } }
		icon = { parentanchor = center using = eul_vis_marker_commercial_town_prov_capital using = eul_tex_purple_province_capital_town block "marker_rank_icon_size" { size = { 60 60 } } }
		icon = { parentanchor = center using = eul_vis_marker_commercial_town_regular using = eul_tex_purple_town block "marker_rank_icon_size" { size = { 60 60 } } }
		icon = { parentanchor = center using = eul_vis_marker_commercial_city_capital using = eul_tex_purple_capital_city block "marker_rank_icon_size" { size = { 60 60 } } }
		icon = { parentanchor = center using = eul_vis_marker_commercial_city_prov_capital using = eul_tex_purple_province_capital_city block "marker_rank_icon_size" { size = { 60 60 } } }
		icon = { parentanchor = center using = eul_vis_marker_commercial_city_regular using = eul_tex_purple_city block "marker_rank_icon_size" { size = { 60 60 } } }
		# Fallback
		icon = { parentanchor = center using = eul_vis_marker_fallback texture = "[CityMarker.GetLocation.GetRankIcon]" block "marker_rank_icon_size" { size = { 60 60 } } }

		flowcontainer = {
			parentanchor = vcenter
			widgetanchor = vcenter|right
			ignoreinvisible = yes
			datacontext = "[CityMarker.GetLocation.GetOwner]"
			flowcontainer = {
				visible = "[MapMarkerFlagsVisible]"
				ignoreinvisible = yes
				using = MapMarkerFlags
			}
		}

		flowcontainer = {
			block "marker_rank_icon_position" {
				position = { 22 0 }
			}
			ignoreinvisible = yes
			text_single = {
				text = "[CityMarker.GetLocation.GetNameWithNoTooltip|U]"
				snap_to_pixels = no
				default_format = "#map_city_label_capital"
				align = nobaseline
				visible = "[CityMarker.ShouldBeShownAsCapital]"
			}
			text_single = {
				text = "[CityMarker.GetLocation.GetNameWithNoTooltip|U]"
				snap_to_pixels = no
				default_format = "#map_city_label"
				align = nobaseline
				visible = "[CityMarker.ShouldBeShownAsCity]"
			}
		}
	}

	# Override location_rank_icon for zoomed-in/detail view
	type location_rank_icon = widget {
		block "icon_size" {
			size = { @city_marker_icon_size @city_marker_icon_size }
		}

		# Mining - Town
		icon = { parentanchor = center using = eul_vis_loc_noisset_mining_town_capital using = eul_tex_red_capital_town block "icon_size" { size = { @town_marker_icon_size @town_marker_icon_size } } onmousehierarchyenter = "[PdxGuiWidget.SetHighlightProvince(Location.GetProvince)]" }
		icon = { parentanchor = center using = eul_vis_loc_noisset_mining_town_prov_capital using = eul_tex_red_province_capital_town block "icon_size" { size = { @town_marker_icon_size @town_marker_icon_size } } onmousehierarchyenter = "[PdxGuiWidget.SetHighlightProvince(Location.GetProvince)]" }
		icon = { parentanchor = center using = eul_vis_loc_noisset_mining_town_regular using = eul_tex_red_town block "icon_size" { size = { @town_marker_icon_size @town_marker_icon_size } } onmousehierarchyenter = "[PdxGuiWidget.SetHighlightProvince(Location.GetProvince)]" }
		# Mining - City
		icon = { parentanchor = center using = eul_vis_loc_noisset_mining_city_capital using = eul_tex_red_capital_city block "icon_size" { size = { @city_marker_icon_size @city_marker_icon_size } } onmousehierarchyenter = "[PdxGuiWidget.SetHighlightProvince(Location.GetProvince)]" }
		icon = { parentanchor = center using = eul_vis_loc_noisset_mining_city_prov_capital using = eul_tex_red_province_capital_city block "icon_size" { size = { @city_marker_icon_size @city_marker_icon_size } } onmousehierarchyenter = "[PdxGuiWidget.SetHighlightProvince(Location.GetProvince)]" }
		icon = { parentanchor = center using = eul_vis_loc_noisset_mining_city_regular using = eul_tex_red_city block "icon_size" { size = { @city_marker_icon_size @city_marker_icon_size } } onmousehierarchyenter = "[PdxGuiWidget.SetHighlightProvince(Location.GetProvince)]" }

		# Farming - Town
		icon = { parentanchor = center using = eul_vis_loc_noisset_farming_town_capital using = eul_tex_green_capital_town block "icon_size" { size = { @town_marker_icon_size @town_marker_icon_size } } onmousehierarchyenter = "[PdxGuiWidget.SetHighlightProvince(Location.GetProvince)]" }
		icon = { parentanchor = center using = eul_vis_loc_noisset_farming_town_prov_capital using = eul_tex_green_province_capital_town block "icon_size" { size = { @town_marker_icon_size @town_marker_icon_size } } onmousehierarchyenter = "[PdxGuiWidget.SetHighlightProvince(Location.GetProvince)]" }
		icon = { parentanchor = center using = eul_vis_loc_noisset_farming_town_regular using = eul_tex_green_town block "icon_size" { size = { @town_marker_icon_size @town_marker_icon_size } } onmousehierarchyenter = "[PdxGuiWidget.SetHighlightProvince(Location.GetProvince)]" }
