		# Forestry - Town
		icon = { parentanchor = center using = eul_vis_loc_noisset_forestry_town_capital using = eul_tex_brown_capital_town block "icon_size" { size = { @town_marker_icon_size @town_marker_icon_size } } onmousehierarchyenter = "[PdxGuiWidget.SetHighlightProvince(Location.GetProvince)]" }
		icon = { parentanchor = center using = eul_vis_loc_noisset_forestry_town_prov_capital using = eul_tex_brown_province_capital_town block "icon_size" { size = { @town_marker_icon_size @town_marker_icon_size } } onmousehierarchyenter = "[PdxGuiWidget.SetHighlightProvince(Location.GetProvince)]" }
		icon = { parentanchor = center using = eul_vis_loc_noisset_forestry_town_regular using = eul_tex_brown_town block "icon_size" { size = { @town_marker_icon_size @town_marker_icon_size } } onmousehierarchyenter = "[PdxGuiWidget.SetHighlightProvince(Location.GetProvince)]" }
		# Forestry - City
		icon = { parentanchor = center using = eul_vis_loc_noisset_forestry_city_capital using = eul_tex_brown_capital_city block "icon_size" { size = { @city_marker_icon_size @city_marker_icon_size } } onmousehierarchyenter = "[PdxGuiWidget.SetHighlightProvince(Location.GetProvince)]" }
		icon = { parentanchor = center using = eul_vis_loc_noisset_forestry_city_prov_capital using = eul_tex_brown_province_capital_city block "icon_size" { size = { @city_marker_icon_size @city_marker_icon_size } } onmousehierarchyenter = "[PdxGuiWidget.SetHighlightProvince(Location.GetProvince)]" }
