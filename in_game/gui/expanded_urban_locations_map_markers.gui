# =====================================================
# SECTION 5: TEXT TEMPLATES - Specialized Location Names
# =====================================================
# Uses localization keys from expanded_urban_locations_gui_l_english.yml
# Value mapping: 1=mining_town, 2=farming_town, 3=gathering_town, 4=forestry_town, 5=commercial_town
#                11=mining_city, 12=farming_city, 13=gathering_city, 14=forestry_city, 15=commercial_city

# Location scope version (for map_markers tooltips)
template eul_text_specialized_name_loc {
	text = "[Select_CString(EqualTo_float(FixedPointToFloat(Location.MakeScope.GetVariable('specialization_designation').GetValue), '(float)1.0'), Localize('EUL_MINING_TOWN_OF'), Select_CString(EqualTo_float(FixedPointToFloat(Location.MakeScope.GetVariable('specialization_designation').GetValue), '(float)2.0'), Localize('EUL_FARMING_TOWN_OF'), Select_CString(EqualTo_float(FixedPointToFloat(Location.MakeScope.GetVariable('specialization_designation').GetValue), '(float)3.0'), Localize('EUL_GATHERING_TOWN_OF'), Select_CString(EqualTo_float(FixedPointToFloat(Location.MakeScope.GetVariable('specialization_designation').GetValue), '(float)4.0'), Localize('EUL_FORESTRY_TOWN_OF'), Select_CString(EqualTo_float(FixedPointToFloat(Location.MakeScope.GetVariable('specialization_designation').GetValue), '(float)5.0'), Localize('EUL_COMMERCIAL_TOWN_OF'), Select_CString(EqualTo_float(FixedPointToFloat(Location.MakeScope.GetVariable('specialization_designation').GetValue), '(float)11.0'), Localize('EUL_MINING_CITY_OF'), Select_CString(EqualTo_float(FixedPointToFloat(Location.MakeScope.GetVariable('specialization_designation').GetValue), '(float)12.0'), Localize('EUL_FARMING_CITY_OF'), Select_CString(EqualTo_float(FixedPointToFloat(Location.MakeScope.GetVariable('specialization_designation').GetValue), '(float)13.0'), Localize('EUL_GATHERING_CITY_OF'), Select_CString(EqualTo_float(FixedPointToFloat(Location.MakeScope.GetVariable('specialization_designation').GetValue), '(float)14.0'), Localize('EUL_FORESTRY_CITY_OF'), Select_CString(EqualTo_float(FixedPointToFloat(Location.MakeScope.GetVariable('specialization_designation').GetValue), '(float)15.0'), Localize('EUL_COMMERCIAL_CITY_OF'), Location.GetRankAndName))))))))))]"
}

# LocationView scope version (for location_window.gui)
template eul_text_specialized_name_locview {
	text = "[Select_CString(EqualTo_float(FixedPointToFloat(LocationView.GetLocation.MakeScope.GetVariable('specialization_designation').GetValue), '(float)1.0'), Concatenate(Localize('EUL_MINING_TOWN_PREFIX'), LocationView.GetLocation.GetNameWithNoTooltip), Select_CString(EqualTo_float(FixedPointToFloat(LocationView.GetLocation.MakeScope.GetVariable('specialization_designation').GetValue), '(float)2.0'), Concatenate(Localize('EUL_FARMING_TOWN_PREFIX'), LocationView.GetLocation.GetNameWithNoTooltip), Select_CString(EqualTo_float(FixedPointToFloat(LocationView.GetLocation.MakeScope.GetVariable('specialization_designation').GetValue), '(float)3.0'), Concatenate(Localize('EUL_GATHERING_TOWN_PREFIX'), LocationView.GetLocation.GetNameWithNoTooltip), Select_CString(EqualTo_float(FixedPointToFloat(LocationView.GetLocation.MakeScope.GetVariable('specialization_designation').GetValue), '(float)4.0'), Concatenate(Localize('EUL_FORESTRY_TOWN_PREFIX'), LocationView.GetLocation.GetNameWithNoTooltip), Select_CString(EqualTo_float(FixedPointToFloat(LocationView.GetLocation.MakeScope.GetVariable('specialization_designation').GetValue), '(float)5.0'), Concatenate(Localize('EUL_COMMERCIAL_TOWN_PREFIX'), LocationView.GetLocation.GetNameWithNoTooltip), Select_CString(EqualTo_float(FixedPointToFloat(LocationView.GetLocation.MakeScope.GetVariable('specialization_designation').GetValue), '(float)11.0'), Concatenate(Localize('EUL_MINING_CITY_PREFIX'), LocationView.GetLocation.GetNameWithNoTooltip), Select_CString(EqualTo_float(FixedPointToFloat(LocationView.GetLocation.MakeScope.GetVariable('specialization_designation').GetValue), '(float)12.0'), Concatenate(Localize('EUL_FARMING_CITY_PREFIX'), LocationView.GetLocation.GetNameWithNoTooltip), Select_CString(EqualTo_float(FixedPointToFloat(LocationView.GetLocation.MakeScope.GetVariable('specialization_designation').GetValue), '(float)13.0'), Concatenate(Localize('EUL_GATHERING_CITY_PREFIX'), LocationView.GetLocation.GetNameWithNoTooltip), Select_CString(EqualTo_float(FixedPointToFloat(LocationView.GetLocation.MakeScope.GetVariable('specialization_designation').GetValue), '(float)14.0'), Concatenate(Localize('EUL_FORESTRY_CITY_PREFIX'), LocationView.GetLocation.GetNameWithNoTooltip), Select_CString(EqualTo_float(FixedPointToFloat(LocationView.GetLocation.MakeScope.GetVariable('specialization_designation').GetValue), '(float)15.0'), Concatenate(Localize('EUL_COMMERCIAL_CITY_PREFIX'), LocationView.GetLocation.GetNameWithNoTooltip), LocationView.GetLocation.GetRankAndName))))))))))]"
}

