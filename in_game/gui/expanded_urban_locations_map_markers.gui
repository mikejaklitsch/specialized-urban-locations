		icon = { parentanchor = center using = eul_vis_loc_noisset_farming_city_prov_capital using = eul_tex_green_province_capital_city block "icon_size" { size = { @city_marker_icon_size @city_marker_icon_size } } onmousehierarchyenter = "[PdxGuiWidget.SetHighlightProvince(Location.GetProvince)]" }
		icon = { parentanchor = center using = eul_vis_loc_noisset_farming_city_regular using = eul_tex_green_city block "icon_size" { size = { @city_marker_icon_size @city_marker_icon_size } } onmousehierarchyenter = "[PdxGuiWidget.SetHighlightProvince(Location.GetProvince)]" }

		# Gathering - Town
		icon = { parentanchor = center using = eul_vis_loc_noisset_gathering_town_capital using = eul_tex_blue_capital_town block "icon_size" { size = { @town_marker_icon_size @town_marker_icon_size } } onmousehierarchyenter = "[PdxGuiWidget.SetHighlightProvince(Location.GetProvince)]" }
		icon = { parentanchor = center using = eul_vis_loc_noisset_gathering_town_prov_capital using = eul_tex_blue_province_capital_town block "icon_size" { size = { @town_marker_icon_size @town_marker_icon_size } } onmousehierarchyenter = "[PdxGuiWidget.SetHighlightProvince(Location.GetProvince)]" }
		icon = { parentanchor = center using = eul_vis_loc_noisset_gathering_town_regular using = eul_tex_blue_town block "icon_size" { size = { @town_marker_icon_size @town_marker_icon_size } } onmousehierarchyenter = "[PdxGuiWidget.SetHighlightProvince(Location.GetProvince)]" }
		# Gathering - City
		icon = { parentanchor = center using = eul_vis_loc_noisset_gathering_city_capital using = eul_tex_blue_capital_city block "icon_size" { size = { @city_marker_icon_size @city_marker_icon_size } } onmousehierarchyenter = "[PdxGuiWidget.SetHighlightProvince(Location.GetProvince)]" }
		icon = { parentanchor = center using = eul_vis_loc_noisset_gathering_city_prov_capital using = eul_tex_blue_province_capital_city block "icon_size" { size = { @city_marker_icon_size @city_marker_icon_size } } onmousehierarchyenter = "[PdxGuiWidget.SetHighlightProvince(Location.GetProvince)]" }
