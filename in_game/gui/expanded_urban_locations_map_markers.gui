# Base templates (no capital check) - for text templates
template eul_vis_loc_mining_town { visible = "[And(Location.MakeScope.GetVariable('specialization_designation').IsSet, EqualTo_float(FixedPointToFloat(Location.MakeScope.GetVariable('specialization_designation').GetValue), '(float)1.0'))]" }
template eul_vis_loc_farming_town { visible = "[And(Location.MakeScope.GetVariable('specialization_designation').IsSet, EqualTo_float(FixedPointToFloat(Location.MakeScope.GetVariable('specialization_designation').GetValue), '(float)2.0'))]" }
template eul_vis_loc_gathering_town { visible = "[And(Location.MakeScope.GetVariable('specialization_designation').IsSet, EqualTo_float(FixedPointToFloat(Location.MakeScope.GetVariable('specialization_designation').GetValue), '(float)3.0'))]" }
