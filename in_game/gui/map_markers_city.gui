@city_marker_icon_size = 30
@city_marker_fort_icon_size = 16
@town_marker_icon_size = 26
@rural_marker_icon_size = 20

template MapMarkerFlags {
	country_flag_small = {
		name = "controller_flag_country_capital"
		# size = { 24 16 }
		tooltip_enabled = no
		datacontext = "[CityMarker.GetLocation.GetController]"

		blockoverride "click" { onclick = "[CityMarker.OnClick]" }

		blockoverride "double_click" {  }
		visible = "[And(CityMarker.ShouldShowOccupationFlag, CityMarker.GetLocation.IsCapital)]"
	}

	country_flag_very_small = {
		name = "controller_flag_province_capital"
		# size = { 24 16 }
		tooltip_enabled = no
		datacontext = "[CityMarker.GetLocation.GetController]"

		blockoverride "click" { onclick = "[CityMarker.OnClick]" }

		blockoverride "double_click" {  }
		visible = "[And3(CityMarker.ShouldShowOccupationFlag, CityMarker.GetLocation.IsProvinceCapital, Not(CityMarker.GetLocation.IsCapital))]"
	}

	country_flag_mini = {
		# size = { 24 16 }
		tooltip_enabled = no
		datacontext = "[CityMarker.GetLocation.GetController]"

		blockoverride "click" { onclick = "[CityMarker.OnClick]" }

		blockoverride "double_click" {  }
		visible = "[And3(CityMarker.ShouldShowOccupationFlag, Not(CityMarker.GetLocation.IsProvinceCapital), Not(CityMarker.GetLocation.IsCapital))]"
	}

	country_flag_small_plus = {
		# size = { 24 16 }
		tooltip_enabled = no

		blockoverride "click" { onclick = "[CityMarker.OnClick]" }

		blockoverride "double_click" {  }
		visible = "[And(GreaterThanOrEqualTo_int32(CityMarker.GetLocation.GetOwner.GetRank.GetLevelNumber, '(int32)4'), CityMarker.ShouldBeShownAsCapital)]"
	}

	country_flag_small = {
		# size = { 24 16 }
		tooltip_enabled = no

		blockoverride "click" { onclick = "[CityMarker.OnClick]" }

		blockoverride "double_click" {  }
		visible = "[And(EqualTo_int32(CityMarker.GetLocation.GetOwner.GetRank.GetLevelNumber, '(int32)3'), CityMarker.ShouldBeShownAsCapital)]"
	}

	country_flag_very_small = {
		# size = { 24 16 }
		tooltip_enabled = no

		blockoverride "click" { onclick = "[CityMarker.OnClick]" }

		blockoverride "double_click" {  }
		visible = "[And(EqualTo_int32(CityMarker.GetLocation.GetOwner.GetRank.GetLevelNumber, '(int32)2'), CityMarker.ShouldBeShownAsCapital)]"
	}

	country_flag_mini = {
		size = { 24 16 }
		tooltip_enabled = no

		blockoverride "click" { onclick = "[CityMarker.OnClick]" }

		blockoverride "double_click" {  }
		visible = "[And(LessThanOrEqualTo_int32(CityMarker.GetLocation.GetOwner.GetRank.GetLevelNumber, '(int32)1'), CityMarker.ShouldBeShownAsCapital)]"
	}
}

types map_marker_city
{
	# marker_rank_icon - ZOOMED OUT map view
	# Icon is the centered anchor point, flags extend left, name extends right
	type marker_rank_icon = widget {
		allow_outside = yes

		block "marker_rank_icon_size" {
			size = { @city_marker_icon_size @city_marker_icon_size }
		}

		widgetanchor = center
		parentanchor = center

		# FLAGS - positioned to the LEFT of the icon
		flowcontainer = {
			parentanchor = vcenter
			widgetanchor = vcenter|right
			visible = "[And(MapMarkerFlagsVisible, CityMarker.GetLocation.IsCapital)]"
			ignoreinvisible = yes
			datacontext = "[CityMarker.GetLocation.GetOwner]"
			using = MapMarkerFlags
		}

		# ICON CONTAINER - datacontext sets Location for template reuse
		# Admin filter: show spec icons if location matches any enabled admin tier
		# (capital + ri_cap, province capital + ri_pcap, or ri_all for everything else)
		widget = {
			datacontext = "[CityMarker.GetLocation]"
			size = { 100% 100% }
			visible = "[Or3(And(CityMarker.GetLocation.IsCapital, GetPlayer.MakeScope.GetVariable('dwui_ri_cap').IsSet), And(CityMarker.GetLocation.IsProvinceCapital, GetPlayer.MakeScope.GetVariable('dwui_ri_pcap').IsSet), GetPlayer.MakeScope.GetVariable('dwui_ri_all').IsSet)]"

			# CITY BRANCH (specialization icon, gated by rank toggle)
			widget = {
				size = { 100% 100% }
				visible = "[GetPlayer.MakeScope.GetVariable('dwui_ri_city').IsSet]"

				icon = {
					parentanchor = center
					using = sul_vis_loc_any_city
					using = sul_icon_size_city
					using = sul_concept_texture_loc
				}
			}

			# TOWN BRANCH (specialization icon, gated by rank toggle)
			widget = {
				size = { 100% 100% }
				visible = "[GetPlayer.MakeScope.GetVariable('dwui_ri_town').IsSet]"

				icon = {
					parentanchor = center
					using = sul_vis_loc_any_town
					using = sul_icon_size_town
					using = sul_concept_texture_loc
				}
			}

			# RURAL BRANCH (specialization icon, gated by rank toggle)
			widget = {
				size = { 100% 100% }
				visible = "[GetPlayer.MakeScope.GetVariable('dwui_ri_rural').IsSet]"

				icon = {
					parentanchor = center
					using = sul_vis_loc_any_rural
					using = sul_icon_size_rural
					using = sul_concept_texture_loc
				}
			}

			# FALLBACK - non-specialized locations use vanilla icon
			icon = {
				parentanchor = center
				using = sul_vis_loc_not_specialized
				texture = "[Location.GetRankIcon]"
				size = { 20 20 }
			}
		}

		# NAME - positioned to the RIGHT of the icon
		flowcontainer = {
			parentanchor = vcenter
			widgetanchor = vcenter|left
			block "marker_rank_icon_position" { position = { @city_marker_icon_size 0 } }
			ignoreinvisible = yes

			text_single = {
				text = "[CityMarker.GetLocation.GetNameWithNoTooltip|U]"
				snap_to_pixels = no
				default_format = "#map_city_label_capital"
				align = nobaseline
				visible = "[CityMarker.ShouldBeShownAsCapital]"
			}
			text_single = {
				text = "[CityMarker.GetLocation.GetNameWithNoTooltip|U]"
				snap_to_pixels = no
				default_format = "#map_city_label"
				align = nobaseline
				visible = "[CityMarker.ShouldBeShownAsCity]"
			}
		}
	}

	type location_rank_icon = widget {
		block "icon_size" {
			size = { @city_marker_icon_size @city_marker_icon_size }
		}

		# SUL specialization icons — gated by rank toggle AND admin filter
		# Admin filter: capital + ri_cap, OR province capital + ri_pcap, OR ri_all
		# CITY (max rank)
		icon = {
			parentanchor = center
			size = { @city_marker_icon_size @city_marker_icon_size }
			visible = "[And3(GetPlayer.MakeScope.GetVariable('dwui_ri_city').IsSet, And3(Location.MakeScope.GetVariable('sul_designation').IsSet, Location.GetRank.IsCity, Location.GetRank.IsMaxRank), Or3(And(Location.IsCapital, GetPlayer.MakeScope.GetVariable('dwui_ri_cap').IsSet), And(Location.IsProvinceCapital, GetPlayer.MakeScope.GetVariable('dwui_ri_pcap').IsSet), GetPlayer.MakeScope.GetVariable('dwui_ri_all').IsSet))]"
			using = sul_concept_texture_loc
			onmousehierarchyenter = "[PdxGuiWidget.SetHighlightProvince(Location.GetProvince)]"
		}

		# TOWN (city rank, not max)
		icon = {
			parentanchor = center
			size = { @town_marker_icon_size @town_marker_icon_size }
			visible = "[And3(GetPlayer.MakeScope.GetVariable('dwui_ri_town').IsSet, And3(Location.MakeScope.GetVariable('sul_designation').IsSet, Location.GetRank.IsCity, Not(Location.GetRank.IsMaxRank)), Or3(And(Location.IsCapital, GetPlayer.MakeScope.GetVariable('dwui_ri_cap').IsSet), And(Location.IsProvinceCapital, GetPlayer.MakeScope.GetVariable('dwui_ri_pcap').IsSet), GetPlayer.MakeScope.GetVariable('dwui_ri_all').IsSet))]"
			using = sul_concept_texture_loc
			onmousehierarchyenter = "[PdxGuiWidget.SetHighlightProvince(Location.GetProvince)]"
		}

		# RURAL
		icon = {
			parentanchor = center
			size = { @rural_marker_icon_size @rural_marker_icon_size }
			visible = "[And3(GetPlayer.MakeScope.GetVariable('dwui_ri_rural').IsSet, And(Location.MakeScope.GetVariable('sul_designation').IsSet, Not(Location.GetRank.IsCity)), Or3(And(Location.IsCapital, GetPlayer.MakeScope.GetVariable('dwui_ri_cap').IsSet), And(Location.IsProvinceCapital, GetPlayer.MakeScope.GetVariable('dwui_ri_pcap').IsSet), GetPlayer.MakeScope.GetVariable('dwui_ri_all').IsSet))]"
			using = sul_concept_texture_loc
			onmousehierarchyenter = "[PdxGuiWidget.SetHighlightProvince(Location.GetProvince)]"
		}

		# Vanilla rank icons — only for non-specialized locations
		icon = {
			parentanchor = center
			size = { @city_marker_icon_size @city_marker_icon_size }
			visible = "[And3(Not(Location.MakeScope.GetVariable('sul_designation').IsSet), Location.GetRank.IsCity, Location.GetRank.IsMaxRank)]"
			texture = "[Location.GetRankIcon]"
			onmousehierarchyenter = "[PdxGuiWidget.SetHighlightProvince(Location.GetProvince)]"
		}
		icon = {
			parentanchor = center
			size = { @town_marker_icon_size @town_marker_icon_size }
			visible = "[And3(Not(Location.MakeScope.GetVariable('sul_designation').IsSet), Location.GetRank.IsCity, Not(Location.GetRank.IsMaxRank))]"
			texture = "[Location.GetRankIcon]"
			onmousehierarchyenter = "[PdxGuiWidget.SetHighlightProvince(Location.GetProvince)]"
		}
		icon = {
			parentanchor = center
			size = { @rural_marker_icon_size @rural_marker_icon_size }
			visible = "[And(Not(Location.MakeScope.GetVariable('sul_designation').IsSet), Not(Location.GetRank.IsCity))]"
			texture = "[Location.GetRankIcon]"
			onmousehierarchyenter = "[PdxGuiWidget.SetHighlightProvince(Location.GetProvince)]"
		}

		tooltipwidget = { using = location_rank_tooltip }
	}
}

### CITY

widget = {
	name = "city_marker"
	allow_outside = yes

	widget = {
		parentanchor = center
		allow_outside = yes
		max_update_rate = 2

		visible = "[CityMarker.ShowDetailsOrHasWarFort]"
		size = { @city_marker_icon_size @city_marker_icon_size }

		widget = {
			parentanchor = left|vcenter
			widgetanchor = right|vcenter

			hbox = {
				margin = { 0 0 }
				minimumsize = { -1 @city_marker_icon_size }
				set_parent_size_to_minimum = yes
				visible = "[And(CityMarker.ShouldShowOccupationFlag, CityMarker.GetLocation.IsCapital)]"
				datacontext = "[CityMarker.GetLocation.GetController]"

				country_flag_small = {
					visible = "[And(MapMarkerFlagsVisible, CityMarker.GetLocation.IsCapital)]"
				}
			}
		}

		widget = {
			parentanchor = left|vcenter
			widgetanchor = left|vcenter
			datacontext = "[CityMarker.GetLocation.GetOwner]"
			# Hide non-capital/non-fort settlements at medium zoom (#4)
			visible = "[Or5(CityMarker.ShowDetails, Not(CityMarker.ShouldBeShownAsSettlement), CityMarker.GetLocation.IsCapital, CityMarker.GetLocation.IsProvinceCapital, CityMarker.HasWarFort)]"

			background = {
				using = simple_paper_card_texture
				alpha = 0.5
				margin = { 0 -2 }
				margin_right = 6
				mirror = horizontal
				visible = "[And(GetPlayer.MakeScope.GetVariable('dwui_cl').IsSet, Or6(And(CityMarker.GetLocation.IsCapital, GetPlayer.MakeScope.GetVariable('dwui_cap').IsSet), And(CityMarker.GetLocation.IsProvinceCapital, GetPlayer.MakeScope.GetVariable('dwui_pcap').IsSet), And3(CityMarker.GetLocation.GetRank.IsCity, CityMarker.GetLocation.GetRank.IsMaxRank, GetPlayer.MakeScope.GetVariable('dwui_city').IsSet), And3(CityMarker.GetLocation.GetRank.IsCity, Not(CityMarker.GetLocation.GetRank.IsMaxRank), GetPlayer.MakeScope.GetVariable('dwui_town').IsSet), And(Not(CityMarker.GetLocation.GetRank.IsCity), GetPlayer.MakeScope.GetVariable('dwui_rural').IsSet), And(CityMarker.GetLocation.HasAnyFort, GetPlayer.MakeScope.GetVariable('dwui_fort').IsSet)))]"
				using = marker_country_side_color
			}

			hbox = {
				minimumsize = { -1 @city_marker_icon_size }
				set_parent_size_to_minimum = yes
				ignoreinvisible = yes
				spacing = 2

				location_rank_icon = { datacontext = "[CityMarker.GetLocation]" }

				widget = {
					size = { 28 28 }
					allow_outside = yes
					visible = "[CityMarker.GetLocation.HasAnyFort]"

					tooltipwidget = {
						ContextualTooltipType = {
							blockoverride "title_icon" {
								icon = {
									texture = "[GetBuildingIcon(CityMarker.GetLocation.GetBestFortBuilding.GetType)]"
									using = tooltip_title_icon_size
								}
							}
							blockoverride "title_text" { text = "FORT_LEVEL" }
							blockoverride "concept_link" { text = "[fort|e]" }
							blockoverride "tooltip_content" {
								TooltipStringPairList = {
									textcontext = "[CityMarker.GetLocation.GetDescriptionFor('fort_level')]"
								}
							}
						}
					}

					# Building-specific fort icon (mod default)
					icon = {
						alwaystransparent = no
						parentanchor = center
						widgetanchor = center
						position = { 0 -3 }
						onmousehierarchyenter = "[PdxGuiWidget.SetHighlightFort(CityMarker.GetLocation)]"
						visible = "[And(CityMarker.GetLocation.HasAnyFort, Not(GetPlayer.MakeScope.GetVariable('dwui_vfort').IsSet))]"
						texture = "[GetBuildingIcon(CityMarker.GetLocation.GetBestFortBuilding.GetType)]"
						size = { 28 28 }
					}

					# Vanilla generic fort icon
					icon = {
						alwaystransparent = no
						parentanchor = center
						widgetanchor = center
						onmousehierarchyenter = "[PdxGuiWidget.SetHighlightFort(CityMarker.GetLocation)]"
						visible = "[And(CityMarker.GetLocation.HasAnyFort, GetPlayer.MakeScope.GetVariable('dwui_vfort').IsSet)]"
						texture = "gfx/interface/icons/map_modes/fort_level_icon.dds"
						size = { @city_marker_fort_icon_size @city_marker_fort_icon_size }
					}
				}

				text_single = {
					# Show name when: not at war, OR location type matches name visibility settings
					visible = "[Or(Not(GetPlayer.GetDiplomacy.IsAtWar), Or6(And(CityMarker.GetLocation.IsCapital, GetPlayer.MakeScope.GetVariable('dwui_nm_cap').IsSet), And(CityMarker.GetLocation.IsProvinceCapital, GetPlayer.MakeScope.GetVariable('dwui_nm_pcap').IsSet), And3(CityMarker.GetLocation.GetRank.IsCity, CityMarker.GetLocation.GetRank.IsMaxRank, GetPlayer.MakeScope.GetVariable('dwui_nm_city').IsSet), And3(CityMarker.GetLocation.GetRank.IsCity, Not(CityMarker.GetLocation.GetRank.IsMaxRank), GetPlayer.MakeScope.GetVariable('dwui_nm_town').IsSet), And(Not(CityMarker.GetLocation.GetRank.IsCity), GetPlayer.MakeScope.GetVariable('dwui_nm_rural').IsSet), And(CityMarker.GetLocation.HasAnyFort, GetPlayer.MakeScope.GetVariable('dwui_nm_fort').IsSet)))]"
					text = "[CityMarker.GetLocation.GetNameWithNoTooltip|U]"
					snap_to_pixels = yes
					fontsize = 12
					align = nobaseline
					default_format = "#map_city_label"
				}
			}
		}
	}

	marker_rank_icon = {
		max_update_rate = 2
		visible = "[CityMarker.GetRankVisible]"
	}
}
