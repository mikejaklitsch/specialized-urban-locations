# Complacency — override of vanilla ComplacencyResourceTooltip.
# Removes disaster gating. Scrollable source breakdown with effects at bottom.
# File prefixed aaa_ so it loads before vanilla.

template ComplacencyResourceTooltip {
	ContextualTooltipType = {
		blockoverride "title_icon_texture" {
			texture = "gfx/interface/icons/resources/complacency.dds"

			glow = {
				name = "drop_shadow"
				glow_radius = 3
				color = { 0.0 0.0 0.0 1.0 }
				alpha = 0.3
			}
		}

		blockoverride "title_text" { text = "COMPLACENCY_RESOURCE_TOOLTIP_T" }

		blockoverride "concept_link" { text = "[complacency|e]" }

		blockoverride "tooltip_content" {
			# Monthly complacency sources.
			TooltipStringPairList = {
				blockoverride "block_title" { text = "COMPLACENCY_TT_TEXT_CHANGE" }
				textcontext = "[Country.GetDescriptionFor('monthly_complacency')]"
			}

			# Complacency effects — hidden when complacency is 0.
			vbox = {
				visible = "[GreaterThan_CFixedPoint(Country.GetFixedPointCurrencyValue('complacency'), '(CFixedPoint)0')]"
				layoutpolicy_horizontal = expanding

				TooltipListBase = {
					blockoverride "block_title" { datacontext = "[Country]" text = "COMPLACENCY_EFFECT_TT" }

					TooltipListScrollArea = {
						blockoverride "block_scrollarea" {
							maximumsize = { -1 300 }
							minimumsize = { -1 30 }
						}

						blockoverride "scrollarea_content" {
							TooltipStringPairList = {
								blockoverride "block_title" { visible = no }
								textcontext = "SUL_COMPLACENCY_EFFECTS"
							}
						}
					}
				}
			}
		}
	}
}
