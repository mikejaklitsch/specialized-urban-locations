# Generated by demand_calculator.py

template sul_nobles_demand_breakdown_tooltip {
	tooltipwidget = {
		ContextualTooltipType = {
			blockoverride "tooltip_title" {  }
			blockoverride "tooltip_content" {
				TooltipListBase = {
					max_update_rate = 30
					TooltipTableHeader = { blockoverride "tableheader_text" { raw_text = "#T Nobles — WPP Breakdown#!" } }

					TooltipListScrollArea = {
						blockoverride "block_scrollarea" { maximumsize = { -1 600 } minimumsize = { -1 30 } }
						blockoverride "scrollarea_content" {
							TooltipListRowContent = {
								TooltipManualTableField = {
									blockoverride "field_content" { text_single = { layoutpolicy_horizontal = expanding raw_text = "#T Wealth Per 1k Pops#!" } }
								}
								TooltipManualTableField = {
									blockoverride "field_content" {
										text_single = { layoutpolicy_horizontal = expanding raw_text = "Wages" }
										text_single = {
											min_width = 80
											align = right
											raw_text = "[Location.MakeScope.ScriptValue('sul_noble_wage_rate')|3]@gold!"
										}
									}
								}
								TooltipManualTableField = {
									blockoverride "field_content" {
										text_single = { layoutpolicy_horizontal = expanding raw_text = "#G + Returns#!" }
										text_single = {
											min_width = 80
											align = right
											raw_text = "#G +[Location.MakeScope.ScriptValue('sul_noble_total_return')|3]@gold!#!"
										}
									}
								}
								TooltipManualTableField = {
									blockoverride "field_content" {
										text_single = { layoutpolicy_horizontal = expanding raw_text = "#R − Provisions (0.80)#!" }
										text_single = {
											min_width = 80
											align = right
											raw_text = "#R −[Location.MakeScope.ScriptValue('sul_noble_provisions_cost')|3]@gold!#!"
