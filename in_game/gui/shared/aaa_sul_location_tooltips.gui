
template location_tax_base_details {
	hbox = {
		layoutpolicy_horizontal = expanding
		spacing = 10

		widget = { ### POWER PIECHART
			size = { 100 100 }
			using = marker_bg_circle

			icon_pie_left = {
				parentanchor = center
				blockoverride "PieSize" { size = { 90% 90% } }
				blockoverride "pie_datamodel" {
					datamodel = "[DataModelSkipFirst(Location.GetOwner.GetGovernment.GetEstates, '(int32)1')]"
				}

				blockoverride "SliceTooltip" {
					tooltipwidget = {
						SimpleContextualTooltipType = {
							blockoverride "title_icon" {
								icon = {
									using = tooltip_title_icon_size
									texture = "gfx/interface/icons/location_icons/tax_base.dds"
								}
							}
							blockoverride "title_text" { text = "TAX_BASE_TT_ESTATES_LIST_SHARE_TITLE" }
							blockoverride "concept_link" { text = "[wealth_share|e]" }
							textcontext = "TAX_BASE_TT_ESTATES_LIST_SHARE"
						}
					}
				}
				blockoverride "SliceValue" { value = "[Location.GetEstateTaxBasePercent(Estate.Self)]" }
				blockoverride "SliceColor" { color = "[Estate.GetType.GetMapColor]" }
				blockoverride "Icon" { texture = "[GetConceptTexture('wealth')]" }
				blockoverride "Icon_Size" { size = { 55% 55% } }
				blockoverride "datamodel" { visible = no }
			}

			tooltip = "[wealth_share]"
			tagtooltip_enabled = yes
		}

		vbox = {
			spacing = 10

			TooltipListBase = { ### SIDE TABLE
				TooltipListRowContent = {
					TooltipManualTableField = {
						blockoverride "field_content" {
							text_single = { text = "[wealth|e]" }
							expand = {  }

							text_single = {
								raw_text = "[Location.GetTotalPossibleTaxBase|W2] [wealth_icon]"
								tagtooltip_enabled = yes
								tooltip = "[wealth|e]"
							}
						}
					}

					TooltipManualTableField = {
						blockoverride "field_content" {
							text_single = {
								text = "TAX_BASE_TT_LIST"
								tooltipwidget = { using = location_control_tooltip }
							}

							expand = {  }

							text_single = {
								raw_text = "[Location.GetTotalTaxBase|W2] [tax_base_icon]"
								tagtooltip_enabled = yes
								tooltip = "[tax_base|e]"
							}
						}
					}
				}
			}

			TooltipStringPairList = {
				visible = "[Location.HasOwner]"
				textcontext = "TAX_BASE_PEASANT_ENFRANCH"

				tooltipwidget = {
					SimpleContextualStringPairTooltipType = {
						blockoverride "title_icon" {
							icon = {
								using = tooltip_title_icon_size
								texture = "[GetConceptTexture('peasant_enfranchisement')]"
							}
						}
						blockoverride "concept_link" { text = "[peasant_enfranchisement|e]" }
						lowpriotextcontext = "[Location.GetPeasantEnfranchismentInfo]"
					}
				}
			}
		}
	}

	### VANILLA ESTATES TABLE (restored exactly)

	TooltipListBase = {
		visible = "[GreaterThan_CFixedPoint(Location.GetTotalPossibleTaxBase, '(CFixedPoint)0.0001')]"
		blockoverride "block_title" { text = "TAX_BASE_TT_ESTATES_LIST_TITLE" }

		TooltipListColumnContent = {
			TooltipTableColumn = {
				blockoverride "column_title" {  }
				blockoverride "column_title_text" { text = "[estates|e]" }
				blockoverride "column_title_right" { expand = {  } }

				blockoverride "field_left" {
					visible = "[Estate.ExistsForCountry]"
					tooltipwidget = { using = Estate_tooltip }

					icon = {
						size = { 10 20 }
						texture = "gfx/interface/component_tiles/bookmark_white.dds"
						tintcolor = "[Estate.GetType.GetMapColor]"
					}
				}
				blockoverride "field_text" {
					default_format = "#subtle_name"
					align = left|nobaseline
					raw_text = "[Estate.GetName]"
				}
				blockoverride "field_right" { expand = {  } }
			}

			TooltipTableColumn = {
				blockoverride "column_title" {  }
				blockoverride "column_title_left" { expand = {  } }
				blockoverride "column_title_text" { text = "[wealth_share|e]" }

				blockoverride "field_left" {
					expand = {  }
					visible = "[Estate.ExistsForCountry]"

					tooltipwidget = {
						SimpleContextualTooltipType = {
							blockoverride "title_icon" {
								icon = {
									using = tooltip_title_icon_size
									texture = "[GetConceptTexture('wealth')]"
								}
							}
							blockoverride "title_text" { text = "TAX_BASE_TT_ESTATES_LIST_SHARE_TITLE" }
							blockoverride "concept_link" { text = "[wealth_share|e]" }
							textcontext = "TAX_BASE_TT_ESTATES_LIST_SHARE"
						}
					}
				}
				blockoverride "field_text" {
					visible = "[Estate.ExistsForCountry]"
					raw_text = "[Multiply_CFixedPoint(Location.GetTotalPossibleTaxBase, Location.GetEstateTaxBasePercent(Estate.Self))|2]@gold! ([Location.GetEstateTaxBasePercent(Estate.Self)|0%])"
				}
			}

			TooltipTableColumn = {
				blockoverride "column_title" {  }
				blockoverride "column_title_left" { expand = {  } }
				blockoverride "column_title_text" { text = "[tax_base|e]" }

				blockoverride "field_left" {
					expand = {  }
					visible = "[Estate.ExistsForCountry]"

					tooltipwidget = {
						SimpleContextualTooltipType = {
							blockoverride "title_icon" {
								icon = {
									using = tooltip_title_icon_size
									texture = "gfx/interface/icons/location_icons/tax_base.dds"
								}
							}
							blockoverride "title_text" { text = "TAX_BASE_TT_ESTATES_LIST_SHARE_TITLE" }
							blockoverride "concept_link" { text = "[wealth_share|e]" }
							textcontext = "TAX_BASE_TT_ESTATES_LIST_SHARE"
						}
					}
				}
				blockoverride "field_text" {
					visible = "[Estate.ExistsForCountry]"
					raw_text = "[Location.GetEstateTaxBase(Estate.Self)|2L]@tax_base!"
				}
			}

			TooltipTableColumn = {
				blockoverride "column_title" {  }
				blockoverride "column_title_left" { expand = {  } }
				blockoverride "column_title_text" { text = "[tax_rate|e]" }

				blockoverride "field_left" {
					expand = {  }
					visible = "[Estate.ExistsForCountry]"

					tooltipwidget = {
						SimpleContextualTooltipType = {
							blockoverride "title_icon" {
								icon = {
									using = tooltip_title_icon_size
									texture = "gfx/interface/icons/resources/gold.dds"
								}
							}
							blockoverride "title_text" { text = "TAX_BASE_TT_ESTATES_LIST_TAXED_TITLE" }
							blockoverride "concept_link" { text = "[taxes|e]" }
							textcontext = "TAX_BASE_TT_ESTATES_LIST_TAXED"
						}
					}
				}
				blockoverride "field_text" {
					visible = "[Estate.ExistsForCountry]"
					text = "[Location.GetOwner.GetEconomy.GetTaxRate(Estate.GetType)|2%]"
				}
			}

			TooltipTableColumn = {
				blockoverride "column_title" {  }
				blockoverride "column_title_left" { expand = {  } }
				blockoverride "column_title_text" {
					text = "TAX_BASE_TT_ESTATES_LIST_INCOME_TITLE"
					default_format = "#explanation_link"
					tooltip = "[tax|e]"
					tagtooltip_enabled = yes
				}

				blockoverride "field_left" {
					expand = {  }
					visible = "[Estate.ExistsForCountry]"

					tooltipwidget = {
						SimpleContextualTooltipType = {
							blockoverride "title_icon" {
								icon = {
									using = tooltip_title_icon_size
									texture = "gfx/interface/icons/resources/gold.dds"
								}
							}
							blockoverride "title_text" { text = "TAX_BASE_TT_ESTATES_LIST_TAXED_TITLE" }
							blockoverride "concept_link" { text = "[taxes|e]" }
							textcontext = "TAX_BASE_TT_ESTATES_LIST_TAXED"
						}
					}
				}
				blockoverride "field_text" {
					visible = "[Estate.ExistsForCountry]"
					raw_text = "[Multiply_CFixedPoint(Location.GetOwner.GetEconomy.GetTaxRate(Estate.GetType), Location.GetEstateTaxBase(Estate.Self))|+=2]@income!"
				}
			}

			blockoverride "column_datamodel" {
				datamodel = "[DataModelSkipFirst(Location.GetOwner.GetGovernment.GetEstates, '(int32)1')]"
			}
		}
	}

	TooltipStringPairList = {
		visible = "[Location.HasOwner]"
		textcontext = "TAX_BASE_TT_TEXT"
	}

	### WPDO: POP DEMAND BUDGET

	TooltipListBase = {
		visible = "[Location.MakeScope.GetVariable('sul_local_gdp').IsSet]"
		max_update_rate = 30

		TooltipTableHeader = {
			blockoverride "tableheader_text" { raw_text = "#T Pop Demand Budget#!" }

			tooltipwidget = {
				ContextualTooltipType = {
					blockoverride "tooltip_title" {
						ContextualTooltipHeader = {
							blockoverride "title_icon" {
								icon = {
									using = tooltip_title_icon_size
									texture = "gfx/interface/icons/resources/gold.dds"
								}
							}
							blockoverride "title_text" { raw_text = "Pop Demand Budget" }
							blockoverride "concept_link" { text = "[wealth|e]" }
						}
					}
					blockoverride "tooltip_content" {
						text_multi = {
							layoutpolicy_horizontal = expanding
							max_width = 350
							raw_text = "Each pop type receives a share of this location's economic output based on their [estate|e]'s political influence. This budget determines what goods each pop demands and in what quantities.\\n\\nValues update on a rolling monthly cycle and may appear stale for locations not recently processed. The economy recalculates during the #T weather monthly pulse#!, cycling through all owned locations."
						}
					}
				}
			}
		}

		TooltipListRowContent = {
			# Header row
			TooltipManualTableField = {
				blockoverride "field_content" {
					text_single = {
						layoutpolicy_horizontal = expanding
						margin_left = 5
						raw_text = "#T Pop Type#!"
					}
					text_single = {
						min_width = 80
						max_width = 80
						align = right
						raw_text = "#T Share#!"

						tooltipwidget = {
							ContextualTooltipType = {
								blockoverride "tooltip_title" {
									ContextualTooltipHeader = {
										blockoverride "title_icon" {
											icon = {
												using = tooltip_title_icon_size
												texture = "[GetConceptTexture('wealth')]"
											}
										}
										blockoverride "title_text" { raw_text = "Wealth Share" }
										blockoverride "concept_link" { text = "[wealth_share|e]" }
									}
								}
								blockoverride "tooltip_content" {
									text_multi = {
										layoutpolicy_horizontal = expanding
										max_width = 350
										raw_text = "Each pop type receives a share of this location's wealth based on the political influence of their [estate|e]. More powerful estates claim a larger portion of the total economic output."
									}
								}
							}
						}
					}
					text_single = {
						min_width = 80
						max_width = 80
						align = right
						raw_text = "#T Tax Base#!"

						tooltipwidget = {
							ContextualTooltipType = {
								blockoverride "tooltip_title" {
									ContextualTooltipHeader = {
										blockoverride "title_icon" {
											icon = {
												using = tooltip_title_icon_size
												texture = "gfx/interface/icons/location_icons/tax_base.dds"
											}
										}
										blockoverride "title_text" { raw_text = "Tax Base Income" }
										blockoverride "concept_link" { text = "[tax_base|e]" }
									}
								}
								blockoverride "tooltip_content" {
									text_multi = {
										layoutpolicy_horizontal = expanding
										max_width = 350
										raw_text = "Income from the location's base economic output before wages are added. This represents rents, land revenue, and other non-labor income, distributed among pop types by their [wealth_share|e]."
									}
								}
							}
						}
					}
					text_single = {
						min_width = 80
						max_width = 80
						align = right
						raw_text = "#T Wages#!"

						tooltipwidget = {
							ContextualTooltipType = {
								blockoverride "tooltip_title" {
									ContextualTooltipHeader = {
										blockoverride "title_icon" {
											icon = {
												using = tooltip_title_icon_size
												texture = "gfx/interface/icons/resources/gold.dds"
											}
										}
										blockoverride "title_text" { raw_text = "Wage Income" }
										blockoverride "concept_link" {  }
									}
								}
								blockoverride "tooltip_content" {
									text_multi = {
										layoutpolicy_horizontal = expanding
										max_width = 350
										raw_text = "Additional income earned through labor, scaled by [market_access|e]. Each pop earns wages based on their role: #T Nobles#! @gold!5.0 #T Clergy#! @gold!2.0 #T Burghers#! @gold!1.0 #T Soldiers#! @gold!0.5 #T Laborers#! @gold!0.25 #T Peasants#! @gold!0.05. Wages are added to the pop demand budget and distributed to [estates|e] based on local [estate_power|e]."
									}
								}
							}
						}
					}
					text_single = {
						min_width = 80
						max_width = 80
						align = right
						raw_text = "#T Budget#!"

						tooltipwidget = {
							ContextualTooltipType = {
								blockoverride "tooltip_title" {
									ContextualTooltipHeader = {
										blockoverride "title_icon" {
											icon = {
												using = tooltip_title_icon_size
												texture = "gfx/interface/icons/resources/gold.dds"
											}
										}
										blockoverride "title_text" { raw_text = "Spending Budget" }
										blockoverride "concept_link" {  }
									}
								}
								blockoverride "tooltip_content" {
									text_multi = {
										layoutpolicy_horizontal = expanding
										max_width = 350
										raw_text = "Total income available for purchasing goods (#T Tax Base + Wages#!). This determines what goods each pop type demands and in what quantities. Hover over a pop's budget value to see a detailed breakdown by good."
									}
								}
							}
						}
					}
				}
			}

			# Nobles
			TooltipManualTableField = {
				visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sul_noble_share_pct'), '(CFixedPoint)0.0001')]"

				blockoverride "field_content" {
					icon = {
						size = { 20 20 }
						texture = "[GetGraphicalCultureTextureForPopType(GetPopTypeByName('nobles'))]"
					}

					text_single = {
						layoutpolicy_horizontal = expanding
						margin_left = 5
						raw_text = "Nobles"
					}
					text_single = {
						min_width = 80
						max_width = 80
						align = right
						raw_text = "[Location.MakeScope.ScriptValue('sul_noble_share_pct')|0]%"
					}
					text_single = {
						min_width = 80
						max_width = 80
						align = right
						raw_text = "[Location.MakeScope.ScriptValue('sul_noble_tax_income')|2]@gold!"
					}
					text_single = {
						min_width = 80
						max_width = 80
						align = right
						raw_text = "[Subtract_CFixedPoint(Location.MakeScope.ScriptValue('sul_noble_rents_wages'), Location.MakeScope.ScriptValue('sul_noble_tax_income'))|2]@gold!"
					}
					text_single = {
						min_width = 80
						max_width = 80
						align = right
						raw_text = "[Location.MakeScope.ScriptValue('sul_noble_rents_wages')|2]@gold!"

						tooltipwidget = {
							ContextualTooltipType = {
								blockoverride "tooltip_title" {  }
								blockoverride "tooltip_content" {
									TooltipListBase = {
										max_update_rate = 30

										TooltipTableHeader = {
											blockoverride "tableheader_text" { raw_text = "#T Nobles — Demand Breakdown#!" }
										}

										TooltipListScrollArea = {
											blockoverride "block_scrollarea" {
												maximumsize = { -1 600 }
												minimumsize = { -1 30 }
											}
											blockoverride "scrollarea_content" {
												TooltipListRowContent = {
													ignoreinvisible = yes
													set_parent_dimension_to_minimum = height

													TooltipManualTableField = {
														visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sul_nobles_necessity'), '(CFixedPoint)0.0001')]"

														blockoverride "field_content" {
															text_single = {
																layoutpolicy_horizontal = expanding
																raw_text = "#T Necessity#!"
															}
														}
													}

													TooltipListRowContent = {
														visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sul_nobles_necessity'), '(CFixedPoint)0.0001')]"
														max_update_rate = 30
														datamodel = "[GetGlobalMapKeys('sul_da_necessity')]"

														item = {
															TooltipManualTableField = {
																blockoverride "field_content" {
																	datacontext = "[Scope.GetGoods]"

																	icon = {
																		size = { 20 20 }
																		texture = "[GetGoodsIcon(Goods.Self)]"
																	}

																	text_single = {
																		layoutpolicy_horizontal = expanding
																		margin_left = 3
																		text = "[Goods.GetName]"
																	}
																	text_single = {
																		min_width = 60
																		align = right
																		raw_text = "[Multiply_CFixedPoint(GetVariableFromGlobalVariableMap('sul_da_necessity', Goods.MakeScope).GetValue, Location.MakeScope.ScriptValue('sul_nobles_necessity'))|4]"
																	}
																}
															}
														}
													}

													TooltipManualTableField = {
														visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sul_nobles_basic'), '(CFixedPoint)0.0001')]"

														blockoverride "field_content" {
															text_single = { layoutpolicy_horizontal = expanding raw_text = "#T Basic#!" }
														}
													}

													TooltipListRowContent = {
														visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sul_nobles_basic'), '(CFixedPoint)0.0001')]"
														max_update_rate = 30
														datamodel = "[GetGlobalMapKeys('sul_da_basic')]"

														item = {
															TooltipManualTableField = {
																blockoverride "field_content" {
																	datacontext = "[Scope.GetGoods]"

																	icon = {
																		size = { 20 20 }
																		texture = "[GetGoodsIcon(Goods.Self)]"
																	}

																	text_single = {
																		layoutpolicy_horizontal = expanding
																		margin_left = 3
																		text = "[Goods.GetName]"
																	}
																	text_single = {
																		min_width = 60
																		align = right
																		raw_text = "[Multiply_CFixedPoint(GetVariableFromGlobalVariableMap('sul_da_basic', Goods.MakeScope).GetValue, Location.MakeScope.ScriptValue('sul_nobles_basic'))|4]"
																	}
																}
															}
														}
													}

													TooltipManualTableField = {
														visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sul_nobles_common'), '(CFixedPoint)0.0001')]"

														blockoverride "field_content" {
															text_single = { layoutpolicy_horizontal = expanding raw_text = "#T Common#!" }
														}
													}

													TooltipListRowContent = {
														visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sul_nobles_common'), '(CFixedPoint)0.0001')]"
														max_update_rate = 30
														datamodel = "[GetGlobalMapKeys('sul_da_common')]"

														item = {
															TooltipManualTableField = {
																blockoverride "field_content" {
																	datacontext = "[Scope.GetGoods]"

																	icon = {
																		size = { 20 20 }
																		texture = "[GetGoodsIcon(Goods.Self)]"
																	}

																	text_single = {
																		layoutpolicy_horizontal = expanding
																		margin_left = 3
																		text = "[Goods.GetName]"
																	}
																	text_single = {
																		min_width = 60
																		align = right
																		raw_text = "[Multiply_CFixedPoint(GetVariableFromGlobalVariableMap('sul_da_common', Goods.MakeScope).GetValue, Location.MakeScope.ScriptValue('sul_nobles_common'))|4]"
																	}
																}
															}
														}
													}

													TooltipManualTableField = {
														visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sul_nobles_upper'), '(CFixedPoint)0.0001')]"

														blockoverride "field_content" {
															text_single = { layoutpolicy_horizontal = expanding raw_text = "#T Upper#!" }
														}
													}

													TooltipListRowContent = {
														visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sul_nobles_upper'), '(CFixedPoint)0.0001')]"
														max_update_rate = 30
														datamodel = "[GetGlobalMapKeys('sul_da_upper')]"

														item = {
															TooltipManualTableField = {
																blockoverride "field_content" {
																	datacontext = "[Scope.GetGoods]"

																	icon = {
																		size = { 20 20 }
																		texture = "[GetGoodsIcon(Goods.Self)]"
																	}

																	text_single = {
																		layoutpolicy_horizontal = expanding
																		margin_left = 3
																		text = "[Goods.GetName]"
																	}
																	text_single = {
																		min_width = 60
																		align = right
																		raw_text = "[Multiply_CFixedPoint(GetVariableFromGlobalVariableMap('sul_da_upper', Goods.MakeScope).GetValue, Location.MakeScope.ScriptValue('sul_nobles_upper'))|4]"
																	}
																}
															}
														}
													}

													TooltipManualTableField = {
														visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sul_nobles_luxury'), '(CFixedPoint)0.0001')]"

														blockoverride "field_content" {
															text_single = { layoutpolicy_horizontal = expanding raw_text = "#T Luxury#!" }
														}
													}

													TooltipListRowContent = {
														visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sul_nobles_luxury'), '(CFixedPoint)0.0001')]"
														max_update_rate = 30
														datamodel = "[GetGlobalMapKeys('sul_da_luxury')]"

														item = {
															TooltipManualTableField = {
																blockoverride "field_content" {
																	datacontext = "[Scope.GetGoods]"

																	icon = {
																		size = { 20 20 }
																		texture = "[GetGoodsIcon(Goods.Self)]"
																	}

																	text_single = {
																		layoutpolicy_horizontal = expanding
																		margin_left = 3
																		text = "[Goods.GetName]"
																	}
																	text_single = {
																		min_width = 60
																		align = right
																		raw_text = "[Multiply_CFixedPoint(GetVariableFromGlobalVariableMap('sul_da_luxury', Goods.MakeScope).GetValue, Location.MakeScope.ScriptValue('sul_nobles_luxury'))|4]"
																	}
																}
															}
														}
													}

													TooltipManualTableField = {
														visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sul_nobles_exotic'), '(CFixedPoint)0.0001')]"

														blockoverride "field_content" {
															text_single = { layoutpolicy_horizontal = expanding raw_text = "#T Exotic#!" }
														}
