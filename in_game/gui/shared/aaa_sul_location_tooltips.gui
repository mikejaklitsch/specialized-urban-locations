
template sul_nobles_demand_breakdown_tooltip {
	tooltipwidget = {
		ContextualTooltipType = {
			blockoverride "tooltip_title" {  }
			blockoverride "tooltip_content" {
				TooltipListBase = {
					max_update_rate = 30

					TooltipTableHeader = { blockoverride "tableheader_text" { raw_text = "#T Nobles — Demand Breakdown#!" } }

					TooltipListScrollArea = {
						blockoverride "block_scrollarea" { maximumsize = { -1 600 } minimumsize = { -1 30 } }
						blockoverride "scrollarea_content" {
							TooltipListRowContent = {
								TooltipManualTableField = {
									visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sul_nobles_necessity'), '(CFixedPoint)0')]"
									blockoverride "field_content" { text_single = { layoutpolicy_horizontal = expanding raw_text = "#T Necessity#!" } }
								}

								TooltipListRowContent = {
									visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sul_nobles_necessity'), '(CFixedPoint)0')]"
									max_update_rate = 30
									datamodel = "[GetGlobalMapKeys('sul_da_necessity')]"

									item = {
										TooltipManualTableField = {
											blockoverride "field_content" {
												datacontext = "[Scope.GetGoods]"

												icon = { size = { 20 20 } texture = "[GetGoodsIcon(Goods.Self)]" }

												text_single = {
													layoutpolicy_horizontal = expanding
													margin_left = 3
													text = "[Goods.GetName]"
												}
												text_single = {
													min_width = 60
													align = right
													raw_text = "[Multiply_CFixedPoint(GetVariableFromGlobalVariableMap('sul_da_necessity', Goods.MakeScope).GetValue, Location.MakeScope.ScriptValue('sul_nobles_necessity'))|2]"
