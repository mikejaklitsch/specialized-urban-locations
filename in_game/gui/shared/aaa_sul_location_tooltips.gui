							text_single = {
								align = right
								raw_text = "[LocationView.GetLocation.MakeScope.ScriptValue('sul_map_asset_crown')|2]@gold! (#green [LocationView.GetLocation.MakeScope.ScriptValue('sul_wealth_delta_crown')|+=2]@gold!#!)"
							}
						}
					}
				}
			}
		}
	}
}

