																	}
																	text_single = {
																		min_width = 60
																		align = right
																		raw_text = "[Multiply_CFixedPoint(GetVariableFromGlobalVariableMap('sul_da_exotic', Goods.MakeScope).GetValue, Location.MakeScope.ScriptValue('sul_nobles_exotic'))|4]"
																	}
																}
															}
														}
													}
												}
											}
										}
									}
								}
							}
						}
					}
				}
			}

			# Clergy
			TooltipManualTableField = {
				visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sul_clergy_share_pct'), '(CFixedPoint)0.0001')]"

				blockoverride "field_content" {
					icon = {
						size = { 20 20 }
						texture = "[GetGraphicalCultureTextureForPopType(GetPopTypeByName('clergy'))]"
					}

					text_single = {
						layoutpolicy_horizontal = expanding
						margin_left = 5
						raw_text = "Clergy"
