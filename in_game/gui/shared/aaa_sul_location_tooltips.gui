									item = {
										TooltipManualTableField = {
											blockoverride "field_content" {
												datacontext = "[Scope.GetGoods]"

												icon = { size = { 20 20 } texture = "[GetGoodsIcon(Goods.Self)]" }

												text_single = {
													layoutpolicy_horizontal = expanding
													margin_left = 3
													text = "[Goods.GetName]"
												}
												text_single = {
													min_width = 60
													align = right
													raw_text = "[Multiply_CFixedPoint(GetVariableFromGlobalVariableMap('sul_da_exotic', Goods.MakeScope).GetValue, Location.MakeScope.ScriptValue('sul_peasants_exotic'))|2]"
												}
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}
}

