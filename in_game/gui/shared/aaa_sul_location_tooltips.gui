								raw_text = "[LocationView.GetLocation.MakeScope.ScriptValue('sul_map_asset_tribes')|3]@gold! (#green [LocationView.GetLocation.MakeScope.ScriptValue('sul_wealth_delta_tribes')|+=2]@gold!#!)"
							}
						}
					}
					TooltipManualTableField = {
						blockoverride "field_content" {
							icon = {
								size = { 10 20 }
								texture = "gfx/interface/component_tiles/bookmark_white.dds"

								tintcolor = {
									0.54
									0.36
									0.80
									1
								}
							}

							text_single = { default_format = "#subtle_name" raw_text = "Crown" }
							expand = {  }

							text_single = {
								align = right
								raw_text = "[LocationView.GetLocation.MakeScope.ScriptValue('sul_map_asset_crown')|3]@gold! (#green [LocationView.GetLocation.MakeScope.ScriptValue('sul_wealth_delta_crown')|+=2]@gold!#!)"
							}
						}
					}
				}
			}
		}
	}
}

template sul_wage_pool_breakdown_tooltip {
	tooltipwidget = {
		ContextualTooltipType = {
			blockoverride "tooltip_title" {
				ContextualTooltipHeader = { blockoverride "title_text" { raw_text = "GDP Wage Pool" } }
			}
			blockoverride "tooltip_content" {
				TooltipListBase = {
					TooltipTableHeader = {
						blockoverride "tableheader_text" { raw_text = "#T Wage Share ([Location.MakeScope.ScriptValue('sul_wage_share_pct')|0]%)#!" }
					}

					TooltipManualTableField = {
						blockoverride "field_content" {
							text_single = { layoutpolicy_horizontal = expanding raw_text = "Base" }
							text_single = {
								align = right
								min_width = 80
								raw_text = "50%"
							}
						}
					}
					TooltipManualTableField = {
						blockoverride "field_content" {
							text_single = { layoutpolicy_horizontal = expanding raw_text = "× Urbanization" }
							text_single = {
								align = right
								min_width = 80
								raw_text = "×[Location.MakeScope.ScriptValue('sul_wage_share_dev_factor')|3] ([Location.MakeScope.ScriptValue('sul_wage_share_dev_pct')|0] dev)"
