
template location_tax_base_details {
	hbox = {
		layoutpolicy_horizontal = expanding
		spacing = 10

		widget = { ### POWER PIECHART
			size = { 100 100 }
			using = marker_bg_circle

			icon_pie_left = {
				parentanchor = center
				blockoverride "PieSize" { size = { 90% 90% } }
				blockoverride "pie_datamodel" { datamodel = "[DataModelSkipFirst(Location.GetOwner.GetGovernment.GetEstates, '(int32)1')]" }

				blockoverride "SliceTooltip" {
					tooltipwidget = {
						SimpleContextualTooltipType = {
							blockoverride "title_icon" {
								icon = { using = tooltip_title_icon_size texture = "gfx/interface/icons/location_icons/tax_base.dds" }
							}
							blockoverride "title_text" { text = "TAX_BASE_TT_ESTATES_LIST_SHARE_TITLE" }
							blockoverride "concept_link" { text = "[wealth_share|e]" }
							textcontext = "TAX_BASE_TT_ESTATES_LIST_SHARE"
						}
					}
				}
				blockoverride "SliceValue" { value = "[Location.GetEstateTaxBasePercent(Estate.Self)]" }
				blockoverride "SliceColor" { color = "[Estate.GetType.GetMapColor]" }
				blockoverride "Icon" { texture = "[GetConceptTexture('wealth')]" }
				blockoverride "Icon_Size" { size = { 55% 55% } }
				blockoverride "datamodel" { visible = no }
			}

			tooltip = "[wealth_share]"
			tagtooltip_enabled = yes
		}

		vbox = {
			spacing = 10

			TooltipListBase = { ### SIDE TABLE
				TooltipListRowContent = {
					TooltipManualTableField = {
						blockoverride "field_content" {
							text_single = { text = "[wealth|e]" }
							expand = {  }

							text_single = {
								raw_text = "[Location.GetTotalPossibleTaxBase|W2] [wealth_icon]"
								tagtooltip_enabled = yes
								tooltip = "[wealth|e]"
							}
						}
					}
					TooltipManualTableField = {
						blockoverride "field_content" {
							text_single = { text = "TAX_BASE_TT_LIST" tooltipwidget = { using = location_control_tooltip } }

							expand = {  }

							text_single = {
								raw_text = "[Location.GetTotalTaxBase|W2] [tax_base_icon]"
								tagtooltip_enabled = yes
								tooltip = "[tax_base|e]"
							}
						}
					}
				}
			}

			TooltipStringPairList = {
				visible = "[Location.HasOwner]"
				textcontext = "TAX_BASE_PEASANT_ENFRANCH"

				tooltipwidget = {
					SimpleContextualStringPairTooltipType = {
						blockoverride "title_icon" {
							icon = { using = tooltip_title_icon_size texture = "[GetConceptTexture('peasant_enfranchisement')]" }
						}
						blockoverride "concept_link" { text = "[peasant_enfranchisement|e]" }
						lowpriotextcontext = "[Location.GetPeasantEnfranchismentInfo]"
					}
				}
			}
		}
	}

	### VANILLA ESTATES TABLE (restored exactly)

	TooltipListBase = {
		visible = "[GreaterThan_CFixedPoint(Location.GetTotalPossibleTaxBase, '(CFixedPoint)0.0001')]"
		blockoverride "block_title" { text = "TAX_BASE_TT_ESTATES_LIST_TITLE" }

		TooltipListColumnContent = {
			TooltipTableColumn = {
				blockoverride "column_title" {  }
				blockoverride "column_title_text" { text = "[estates|e]" }
				blockoverride "column_title_right" { expand = {  } }

				blockoverride "field_left" {
					visible = "[Estate.ExistsForCountry]"
					tooltipwidget = { using = Estate_tooltip }

					icon = {
						size = { 10 20 }
						texture = "gfx/interface/component_tiles/bookmark_white.dds"
						tintcolor = "[Estate.GetType.GetMapColor]"
					}
				}
				blockoverride "field_text" {
					default_format = "#subtle_name"
					align = left|nobaseline
					raw_text = "[Estate.GetName]"
				}
				blockoverride "field_right" { expand = {  } }
			}

			TooltipTableColumn = {
				blockoverride "column_title" {  }
				blockoverride "column_title_left" { expand = {  } }
				blockoverride "column_title_text" { text = "[wealth_share|e]" }

				blockoverride "field_left" {
					expand = {  }
					visible = "[Estate.ExistsForCountry]"

					tooltipwidget = {
						SimpleContextualTooltipType = {
							blockoverride "title_icon" { icon = { using = tooltip_title_icon_size texture = "[GetConceptTexture('wealth')]" } }
							blockoverride "title_text" { text = "TAX_BASE_TT_ESTATES_LIST_SHARE_TITLE" }
							blockoverride "concept_link" { text = "[wealth_share|e]" }
							textcontext = "TAX_BASE_TT_ESTATES_LIST_SHARE"
						}
					}
				}
				blockoverride "field_text" {
					visible = "[Estate.ExistsForCountry]"
					raw_text = "[Multiply_CFixedPoint(Location.GetTotalPossibleTaxBase, Location.GetEstateTaxBasePercent(Estate.Self))|2]@gold! ([Location.GetEstateTaxBasePercent(Estate.Self)|0%])"
				}
			}

			TooltipTableColumn = {
				blockoverride "column_title" {  }
				blockoverride "column_title_left" { expand = {  } }
				blockoverride "column_title_text" { text = "[tax_base|e]" }

				blockoverride "field_left" {
					expand = {  }
					visible = "[Estate.ExistsForCountry]"

					tooltipwidget = {
						SimpleContextualTooltipType = {
							blockoverride "title_icon" {
								icon = { using = tooltip_title_icon_size texture = "gfx/interface/icons/location_icons/tax_base.dds" }
							}
							blockoverride "title_text" { text = "TAX_BASE_TT_ESTATES_LIST_SHARE_TITLE" }
							blockoverride "concept_link" { text = "[wealth_share|e]" }
							textcontext = "TAX_BASE_TT_ESTATES_LIST_SHARE"
						}
					}
				}
				blockoverride "field_text" {
					visible = "[Estate.ExistsForCountry]"
					raw_text = "[Location.GetEstateTaxBase(Estate.Self)|2L]@tax_base!"
				}
			}

			TooltipTableColumn = {
				blockoverride "column_title" {  }
				blockoverride "column_title_left" { expand = {  } }
				blockoverride "column_title_text" { text = "[tax_rate|e]" }

				blockoverride "field_left" {
					expand = {  }
					visible = "[Estate.ExistsForCountry]"

					tooltipwidget = {
						SimpleContextualTooltipType = {
							blockoverride "title_icon" { icon = { using = tooltip_title_icon_size texture = "gfx/interface/icons/resources/gold.dds" } }
							blockoverride "title_text" { text = "TAX_BASE_TT_ESTATES_LIST_TAXED_TITLE" }
							blockoverride "concept_link" { text = "[taxes|e]" }
							textcontext = "TAX_BASE_TT_ESTATES_LIST_TAXED"
						}
					}
				}
				blockoverride "field_text" {
					visible = "[Estate.ExistsForCountry]"
					text = "[Location.GetOwner.GetEconomy.GetTaxRate(Estate.GetType)|2%]"
				}
			}

			TooltipTableColumn = {
				blockoverride "column_title" {  }
				blockoverride "column_title_left" { expand = {  } }
				blockoverride "column_title_text" {
					text = "TAX_BASE_TT_ESTATES_LIST_INCOME_TITLE"
					default_format = "#explanation_link"
					tooltip = "[tax|e]"
					tagtooltip_enabled = yes
				}

				blockoverride "field_left" {
					expand = {  }
					visible = "[Estate.ExistsForCountry]"

					tooltipwidget = {
						SimpleContextualTooltipType = {
							blockoverride "title_icon" { icon = { using = tooltip_title_icon_size texture = "gfx/interface/icons/resources/gold.dds" } }
							blockoverride "title_text" { text = "TAX_BASE_TT_ESTATES_LIST_TAXED_TITLE" }
							blockoverride "concept_link" { text = "[taxes|e]" }
							textcontext = "TAX_BASE_TT_ESTATES_LIST_TAXED"
						}
					}
				}
				blockoverride "field_text" {
					visible = "[Estate.ExistsForCountry]"
					raw_text = "[Multiply_CFixedPoint(Location.GetOwner.GetEconomy.GetTaxRate(Estate.GetType), Location.GetEstateTaxBase(Estate.Self))|+=2]@income!"
				}
			}

			blockoverride "column_datamodel" { datamodel = "[DataModelSkipFirst(Location.GetOwner.GetGovernment.GetEstates, '(int32)1')]" }
		}
	}

	TooltipStringPairList = { visible = "[Location.HasOwner]" textcontext = "TAX_BASE_TT_TEXT" }

	### WPDO: POP DEMAND BUDGET

	TooltipListBase = {
		visible = "[Location.MakeScope.GetVariable('sul_local_gdp').IsSet]"
		max_update_rate = 30

		TooltipTableHeader = { blockoverride "tableheader_text" { raw_text = "#T Pop Demand Per 1k Pops#!" } }

		TooltipListRowContent = {
			TooltipManualTableField = {
				blockoverride "field_content" {
					text_single = {
						layoutpolicy_horizontal = expanding
						margin_left = 5
						raw_text = "#T Pop Type#!"

						tooltipwidget = {
							SimpleContextualTooltipType = {
								blockoverride "title_text" { raw_text = "Pop Demand Per 1k Pops" }
								textcontext = "SUL_TT_DEMAND_PER_POP"
							}
						}
					}
					text_single = {
						min_width = 70
						max_width = 70
						align = right
						raw_text = "#T Wages#!"

						tooltipwidget = {
							SimpleContextualTooltipType = { blockoverride "title_text" { raw_text = "Wages" } textcontext = "SUL_TT_WAGES" }
						}
					}
					text_single = {
						min_width = 70
						max_width = 70
						align = right
						raw_text = "#T Returns#!"

						tooltipwidget = {
							SimpleContextualTooltipType = {
								blockoverride "title_text" { raw_text = "Capital Returns" }
								textcontext = "SUL_TT_CAPITAL_RETURNS"
							}
						}
					}
					text_single = {
						min_width = 70
						max_width = 70
						align = right
						raw_text = "#T Enrichment#!"

						tooltipwidget = {
							SimpleContextualTooltipType = { blockoverride "title_text" { raw_text = "Enrichment" } textcontext = "SUL_TT_ENRICHMENT" }
						}
					}
					text_single = {
						min_width = 70
						max_width = 70
						align = right
						raw_text = "#T WPP#!"

						tooltipwidget = {
							SimpleContextualTooltipType = { blockoverride "title_text" { raw_text = "Wealth Per 1k Pops" } textcontext = "SUL_TT_WPP" }
						}
					}
				}
			}

			# Nobles
			TooltipManualTableField = {
				visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sul_noble_demand_per_pop'), '(CFixedPoint)0.0001')]"
				blockoverride "field_content" {
					icon = {
						size = { 20 20 }
						texture = "[GetGraphicalCultureTextureForPopType(GetPopTypeByName('nobles'))]"
					}

					text_single = {
						layoutpolicy_horizontal = expanding
						margin_left = 5
						raw_text = "Nobles"
					}
					text_single = {
						min_width = 70
						max_width = 70
						align = right
						raw_text = "[Location.MakeScope.ScriptValue('sul_noble_wage_rate')|3]@gold!"

						tooltipwidget = {
							ContextualTooltipType = {
								blockoverride "title_icon" {
									icon = {
										using = tooltip_title_icon_size
										texture = "[GetGraphicalCultureTextureForPopType(GetPopTypeByName('nobles'))]"
									}
								}
								blockoverride "tooltip_title" {
									ContextualTooltipHeader = { blockoverride "title_text" { raw_text = "Nobles Wages" } }
								}
								blockoverride "tooltip_content" {
									TooltipListBase = {
										TooltipManualTableField = {
											blockoverride "field_content" {
												text_single = { layoutpolicy_horizontal = expanding raw_text = "GDP × Wage Share" }
												text_single = {
													align = right
													min_width = 100
													raw_text = "[Location.MakeScope.ScriptValue('sul_wage_pool_total')|3]@gold!"
													using = sul_wage_pool_breakdown_tooltip
												}
											}
										}
										TooltipManualTableField = {
											blockoverride "field_content" {
												text_single = { layoutpolicy_horizontal = expanding raw_text = "× Estate Power" }
												text_single = {
													align = right
													min_width = 100
													raw_text = "×[Multiply_CFixedPoint(Location.MakeScope.ScriptValue('sul_noble_power_share'), '(CFixedPoint)100')|0]%"
												}
											}
										}
										TooltipManualTableField = {
											blockoverride "field_content" {
												text_single = { layoutpolicy_horizontal = expanding raw_text = "÷ Nobles" }
												text_single = {
													align = right
													min_width = 100
													raw_text = "÷[Location.MakeScope.ScriptValue('sul_pop_count_nobles')|3]"
												}
											}
										}
										TooltipManualTableField = {
											blockoverride "field_content" {
												text_single = { layoutpolicy_horizontal = expanding raw_text = "#bold = Per 1k Wage#!" }
												text_single = {
													align = right
													min_width = 100
													raw_text = "#bold [Location.MakeScope.ScriptValue('sul_noble_wage_rate')|3]@gold!#!"
												}
											}
										}
									}
								}
							}
						}
					}
					text_single = {
						min_width = 70
						max_width = 70
						align = right
						raw_text = "[Location.MakeScope.ScriptValue('sul_noble_total_return')|3]@gold!"

						tooltipwidget = {
							ContextualTooltipType = {
								blockoverride "title_icon" {
									icon = {
										using = tooltip_title_icon_size
										texture = "[GetGraphicalCultureTextureForPopType(GetPopTypeByName('nobles'))]"
									}
								}
								blockoverride "tooltip_title" {
									ContextualTooltipHeader = { blockoverride "title_text" { raw_text = "Nobles Capital Returns" } }
								}
								blockoverride "tooltip_content" {
									TooltipListBase = {
										TooltipManualTableField = {
											blockoverride "field_content" {
												text_single = { layoutpolicy_horizontal = expanding raw_text = "Estate Assets" }
												text_single = {
													align = right
													min_width = 100
													raw_text = "[Location.MakeScope.ScriptValue('sul_map_asset_nobles')|3]@gold!"
												}
											}
										}
										TooltipManualTableField = {
											blockoverride "field_content" {
												text_single = { layoutpolicy_horizontal = expanding raw_text = "Return Rate" }
												text_single = {
													align = right
													min_width = 100
													raw_text = "×5%"
												}
											}
										}
										TooltipManualTableField = {
											blockoverride "field_content" {
												text_single = { layoutpolicy_horizontal = expanding raw_text = "× Estate Power" }
												text_single = {
													align = right
													min_width = 100
													raw_text = "×[Multiply_CFixedPoint(Location.MakeScope.ScriptValue('sul_noble_power_share'), '(CFixedPoint)100')|0]%"
												}
											}
										}
										TooltipManualTableField = {
											blockoverride "field_content" {
												text_single = { layoutpolicy_horizontal = expanding raw_text = "÷ Nobles" }
												text_single = {
													align = right
													min_width = 100
													raw_text = "÷[Location.MakeScope.ScriptValue('sul_pop_count_nobles')|3]"
												}
											}
										}
										TooltipManualTableField = {
											blockoverride "field_content" {
												text_single = { layoutpolicy_horizontal = expanding raw_text = "#bold = Local Return#!" }
												text_single = {
													align = right
													min_width = 100
													raw_text = "#G +[Location.MakeScope.ScriptValue('sul_noble_capital_return')|3]#!@gold!"
												}
											}
										}
										TooltipManualTableField = {
											visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sul_noble_dhimmi_return'), '(CFixedPoint)0')]"
											blockoverride "field_content" {
												text_single = { layoutpolicy_horizontal = expanding raw_text = "Dhimmi Assets" }
												text_single = {
													align = right
													min_width = 100
													raw_text = "[Location.MakeScope.ScriptValue('sul_map_asset_dhimmi')|3]@gold!"
												}
											}
										}
										TooltipManualTableField = {
											visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sul_noble_dhimmi_return'), '(CFixedPoint)0')]"
											blockoverride "field_content" {
												text_single = { layoutpolicy_horizontal = expanding raw_text = "× Power Share" }
												text_single = {
													align = right
													min_width = 100
													raw_text = "[Multiply_CFixedPoint(Location.MakeScope.ScriptValue('sul_noble_power_share'), '(CFixedPoint)100')|0]%"
												}
											}
										}
										TooltipManualTableField = {
											visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sul_noble_dhimmi_return'), '(CFixedPoint)0')]"
											blockoverride "field_content" {
												text_single = { layoutpolicy_horizontal = expanding raw_text = "#bold Dhimmi Return#!" }
												text_single = {
													align = right
													min_width = 100
													raw_text = "#G +[Location.MakeScope.ScriptValue('sul_noble_dhimmi_return')|3]#!@gold!"
												}
											}
										}
										TooltipManualTableField = {
											blockoverride "field_content" {
												text_single = { layoutpolicy_horizontal = expanding raw_text = "#G + National Return#!" }
												text_single = {
													align = right
													min_width = 100
													raw_text = "#G +[Location.MakeScope.ScriptValue('sul_noble_national_return')|3]@gold!#!"

													tooltipwidget = {
														ContextualTooltipType = {
															blockoverride "tooltip_title" {
																ContextualTooltipHeader = { blockoverride "title_text" { raw_text = "Nobles National Return" } }
															}
															blockoverride "tooltip_content" {
																TooltipListBase = {
																	TooltipManualTableField = {
																		blockoverride "field_content" {
																			text_single = { layoutpolicy_horizontal = expanding raw_text = "Estate Treasury" }
																			text_single = {
																				align = right
																				min_width = 100
																				raw_text = "[Location.MakeScope.ScriptValue('sul_estate_treasury_nobles')|3]@gold!"
																			}
																		}
																	}
																	TooltipManualTableField = {
																		blockoverride "field_content" {
																			text_single = { layoutpolicy_horizontal = expanding raw_text = "× Return Rate" }
																			text_single = {
																				align = right
																				min_width = 100
																				raw_text = "×2.5%"
																			}
																		}
																	}
																	TooltipManualTableField = {
																		blockoverride "field_content" {
																			text_single = { layoutpolicy_horizontal = expanding raw_text = "÷ National Nobles" }
																			text_single = {
																				align = right
																				min_width = 100
																				raw_text = "÷[Location.MakeScope.ScriptValue('sul_national_pop_nobles')|3]"
																			}
																		}
																	}
																	TooltipManualTableField = {
																		blockoverride "field_content" {
																			text_single = { layoutpolicy_horizontal = expanding raw_text = "#bold = Per 1k Return#!" }
																			text_single = {
																				align = right
																				min_width = 100
																				raw_text = "#bold #G +[Location.MakeScope.ScriptValue('sul_noble_national_return')|3]#!@gold!#!"
																			}
																		}
																	}
																}
															}
														}
													}
												}
											}
										}
										TooltipManualTableField = {
											blockoverride "field_content" {
												text_single = { layoutpolicy_horizontal = expanding raw_text = "#bold = Total Return#!" }
												text_single = {
													align = right
													min_width = 100
													raw_text = "#bold #G +[Location.MakeScope.ScriptValue('sul_noble_total_return')|3]#!@gold!#!"
												}
											}
										}
									}
								}
							}
						}
					}
					text_single = {
						min_width = 70
						max_width = 70
						align = right
						raw_text = "#R [Location.MakeScope.ScriptValue('sul_noble_enrichment_per_pop')|3]#!@gold!"

						tooltipwidget = {
							ContextualTooltipType = {
								blockoverride "title_icon" {
									icon = {
										using = tooltip_title_icon_size
										texture = "[GetGraphicalCultureTextureForPopType(GetPopTypeByName('nobles'))]"
									}
								}
								blockoverride "tooltip_title" {
									ContextualTooltipHeader = { blockoverride "title_text" { raw_text = "Nobles Enrichment" } }
								}
								blockoverride "tooltip_content" {
									TooltipListBase = {
										TooltipManualTableField = {
											blockoverride "field_content" {
												text_single = { layoutpolicy_horizontal = expanding raw_text = "#bold Enrichment Per 1k Pops#!" }
												text_single = {
													align = right
													min_width = 100
													raw_text = "#R [Location.MakeScope.ScriptValue('sul_noble_enrichment_per_pop')|3]#!@gold!"
												}
											}
										}
										TooltipManualTableField = {
											blockoverride "field_content" {
												text_single = { layoutpolicy_horizontal = expanding raw_text = "Estate Enrichment" }
												text_single = {
													align = right
													min_width = 100
													raw_text = "[Multiply_CFixedPoint(Location.MakeScope.ScriptValue('sul_estate_enrichment_display'), '(CFixedPoint)100')|0]%"
												}
											}
										}
										TooltipManualTableField = {
											blockoverride "field_content" {
												text_single = { layoutpolicy_horizontal = expanding raw_text = "Nobles Rate" }
												text_single = {
													align = right
													min_width = 100
													raw_text = "[Multiply_CFixedPoint(Location.MakeScope.ScriptValue('sul_noble_enrichment_rate_display'), '(CFixedPoint)100')|0]%"
												}
											}
										}
										TooltipManualTableField = {
											blockoverride "field_content" {
												text_single = { layoutpolicy_horizontal = expanding raw_text = "#bold Combined Rate#!" }
												text_single = {
													align = right
													min_width = 100
													raw_text = "[Multiply_CFixedPoint(Location.MakeScope.ScriptValue('sul_noble_enrichment_combined'), '(CFixedPoint)100')|0]%"
												}
											}
										}
									}
								}
							}
						}
					}
					text_single = {
						min_width = 70
						max_width = 70
						align = right
						raw_text = "[Location.MakeScope.ScriptValue('sul_noble_demand_per_pop')|3]@gold!"
						using = sul_nobles_demand_breakdown_tooltip
					}
				}
			}

			# Clergy
			TooltipManualTableField = {
				visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sul_clergy_demand_per_pop'), '(CFixedPoint)0.0001')]"
				blockoverride "field_content" {
					icon = {
						size = { 20 20 }
						texture = "[GetGraphicalCultureTextureForPopType(GetPopTypeByName('clergy'))]"
					}

					text_single = {
						layoutpolicy_horizontal = expanding
						margin_left = 5
