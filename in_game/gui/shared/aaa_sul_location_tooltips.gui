template sul_wealth_bar_tooltip {
	ContextualTooltipType = {
		blockoverride "title_icon" { icon = { using = tooltip_title_icon_size texture = "[GetConceptTexture('wealth')]" } }
		blockoverride "title_text" { raw_text = "#T [sul_location_assets|E]#!" }
		blockoverride "concept_link" { text = "[sul_location_assets|e]" }
		blockoverride "tooltip_content" {
			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 10

				widget = {
					size = { 100 100 }
					using = marker_bg_circle

					piechart = {
						parentanchor = center
						size = { 90% 90% }
						using = piechart_angles

						pieslice = {
							texture = "gfx/interface/pie_charts/pie_chart_alpha_80.dds"
							value = "[FixedPointToFloat(LocationView.GetLocation.MakeScope.ScriptValue('sul_wealth_share_nobles'))]"

							color = {
								0.33
								0.49
								0.80
								1
							}

							tooltip = "sul_wealth_slice_nobles"
						}
						pieslice = {
							texture = "gfx/interface/pie_charts/pie_chart_alpha_80.dds"
							value = "[FixedPointToFloat(LocationView.GetLocation.MakeScope.ScriptValue('sul_wealth_share_clergy'))]"

							color = {
								0.78
								0.82
								0.90
								1
							}

							tooltip = "sul_wealth_slice_clergy"
						}
						pieslice = {
							texture = "gfx/interface/pie_charts/pie_chart_alpha_80.dds"
							value = "[FixedPointToFloat(LocationView.GetLocation.MakeScope.ScriptValue('sul_wealth_share_burghers'))]"

							color = {
								0.79
								0.55
								0.10
								1
							}

							tooltip = "sul_wealth_slice_burghers"
