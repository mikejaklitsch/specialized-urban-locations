template location_tax_base_details {
	hbox = {
		layoutpolicy_horizontal = expanding
		spacing = 10

		widget = { ### POWER PIECHART
			size = { 100 100 }
			using = marker_bg_circle

			icon_pie_left = {
				parentanchor = center
				blockoverride "PieSize" { size = { 90% 90% } }
				blockoverride "pie_datamodel" {
					datamodel = "[DataModelSkipFirst(Location.GetOwner.GetGovernment.GetEstates, '(int32)1')]"
				}

				blockoverride "SliceTooltip" {
					tooltipwidget = {
						SimpleContextualTooltipType = {
							blockoverride "title_icon" {
								icon = {
									using = tooltip_title_icon_size
									texture = "gfx/interface/icons/location_icons/tax_base.dds"
								}
							}
							blockoverride "title_text" { text = "TAX_BASE_TT_ESTATES_LIST_SHARE_TITLE" }
							blockoverride "concept_link" { text = "[wealth_share|e]" }
							textcontext = "TAX_BASE_TT_ESTATES_LIST_SHARE"
						}
					}
				}
				blockoverride "SliceValue" { value = "[Location.GetEstateTaxBasePercent(Estate.Self)]" }
				blockoverride "SliceColor" { color = "[Estate.GetType.GetMapColor]" }
				blockoverride "Icon" { texture = "[GetConceptTexture('wealth')]" }
				blockoverride "Icon_Size" { size = { 55% 55% } }
				blockoverride "datamodel" { visible = no }
			}

			tooltip = "[wealth_share]"
			tagtooltip_enabled = yes
		}

		vbox = {
			spacing = 10

			TooltipListBase = { ### SIDE TABLE
				TooltipListRowContent = {
					TooltipManualTableField = {
						blockoverride "field_content" {
							text_single = { text = "[wealth|e]" }
							expand = {  }

							text_single = {
								raw_text = "[Location.GetTotalPossibleTaxBase|W2] [wealth_icon]"
								tagtooltip_enabled = yes
								tooltip = "[wealth|e]"
							}
						}
					}

					TooltipManualTableField = {
						blockoverride "field_content" {
							text_single = {
								text = "TAX_BASE_TT_LIST"
								tooltipwidget = { using = location_control_tooltip }
							}

							expand = {  }

							text_single = {
								raw_text = "[Location.GetTotalTaxBase|W2] [tax_base_icon]"
								tagtooltip_enabled = yes
								tooltip = "[tax_base|e]"
							}
						}
					}
				}
			}

			TooltipStringPairList = {
				visible = "[Location.HasOwner]"
				textcontext = "TAX_BASE_PEASANT_ENFRANCH"

				tooltipwidget = {
					SimpleContextualStringPairTooltipType = {
						blockoverride "title_icon" {
							icon = {
								using = tooltip_title_icon_size
								texture = "[GetConceptTexture('peasant_enfranchisement')]"
							}
						}
						blockoverride "concept_link" { text = "[peasant_enfranchisement|e]" }
						lowpriotextcontext = "[Location.GetPeasantEnfranchismentInfo]"
					}
				}
			}
		}
	}

	### VANILLA ESTATES TABLE (restored exactly)

	TooltipListBase = {
		visible = "[GreaterThan_CFixedPoint(Location.GetTotalPossibleTaxBase, '(CFixedPoint)0.0001')]"
		blockoverride "block_title" { text = "TAX_BASE_TT_ESTATES_LIST_TITLE" }

		TooltipListColumnContent = {
			TooltipTableColumn = {
				blockoverride "column_title" {  }
				blockoverride "column_title_text" { text = "[estates|e]" }
				blockoverride "column_title_right" { expand = {  } }

				blockoverride "field_left" {
					visible = "[Estate.ExistsForCountry]"
					tooltipwidget = { using = Estate_tooltip }

					icon = {
						size = { 10 20 }
						texture = "gfx/interface/component_tiles/bookmark_white.dds"
						tintcolor = "[Estate.GetType.GetMapColor]"
					}
				}
				blockoverride "field_text" {
					default_format = "#subtle_name"
					align = left|nobaseline
					raw_text = "[Estate.GetName]"
				}
				blockoverride "field_right" { expand = {  } }
			}

			TooltipTableColumn = {
				blockoverride "column_title" {  }
				blockoverride "column_title_left" { expand = {  } }
				blockoverride "column_title_text" { text = "[wealth_share|e]" }

				blockoverride "field_left" {
					expand = {  }
					visible = "[Estate.ExistsForCountry]"

					tooltipwidget = {
						SimpleContextualTooltipType = {
							blockoverride "title_icon" {
								icon = {
									using = tooltip_title_icon_size
									texture = "[GetConceptTexture('wealth')]"
								}
							}
							blockoverride "title_text" { text = "TAX_BASE_TT_ESTATES_LIST_SHARE_TITLE" }
							blockoverride "concept_link" { text = "[wealth_share|e]" }
							textcontext = "TAX_BASE_TT_ESTATES_LIST_SHARE"
						}
					}
				}
				blockoverride "field_text" {
					visible = "[Estate.ExistsForCountry]"
					raw_text = "[Multiply_CFixedPoint(Location.GetTotalPossibleTaxBase, Location.GetEstateTaxBasePercent(Estate.Self))|2]@gold! ([Location.GetEstateTaxBasePercent(Estate.Self)|0%])"
				}
			}

			TooltipTableColumn = {
				blockoverride "column_title" {  }
				blockoverride "column_title_left" { expand = {  } }
				blockoverride "column_title_text" { text = "[tax_base|e]" }

				blockoverride "field_left" {
					expand = {  }
					visible = "[Estate.ExistsForCountry]"

					tooltipwidget = {
						SimpleContextualTooltipType = {
							blockoverride "title_icon" {
								icon = {
									using = tooltip_title_icon_size
									texture = "gfx/interface/icons/location_icons/tax_base.dds"
								}
							}
							blockoverride "title_text" { text = "TAX_BASE_TT_ESTATES_LIST_SHARE_TITLE" }
							blockoverride "concept_link" { text = "[wealth_share|e]" }
							textcontext = "TAX_BASE_TT_ESTATES_LIST_SHARE"
						}
					}
				}
				blockoverride "field_text" {
					visible = "[Estate.ExistsForCountry]"
					raw_text = "[Location.GetEstateTaxBase(Estate.Self)|2L]@tax_base!"
				}
			}

			TooltipTableColumn = {
				blockoverride "column_title" {  }
				blockoverride "column_title_left" { expand = {  } }
				blockoverride "column_title_text" { text = "[tax_rate|e]" }

				blockoverride "field_left" {
					expand = {  }
					visible = "[Estate.ExistsForCountry]"

					tooltipwidget = {
						SimpleContextualTooltipType = {
							blockoverride "title_icon" {
								icon = {
									using = tooltip_title_icon_size
									texture = "gfx/interface/icons/resources/gold.dds"
								}
							}
							blockoverride "title_text" { text = "TAX_BASE_TT_ESTATES_LIST_TAXED_TITLE" }
							blockoverride "concept_link" { text = "[taxes|e]" }
							textcontext = "TAX_BASE_TT_ESTATES_LIST_TAXED"
						}
					}
				}
				blockoverride "field_text" {
					visible = "[Estate.ExistsForCountry]"
					text = "[Location.GetOwner.GetEconomy.GetTaxRate(Estate.GetType)|2%]"
				}
			}

			TooltipTableColumn = {
				blockoverride "column_title" {  }
				blockoverride "column_title_left" { expand = {  } }
				blockoverride "column_title_text" {
					text = "TAX_BASE_TT_ESTATES_LIST_INCOME_TITLE"
					default_format = "#explanation_link"
					tooltip = "[tax|e]"
					tagtooltip_enabled = yes
				}

				blockoverride "field_left" {
					expand = {  }
					visible = "[Estate.ExistsForCountry]"

					tooltipwidget = {
						SimpleContextualTooltipType = {
							blockoverride "title_icon" {
								icon = {
									using = tooltip_title_icon_size
									texture = "gfx/interface/icons/resources/gold.dds"
								}
							}
							blockoverride "title_text" { text = "TAX_BASE_TT_ESTATES_LIST_TAXED_TITLE" }
							blockoverride "concept_link" { text = "[taxes|e]" }
							textcontext = "TAX_BASE_TT_ESTATES_LIST_TAXED"
						}
					}
				}
				blockoverride "field_text" {
					visible = "[Estate.ExistsForCountry]"
					raw_text = "[Multiply_CFixedPoint(Location.GetOwner.GetEconomy.GetTaxRate(Estate.GetType), Location.GetEstateTaxBase(Estate.Self))|+=2]@income!"
				}
			}

			blockoverride "column_datamodel" {
				datamodel = "[DataModelSkipFirst(Location.GetOwner.GetGovernment.GetEstates, '(int32)1')]"
			}
		}
	}

	TooltipStringPairList = {
		visible = "[Location.HasOwner]"
		textcontext = "TAX_BASE_TT_TEXT"
	}

	### WPDO: POP DEMAND BUDGET

	TooltipListBase = {
		visible = "[Location.MakeScope.GetVariable('sul_local_gdp').IsSet]"
		max_update_rate = 30

		TooltipTableHeader = { blockoverride "tableheader_text" { raw_text = "#T Pop Demand Per Pop#!" } }

		TooltipListRowContent = {
			TooltipManualTableField = {
				blockoverride "field_content" {
					text_multi = { layoutpolicy_horizontal = expanding max_width = 420 raw_text = "#low Demand per pop represents the purchasing power of every 1,000 people. Wages are drawn from a shared pool distributed by political power. A fraction of income is saved as #bold Enrichment#! — wealth flowing to estate treasuries.#!" }
				}
			}
		}

		TooltipListRowContent = {
			TooltipManualTableField = {
				blockoverride "field_content" {
					text_single = { layoutpolicy_horizontal = expanding margin_left = 5 raw_text = "#T Pop Type#!" }
					text_single = { min_width = 70 max_width = 70 align = right raw_text = "#T Wages#!" }
					text_single = { min_width = 70 max_width = 70 align = right raw_text = "#T Returns#!" }
					text_single = { min_width = 70 max_width = 70 align = right raw_text = "#T Savings#!" }
					text_single = { min_width = 70 max_width = 70 align = right raw_text = "#T WPP#!" }
				}
			}

			# Nobles
			TooltipManualTableField = {
				visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sul_noble_demand_per_pop'), '(CFixedPoint)0.0001')]"
				blockoverride "field_content" {
					icon = { size = { 20 20 } texture = "[GetGraphicalCultureTextureForPopType(GetPopTypeByName('nobles'))]" }
					text_single = { layoutpolicy_horizontal = expanding margin_left = 5 raw_text = "Nobles" }
					text_single = {
						min_width = 70 max_width = 70 align = right
						raw_text = "[Location.MakeScope.ScriptValue('sul_noble_wage_rate')|2]@gold!"
						tooltipwidget = {
							ContextualTooltipType = {
								blockoverride "tooltip_title" { ContextualTooltipHeader = { blockoverride "title_text" { raw_text = "Nobles Wages" } } }
								blockoverride "tooltip_content" {
									TooltipListBase = {
										TooltipManualTableField = { blockoverride "field_content" { text_single = { layoutpolicy_horizontal = expanding raw_text = "Location Wage Pool" } text_single = { align = right min_width = 100 raw_text = "[Location.MakeScope.ScriptValue('sul_wage_pool_total')|2]@gold!" } } }
										TooltipManualTableField = { blockoverride "field_content" { text_single = { layoutpolicy_horizontal = expanding raw_text = "Estate Power" } text_single = { align = right min_width = 100 raw_text = "[Multiply_CFixedPoint(Location.MakeScope.ScriptValue('sul_noble_power_share'), '(CFixedPoint)100')|0]%" } } }
									}
								}
							}
						}
					}
					text_single = {
						min_width = 70 max_width = 70 align = right
						raw_text = "[Location.MakeScope.ScriptValue('sul_noble_capital_return')|2]@gold!"
						tooltipwidget = {
							ContextualTooltipType = {
								blockoverride "tooltip_title" { ContextualTooltipHeader = { blockoverride "title_text" { raw_text = "Nobles Capital Returns" } } }
								blockoverride "tooltip_content" {
									TooltipListBase = {
										TooltipManualTableField = { blockoverride "field_content" { text_single = { layoutpolicy_horizontal = expanding raw_text = "Estate Return Rate" } text_single = { align = right min_width = 100 raw_text = "[Location.MakeScope.ScriptValue('sul_noble_capital_return')|2]@gold!" } } }
										TooltipManualTableField = { blockoverride "field_content" { text_single = { layoutpolicy_horizontal = expanding raw_text = "Asset Share" } text_single = { align = right min_width = 100 raw_text = "[Location.MakeScope.ScriptValue('sul_asset_share_pct')|0]%" } } }
										TooltipManualTableField = { blockoverride "field_content" { text_single = { layoutpolicy_horizontal = expanding raw_text = "Political Power" } text_single = { align = right min_width = 100 raw_text = "[Multiply_CFixedPoint(Location.MakeScope.ScriptValue('sul_noble_power_share'), '(CFixedPoint)100')|0]%" } } }
									}
								}
							}
						}
					}
					text_single = {
						min_width = 70 max_width = 70 align = right
						raw_text = "[Location.MakeScope.ScriptValue('sul_noble_enrichment_per_pop')|2]@gold!"
						tooltipwidget = {
							ContextualTooltipType = {
								blockoverride "tooltip_title" { ContextualTooltipHeader = { blockoverride "title_text" { raw_text = "Nobles Enrichment" } } }
								blockoverride "tooltip_content" {
									TooltipListBase = {
										TooltipManualTableField = { blockoverride "field_content" { text_single = { layoutpolicy_horizontal = expanding raw_text = "Enrichment Rate" } text_single = { align = right min_width = 100 raw_text = "[Multiply_CFixedPoint(Location.MakeScope.ScriptValue('sul_noble_enrichment_rate_display'), '(CFixedPoint)100')|0]%" } } }
									}
								}
							}
						}
					}
					text_single = {
						min_width = 70 max_width = 70 align = right
						raw_text = "[Location.MakeScope.ScriptValue('sul_noble_demand_per_pop')|2]@gold!"

						tooltipwidget = {
							ContextualTooltipType = {
								blockoverride "tooltip_title" {  }
								blockoverride "tooltip_content" {
									TooltipListBase = {
										max_update_rate = 30
										TooltipTableHeader = { blockoverride "tableheader_text" { raw_text = "#T Nobles — Demand Breakdown#!" } }
										TooltipListScrollArea = {
											blockoverride "block_scrollarea" { maximumsize = { -1 600 } minimumsize = { -1 30 } }
											blockoverride "scrollarea_content" {
												TooltipListRowContent = {

												TooltipManualTableField = {
													visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sul_nobles_necessity'), '(CFixedPoint)0')]"
													blockoverride "field_content" {
														text_single = { layoutpolicy_horizontal = expanding raw_text = "#T Necessity#!" }
													}
												}
												TooltipListRowContent = {
													visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sul_nobles_necessity'), '(CFixedPoint)0')]"
													max_update_rate = 30
													datamodel = "[GetGlobalMapKeys('sul_da_necessity')]"
													item = {
														TooltipManualTableField = {
															blockoverride "field_content" {
																datacontext = "[Scope.GetGoods]"
																icon = { size = { 20 20 } texture = "[GetGoodsIcon(Goods.Self)]" }
																text_single = { layoutpolicy_horizontal = expanding margin_left = 3 text = "[Goods.GetName]" }
																text_single = { min_width = 60 align = right raw_text = "[Multiply_CFixedPoint(GetVariableFromGlobalVariableMap('sul_da_necessity', Goods.MakeScope).GetValue, Location.MakeScope.ScriptValue('sul_nobles_necessity'))|2]" }
															}
														}
													}
												}
												TooltipManualTableField = {
													visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sul_nobles_basic'), '(CFixedPoint)0')]"
													blockoverride "field_content" {
														text_single = { layoutpolicy_horizontal = expanding raw_text = "#T Basic#!" }
													}
												}
												TooltipListRowContent = {
													visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sul_nobles_basic'), '(CFixedPoint)0')]"
													max_update_rate = 30
													datamodel = "[GetGlobalMapKeys('sul_da_basic')]"
													item = {
														TooltipManualTableField = {
															blockoverride "field_content" {
																datacontext = "[Scope.GetGoods]"
																icon = { size = { 20 20 } texture = "[GetGoodsIcon(Goods.Self)]" }
																text_single = { layoutpolicy_horizontal = expanding margin_left = 3 text = "[Goods.GetName]" }
																text_single = { min_width = 60 align = right raw_text = "[Multiply_CFixedPoint(GetVariableFromGlobalVariableMap('sul_da_basic', Goods.MakeScope).GetValue, Location.MakeScope.ScriptValue('sul_nobles_basic'))|2]" }
															}
														}
													}
												}
												TooltipManualTableField = {
													visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sul_nobles_common'), '(CFixedPoint)0')]"
													blockoverride "field_content" {
														text_single = { layoutpolicy_horizontal = expanding raw_text = "#T Common#!" }
													}
												}
												TooltipListRowContent = {
													visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sul_nobles_common'), '(CFixedPoint)0')]"
													max_update_rate = 30
													datamodel = "[GetGlobalMapKeys('sul_da_common')]"
													item = {
														TooltipManualTableField = {
															blockoverride "field_content" {
																datacontext = "[Scope.GetGoods]"
																icon = { size = { 20 20 } texture = "[GetGoodsIcon(Goods.Self)]" }
																text_single = { layoutpolicy_horizontal = expanding margin_left = 3 text = "[Goods.GetName]" }
																text_single = { min_width = 60 align = right raw_text = "[Multiply_CFixedPoint(GetVariableFromGlobalVariableMap('sul_da_common', Goods.MakeScope).GetValue, Location.MakeScope.ScriptValue('sul_nobles_common'))|2]" }
															}
														}
													}
												}
												TooltipManualTableField = {
													visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sul_nobles_upper'), '(CFixedPoint)0')]"
													blockoverride "field_content" {
														text_single = { layoutpolicy_horizontal = expanding raw_text = "#T Upper#!" }
													}
												}
												TooltipListRowContent = {
													visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sul_nobles_upper'), '(CFixedPoint)0')]"
													max_update_rate = 30
													datamodel = "[GetGlobalMapKeys('sul_da_upper')]"
													item = {
														TooltipManualTableField = {
															blockoverride "field_content" {
																datacontext = "[Scope.GetGoods]"
																icon = { size = { 20 20 } texture = "[GetGoodsIcon(Goods.Self)]" }
																text_single = { layoutpolicy_horizontal = expanding margin_left = 3 text = "[Goods.GetName]" }
																text_single = { min_width = 60 align = right raw_text = "[Multiply_CFixedPoint(GetVariableFromGlobalVariableMap('sul_da_upper', Goods.MakeScope).GetValue, Location.MakeScope.ScriptValue('sul_nobles_upper'))|2]" }
															}
														}
													}
												}
												TooltipManualTableField = {
													visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sul_nobles_luxury'), '(CFixedPoint)0')]"
													blockoverride "field_content" {
														text_single = { layoutpolicy_horizontal = expanding raw_text = "#T Luxury#!" }
													}
												}
												TooltipListRowContent = {
													visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sul_nobles_luxury'), '(CFixedPoint)0')]"
													max_update_rate = 30
													datamodel = "[GetGlobalMapKeys('sul_da_luxury')]"
													item = {
														TooltipManualTableField = {
															blockoverride "field_content" {
																datacontext = "[Scope.GetGoods]"
																icon = { size = { 20 20 } texture = "[GetGoodsIcon(Goods.Self)]" }
																text_single = { layoutpolicy_horizontal = expanding margin_left = 3 text = "[Goods.GetName]" }
																text_single = { min_width = 60 align = right raw_text = "[Multiply_CFixedPoint(GetVariableFromGlobalVariableMap('sul_da_luxury', Goods.MakeScope).GetValue, Location.MakeScope.ScriptValue('sul_nobles_luxury'))|2]" }
															}
														}
													}
												}
												TooltipManualTableField = {
													visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sul_nobles_exotic'), '(CFixedPoint)0')]"
													blockoverride "field_content" {
														text_single = { layoutpolicy_horizontal = expanding raw_text = "#T Exotic#!" }
													}
												}
												TooltipListRowContent = {
													visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sul_nobles_exotic'), '(CFixedPoint)0')]"
													max_update_rate = 30
													datamodel = "[GetGlobalMapKeys('sul_da_exotic')]"
													item = {
														TooltipManualTableField = {
															blockoverride "field_content" {
																datacontext = "[Scope.GetGoods]"
																icon = { size = { 20 20 } texture = "[GetGoodsIcon(Goods.Self)]" }
																text_single = { layoutpolicy_horizontal = expanding margin_left = 3 text = "[Goods.GetName]" }
																text_single = { min_width = 60 align = right raw_text = "[Multiply_CFixedPoint(GetVariableFromGlobalVariableMap('sul_da_exotic', Goods.MakeScope).GetValue, Location.MakeScope.ScriptValue('sul_nobles_exotic'))|2]" }
															}
														}
													}
												}
												}
											}
										}
									}
								}
							}
						}
					}
				}
			}

			# Clergy
			TooltipManualTableField = {
				visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sul_clergy_demand_per_pop'), '(CFixedPoint)0.0001')]"
				blockoverride "field_content" {
					icon = { size = { 20 20 } texture = "[GetGraphicalCultureTextureForPopType(GetPopTypeByName('clergy'))]" }
					text_single = { layoutpolicy_horizontal = expanding margin_left = 5 raw_text = "Clergy" }
					text_single = {
						min_width = 70 max_width = 70 align = right
						raw_text = "[Location.MakeScope.ScriptValue('sul_clergy_wage_rate')|2]@gold!"
						tooltipwidget = {
							ContextualTooltipType = {
								blockoverride "tooltip_title" { ContextualTooltipHeader = { blockoverride "title_text" { raw_text = "Clergy Wages" } } }
								blockoverride "tooltip_content" {
									TooltipListBase = {
										TooltipManualTableField = { blockoverride "field_content" { text_single = { layoutpolicy_horizontal = expanding raw_text = "Location Wage Pool" } text_single = { align = right min_width = 100 raw_text = "[Location.MakeScope.ScriptValue('sul_wage_pool_total')|2]@gold!" } } }
										TooltipManualTableField = { blockoverride "field_content" { text_single = { layoutpolicy_horizontal = expanding raw_text = "Estate Power" } text_single = { align = right min_width = 100 raw_text = "[Multiply_CFixedPoint(Location.MakeScope.ScriptValue('sul_clergy_power_share'), '(CFixedPoint)100')|0]%" } } }
									}
								}
							}
						}
					}
					text_single = {
						min_width = 70 max_width = 70 align = right
						raw_text = "[Location.MakeScope.ScriptValue('sul_clergy_capital_return')|2]@gold!"
						tooltipwidget = {
							ContextualTooltipType = {
								blockoverride "tooltip_title" { ContextualTooltipHeader = { blockoverride "title_text" { raw_text = "Clergy Capital Returns" } } }
								blockoverride "tooltip_content" {
