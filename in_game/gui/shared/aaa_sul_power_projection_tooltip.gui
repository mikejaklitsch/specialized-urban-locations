# Power Projection — override of vanilla power_projection_tooltip.
# Scrollable PP source breakdown, subject burden summary with sub-tooltip,
# and current PP effects at the bottom.
# File prefixed aaa_ so it loads before vanilla.

template power_projection_tooltip {
	ContextualTooltipType = {
		blockoverride "title_text" {
			text = "POWER_PROJECTION_HEADER"
		}
		blockoverride "title_icon" {
			icon = {
				using = tooltip_title_icon_size
				texture = "gfx/interface/icons/flat_icons/power_projection.dds"
				glow = {
					name = "drop_shadow"
					glow_radius = 3
					color = {0.0 0.0 0.0 1.0}
					alpha = 0.3
				}
			}
		}
		blockoverride "concept_link" {
			text = [power_projection|e]
		}
		blockoverride "tooltip_content" {
			# PP sources — scrollable engine breakdown.
			TooltipListBase = {
				blockoverride "block_title" {
					datacontext = "[Country]"
					text = "POWER_PROJECTION_TT_TEXT"
				}

				TooltipListScrollArea = {
					blockoverride "block_scrollarea" {
						maximumsize = { -1 250 }
						minimumsize = { -1 30 }
					}

					blockoverride "scrollarea_content" {
						TooltipStringPairList = {
							blockoverride "block_title" { visible = no }
							textcontext = "[Country.GetDescriptionFor('power_projection')]"
						}
					}
				}
			}

			# Debug: diplo capacity raw values.
			text_single = {
				raw_text = "SUL_PROJECTION_DEBUG_DIPLO"
				maximumsize = { 500 -1 }
				multiline = yes
				autoresize = yes
				fontsize = 12
			}

			# Current PP effects.
			TooltipListBase = {
				blockoverride "block_title" {
					datacontext = "[Country]"
					text = "SUL_PROJECTION_EFFECTS_HEADER"
				}

				TooltipListScrollArea = {
					blockoverride "block_scrollarea" {
						maximumsize = { -1 250 }
						minimumsize = { -1 30 }
					}

					blockoverride "scrollarea_content" {
						TooltipStringPairList = {
							blockoverride "block_title" { visible = no }
							textcontext = "SUL_PROJECTION_CURRENT_EFFECTS"
						}
					}
				}
			}
		}
	}
}
