# PROVISIONS: Custom RGO building tooltip template.
# Uses script values and BuildingType from global sul_rgo_map.

template sul_rgo_button_tooltip {
	ContextualTooltipType = {
		datacontext = "[Location]"
		datacontext = "[Location.GetRawMaterial]"
		datacontext = "[Location.GetMarket]"
		datacontext = "[GetVariableFromGlobalVariableMap('sul_rgo_map', Location.GetRawMaterial.MakeScope).GetBuildingType]"
		datacontext = "[BuildingType.GetPopType]"

		blockoverride "title_text" { text = "RAW_MATERIAL_LOCATION_TOOLTIP_T" }

		blockoverride "title_icon" {
			button = {
				using = tooltip_title_icon_size
				texture = "[GetGoodsIcon(Location.GetRawMaterial)]"
				tooltipwidget = { using = SpecificGoodsMarket_tooltip }

				action_tooltip = {
					click_type = left
					click_mode = single
					title = "OPEN_GOOD_PANEL"
					on_action = "[ShowGoods(Location.GetRawMaterial)]"
				}
			}
		}

		blockoverride "concept_link" { text = [resource_gathering_operations|e] }

		blockoverride "title_button" { mapmode_tooltip_button = { datacontext = "[GetMapMode('raw_material')]" } }

		blockoverride "tooltip_content" {
			# --- Pie chart + info table ---
			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 10

				# Pie chart: level / max
				widget = {
					visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sul_location_max_rgo_building_level_rounded'), '(CFixedPoint)0')]"
					size = { 100 100 }
					using = marker_bg_circle

					piechart = {
						parentanchor = center
						size = { 90% 90% }
						using = piechart_angles

						icon = {
							size = { 55% 55% }
							parentanchor = vcenter|hcenter
							texture = "[GetGoodsIcon(Location.GetRawMaterial)]"
						}

						pieslice_no_highlight = {
							filter_mouse = none
							alwaystransparent = yes
							texture = "gfx/interface/pie_charts/pie_chart_alpha_80_green.dds"
							value = "[Divide_CFixedPoint(Location.MakeScope.ScriptValue('sul_location_rgo_building_level'), Location.MakeScope.ScriptValue('sul_location_max_rgo_building_level_rounded'))]"

							color = {
								1
								1
								1
								1
							}
						}

						pieslice_no_highlight = {
							filter_mouse = none
							alwaystransparent = yes
							texture = "gfx/interface/pie_charts/pie_chart_alpha_80_red.dds"
							value = "[Subtract_float('(float)1.0', FixedPointToFloatPercentageCapped(Divide_CFixedPoint(Location.MakeScope.ScriptValue('sul_location_rgo_building_level'), Location.MakeScope.ScriptValue('sul_location_max_rgo_building_level_rounded')), '(bool)yes'))]"

							color = {
								1
								1
								1
								1
							}
						}
					}
				}

				# Info table
				TooltipListBase = {
					TooltipListRowContent = {
						# Building level
						TooltipManualTableField = {
							blockoverride "field_content" {
								text_single = { raw_text = "WPDO_RGO_TT_LEVEL" }
								expand = {  }

								text_single = {
									visible = "[Not(GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sul_rgo_levels_under_construction'), '(CFixedPoint)0'))]"
									raw_text = "[Location.MakeScope.ScriptValue('sul_location_rgo_building_level')|0]/[Location.MakeScope.ScriptValue('sul_location_max_rgo_building_level_rounded')|0L]"

									tooltipwidget = {
										SimpleContextualStringPairTooltipType = {
											blockoverride "title_icon" {
												icon = { using = tooltip_title_icon_size texture = "gfx/interface/icons/outliner/categories/buildings.dds" }
											}
											blockoverride "tooltip_title" { ContextualTooltipHeader = {  } blockoverride "title_text" { text = "WPDO_RGO_TT_MAX_LEVEL_TITLE" } }
											blockoverride "concept_link" { text = "[building|e]" }
											lowpriotextcontext = "[BuildingType.GetMaxLevelInformation(Location.Self)]"
										}
									}
								}
								text_single = {
									visible = "[GreaterThan_CFixedPoint(Location.MakeScope.ScriptValue('sul_rgo_levels_under_construction'), '(CFixedPoint)0')]"
									raw_text = "[Location.MakeScope.ScriptValue('sul_location_rgo_building_level')|0][Location.MakeScope.ScriptValue('sul_rgo_levels_under_construction')|0+=]/[Location.MakeScope.ScriptValue('sul_location_max_rgo_building_level_rounded')|0L]"

									tooltipwidget = {
										SimpleContextualStringPairTooltipType = {
											blockoverride "title_icon" {
												icon = { using = tooltip_title_icon_size texture = "gfx/interface/icons/outliner/categories/buildings.dds" }
											}
											blockoverride "tooltip_title" { ContextualTooltipHeader = {  } blockoverride "title_text" { text = "WPDO_RGO_TT_MAX_LEVEL_TITLE" } }
											blockoverride "concept_link" { text = "[building|e]" }
											lowpriotextcontext = "[BuildingType.GetMaxLevelInformation(Location.Self)]"
										}
									}
								}
							}
						}

						# Cost
						TooltipManualTableField = {
							blockoverride "field_content" {
								text_single = { raw_text = "WPDO_RGO_TT_COST" }
								expand = {  }

								text_single = { raw_text = "[GetBuildOrExpandBuildingCost(BuildingType.Self, Location.Self)|2]@gold!" }
							}
						}

						# Build time
						TooltipManualTableField = {
							blockoverride "field_content" {
								text_single = { raw_text = "WPDO_RGO_TT_BUILD_TIME" }
								expand = {  }
								text_single = { raw_text = "[BuildingType.GetBuildTime]" }
							}
						}

						# Employment per level
						TooltipManualTableField = {
							blockoverride "field_content" {
								text_single = { raw_text = "WPDO_RGO_TT_EMPLOYMENT" }
								expand = {  }

								text_single = { raw_text = "[BuildingType.GetEmploymentSize] [PopType.GetName]" }
							}
						}

						# Market price
						TooltipManualTableField = {
							blockoverride "field_content" {
								text_single = { raw_text = "WPDO_RGO_TT_PRICE" }
								expand = {  }

								text_single = {
									raw_text = "[Location.GetMarket.GetPrice(Location.GetRawMaterial)|2]@gold!"
									datacontext = "[Location.GetMarket.GetMarketEntry(Location.GetRawMaterial)]"
									tooltipwidget = { using = goods_market_price_tooltip }
								}
							}
						}

						# Production method
						TooltipManualTableField = {
							blockoverride "field_content" { text_single = { raw_text = "[BuildingType.GetProductionMethodsLabel]" } }
						}

						# Goods per level
						TooltipManualTableField = {
							blockoverride "field_content" {
								text_single = { raw_text = "WPDO_RGO_TT_OUTPUT" }
								expand = {  }

								text_single = { raw_text = "[Location.MakeScope.ScriptValue('sul_rgo_output_per_level')|2] [Goods.GetName]" }
							}
						}

						# Profit — disabled: GetBuildingTypePotentialProfitInLocation requires
						# player build context that standalone tooltips don't have
					}
				}
			}

			# --- Available employment ---
			TooltipContentSection = { using = construct_building_in_location_employment_info }

			# --- Construction demand (goods required to build) ---
			TooltipContentSection = {
				visible = "[BuildingType.HasConstructionGoodsDemand]"
				datacontext = "[BuildingType.GetConstructionDemand]"
				using = demands_details
			}
		}
	}
}
