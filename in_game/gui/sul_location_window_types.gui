	}

	type sul_wealth_bar = widget {
		parentanchor = right|vcenter
		position = { -48 0 }
		size = { 22 202 }
		visible = "[LocationView.GetLocation.HasOwner]"

		tooltipwidget = { using = sul_wealth_bar_tooltip }

		using = bg_paper_card
		using = bg_cabinet_card_frame

		progressbar = {
			parentanchor = center
			size = { 12 192 }
			using = progress_bar_goldish
			value = "[LocationView.GetLocation.MakeScope.ScriptValue('sul_wealth_fill_ratio')]"
			direction = vertical
		}
	}

	type sul_specialization_buttons = widget {
		parentanchor = right|vcenter
		position = { -5 0 }
		size = { 46 202 }
		visible = "[LocationView.GetLocation.HasOwner]"

		vbox = {
			spacing = 3
			margin = { 5 5 }
			using = bg_paper_card
			using = bg_cabinet_card_frame

			# Mining button
			widget = {
				size = { 36 36 }
				header_action_button_left = {
					size = { 36 36 }
					blockoverride "button_icon_stretch_sprite" {  }
					blockoverride "header_button_frame_inner" { visible = no }
					blockoverride "header_button_icon_size" { size = { 32 32 } }
					blockoverride "header_button_text_layout" {  }
					blockoverride "icon_texture" { visible = no }
					title = "sul_designate_mining_specialization"
					actor = "[GetPlayer]"

					tooltipwidget = {
						using = action_tooltip_pop_out
						blockoverride "title_icon" { icon = { using = tooltip_title_icon_size using = sul_concept_texture_mining_button } }
					}

					parameter = { parameter_name = "target" parameter_value = "[LocationView.GetLocation]" }

					left_click_and_hold_action = { action_name = "sul_designate_mining_specialization" }

					icon = {
						parentanchor = center
